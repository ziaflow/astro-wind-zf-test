# Email Configuration
# All website lead forms now use /api/contact and require Supabase persistence.
# SMTP notifications below are optional; Web3Forms variables are retained only for legacy tooling.
EMAIL_BACKEND=nodemailer

# Web3Forms Configuration (if using EMAIL_BACKEND=web3forms)
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here

# Nodemailer SMTP Configuration (if using EMAIL_BACKEND=nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@ziaflow.com
SMTP_TO=info@ziaflow.com

# Lead intake (server-only; never prefix with PUBLIC_). Required for /api/contact to save leads.
# Forms always post to /api/contact regardless of EMAIL_BACKEND.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: requests sending this value in an x-test-token header are marked is_test=true on the server.
TEST_SUBMISSION_TOKEN=

# Customer.io Intake Webhook Trigger URL (Stage 2)
# Generates automated confirmation email to lead and team alert upon verified persistence
CUSTOMER_IO_WEBHOOK_URL=https://track.customer.io/events/webhook/...

# Existing Customer.io HTTP source: ZiaFlow website server intake (source 183140).
# Server-only source write key; required for profile identify + canonical form_submit event.
CIO_CDP_WRITE_KEY=
CUSTOMER_IO_CDP_REGION=us

# Customer.io Reporting Webhook Signing Key (for verifying HMAC-SHA256 signatures on /api/webhooks/customerio)
CIO_WEBHOOK_SIGNING_KEY=your-reporting-webhook-signing-key

# Form Configuration
CONTACT_FORM_SUBJECT=New Contact Request from ZiaFlow Website
CONTACT_FORM_FROM_NAME=ZiaFlow Contact Form

# Chatbot Configuration
PUBLIC_BOT_SECRET=

# IndexNow API Key for SEO
INDEXNOW_KEY=23ae16e3343c4a4fae1d800cbc6d31f6

# Analytics IDs (set these for Astro Analytics integration)
PUBLIC_CLARITY_PROJECT_ID=your-clarity-project-id-here
PUBLIC_GA_MEASUREMENT_ID=your-ga4-measurement-id-here

# Event logging endpoint (for Supabase Edge Function or API)
PUBLIC_EVENT_LOG_ENDPOINT=https://your-supabase-project.supabase.co/functions/v1/log-event

