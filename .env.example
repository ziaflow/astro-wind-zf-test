# Email Configuration
# Choose email backend: 'web3forms' or 'nodemailer'
EMAIL_BACKEND=web3forms

# Web3Forms Configuration (if using EMAIL_BACKEND=web3forms)
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here

# Nodemailer SMTP Configuration (if using EMAIL_BACKEND=nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@ziaflow.com
SMTP_TO=info@ziaflow.com

# Form Configuration
CONTACT_FORM_SUBJECT=New Contact Request from ZiaFlow Website
CONTACT_FORM_FROM_NAME=ZiaFlow Contact Form

# Intake form pipeline (ContactIntakeForm → Astro Action → Google Apps Script).
# SERVER-ONLY: never rename these with a PUBLIC_ prefix. Set in Vercel for Production AND Preview.
# Submissions return 500 until both are set. See docs/forms-pipeline.md.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_SCRIPT_SECRET=generate-a-long-random-string-at-least-32-chars

# Supabase (server-only) — durable copy of every submission in `contact_submissions`.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Chatbot Configuration
# WARNING: PUBLIC_* values are bundled into client JavaScript and are visible to anyone.
# Do not store real secrets here.
PUBLIC_BOT_SECRET=

# IndexNow API Key for SEO (8-128 chars: a-z, A-Z, 0-9, "-").
# public/<key>.txt must exist and contain exactly this key. Also set it as a GitHub Actions secret.
INDEXNOW_KEY=your-indexnow-api-key-here

# Analytics IDs (set these for Astro Analytics integration)
PUBLIC_CLARITY_PROJECT_ID=your-clarity-project-id-here
PUBLIC_GA_MEASUREMENT_ID=your-ga4-measurement-id-here

# Event logging endpoint (for Supabase Edge Function or API)
PUBLIC_EVENT_LOG_ENDPOINT=https://your-supabase-project.supabase.co/functions/v1/log-event

