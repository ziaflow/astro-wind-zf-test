{
  "css.customData": ["./vscode.tailwind.json"],
  "eslint.validate": ["javascript", "javascriptreact", "astro", "typescript", "typescriptreact"],
  "files.associations": {
    "*.mdx": "markdown"
  },
  "prettier.documentSelectors": ["**/*.astro"],
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "yaml.schemas": {
    "./.vscode/astrowind/config-schema.json": "/src/config.yaml"
  },
  "eslint.useFlatConfig": true,
  "chatgpt.openOnStartup": true,
  "chatgpt.runCodexInWindowsSubsystemForLinux": false,
  "geminicodeassist.project": "astrowebsite-a9a91",
  "antigravity.autoOpenFiles": true,
  "containers.contexts.showInStatusBar": true,
  "scm.alwaysShowRepositories": true
}
