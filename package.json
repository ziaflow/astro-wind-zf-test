{
  "name": "ziaflow-web",
  "version": "1.0.0",
  "description": "ZiaFlow: Official website, lead automation, and digital intelligence platform for Arizona businesses.",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^18.17.1 || ^20.3.0 || >= 21.0.0"
  },
  "scripts": {
    "delivery:check": "node tools/operations/delivery.mjs",
    "test:workflows": "node --test tests/operations.test.mjs tests/contact-endpoint.test.mjs tests/audit-endpoint.test.mjs tests/delivery.test.mjs",
    "ops": "node tools/operations/cli.mjs",
    "ops:prepare": "node tools/operations/prepare-roadmap.mjs",
    "test:ops": "node --test tests/operations.test.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "sanity": "cd studio-gemini-blog && npm run dev",
    "sanity:sync": "node tools/agents/sanity-content-agent.mjs --sync",
    "sanity:review": "node tools/agents/sanity-content-agent.mjs --review",
    "sanity:draft": "node tools/agents/sanity-content-agent.mjs --draft-next",
    "sanity:draft-all": "node tools/agents/sanity-content-agent.mjs --draft-all",
    "sanity:publish-safe": "node tools/agents/sanity-content-agent.mjs --publish-safe",
    "sanity:list": "node tools/agents/sanity-content-agent.mjs --list",
    "sanity:typegen": "cd studio-gemini-blog && npm run typegen",
    "supabase:sync-seo": "node tools/agents/sync-seo-to-supabase.mjs",
    "supabase:sync-clarity": "node tools/agents/sync-clarity-to-supabase.mjs",
    "supabase:sync-google": "node tools/agents/sync-google-analytics-to-supabase.mjs",
    "build": "astro build",
    "postbuild": "npm run indexnow",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run check:astro && npm run check:eslint && npm run check:prettier",
    "check:astro": "astro check",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "indexnow": "node tools/agents/submit-indexnow.mjs",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w ."
  },
  "dependencies": {
    "@astrojs/prefetch": "^0.4.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^8.2.11",
    "@astrolib/analytics": "^0.6.1",
    "@astrolib/seo": "^1.0.0-beta.8",
    "@customerio/cdp-analytics-browser": "^0.6.0",
    "@fontsource-variable/inter": "^5.2.6",
    "@microsoft/clarity": "^1.0.2",
    "@sanity/astro": "^3.2.11",
    "@sanity/client": "^7.13.2",
    "@sanity/image-url": "^2.0.2",
    "@supabase/supabase-js": "^2.87.3",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "astro": "^5.18.2",
    "astro-embed": "^0.9.0",
    "astro-icon": "^1.1.5",
    "astro-portabletext": "^0.12.0",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^0.8.4",
    "dotenv": "^17.2.3",
    "limax": "4.1.0",
    "linkinator": "^7.5.1",
    "lodash.merge": "^4.6.2",
    "nodemailer": "^7.0.10",
    "openai": "^6.9.0",
    "resend": "^6.32.1",
    "slugify": "^1.6.6",
    "unpic": "^4.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.2",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/partytown": "^2.1.4",
    "@eslint/js": "^9.33.0",
    "@iconify-json/flat-color-icons": "^1.2.1",
    "@iconify-json/tabler": "^1.2.20",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "astro-compress": "^2.4.0",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.33.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^16.3.0",
    "js-yaml": "^4.1.0",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "reading-time": "^1.5.0",
    "sharp": "0.34.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0",
    "unist-util-visit": "^5.0.0"
  }
}
