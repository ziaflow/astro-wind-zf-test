{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AstroWind Task Queue Schema",
  "type": "object",
  "required": ["version", "tasks"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "properties": {
        "default_model_rotation": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cooldown_seconds_between_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "max_retries_per_task": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "prompt", "created_at"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed", "failed"]
          },
          "priority": {
            "type": "string",
            "enum": ["low", "normal", "high", "critical"]
          },
          "model_tier": {
            "type": "string",
            "enum": ["flash", "flash_lite", "pro", "auto"]
          },
          "prompt": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "completed_at": {
            "type": ["string", "null"]
          },
          "started_at": {
            "type": ["string", "null"]
          },
          "retry_count": {
            "type": "integer",
            "minimum": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
