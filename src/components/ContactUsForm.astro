---
// src/components/ContactUsForm.astro
---

<form id="contact-us-form" class="space-y-6">
  <input type="hidden" name="form_type" value="contact_us" />
  <input type="hidden" name="page_submitted_from" value={Astro.url.pathname} />

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Your Name *</label>
      <input
        type="text"
        name="name"
        required
        placeholder="First and last name"
        class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
      />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Email Address *</label>
      <input
        type="email"
        name="email"
        required
        placeholder="you@company.com"
        class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Phone Number</label>
      <input
        type="tel"
        name="phone"
        placeholder="(555) 000-0000"
        class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
      />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Company Name</label>
      <input
        type="text"
        name="company_name"
        placeholder="Your company / organization"
        class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
      />
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Service Needed *</label>
    <select
      name="service_needed"
      required
      class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white"
    >
      <option value="" disabled selected>Select a ZiaFlow service...</option>
      <option value="Custom Software Development">Custom Software Development</option>
      <option value="AI Voice & Workflow Automation">AI Voice & Workflow Automation</option>
      <option value="Cloud Infrastructure">Cloud Infrastructure</option>
      <option value="API Integration & Security">API Integration & Security</option>
      <option value="Technical SEO & Performance Marketing">Technical SEO & Performance Marketing</option>
    </select>
  </div>

  <div>
    <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Project Comments & Requirements</label>
    <textarea
      name="comments"
      rows="4"
      placeholder="Tell us about your infrastructure, development, or automation goals..."
      class="mt-1 block w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
    ></textarea>
  </div>

  <button
    type="submit"
    id="contact-submit-btn"
    class="w-full rounded-xl bg-[#3F9B93] py-3.5 px-4 font-bold text-black shadow-md transition hover:bg-[#4cd1c7] focus:outline-none focus:ring-2 focus:ring-[#3F9B93] disabled:cursor-wait disabled:opacity-70"
  >
    Submit Detailed Inquiry
  </button>
  <p id="contact-status" class="hidden rounded-xl border p-3 text-center text-sm font-medium"></p>
</form>

<script>
  const form = document.getElementById('contact-us-form') as HTMLFormElement;
  const statusEl = document.getElementById('contact-status') as HTMLElement;
  const btn = document.getElementById('contact-submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (btn.disabled) return;
    btn.disabled = true;
    const originalText = btn.textContent;
    btn.textContent = 'Submitting...';
    statusEl.classList.add('hidden');
    statusEl.className = 'hidden rounded-xl border p-3 text-center text-sm font-medium';

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await res.json();
      if (res.ok && result.ok) {
        // Fire GTM, GA4, and Customer.io Events
        import('~/utils/analytics').then(({ trackFormSubmission, trackEmailSent, identifyCustomerIo, trackCustomerIoEvent }) => {
          trackFormSubmission({
            form_id: 'contact-us-form',
            form_name: 'contact_us',
            service_needed: (data.service_needed as string) || 'Contact Us Form',
          });
          trackEmailSent({
            email_type: 'customer_receipt',
            status: 'sent',
            form_name: 'contact_us',
          });

          // Customer.io: 1. Identify person by email
          const rawName = ((data.name as string) || '').trim();
          const nameParts = rawName.split(/\s+/);
          const firstName = nameParts[0] || '';
          const lastName = nameParts.slice(1).join(' ') || '';
          const userEmail = ((data.email as string) || '').trim();

          identifyCustomerIo({
            email: userEmail,
            first_name: firstName,
            last_name: lastName,
            phone: (data.phone as string) || '',
            service_interest: (data.service_needed as string) || 'Full Contact Form',
            intake_source: 'contact_form',
          });

          // Customer.io: 2. Track contact_form_submitted event with message and page URL
          trackCustomerIoEvent('contact_form_submitted', {
            message: (data.message as string) || (data.comments as string) || '',
            service_interest: (data.service_needed as string) || '',
            form_id: 'contact-us-form',
            intake_source: 'contact_form',
          });
        });

        statusEl.textContent =
          'Thank you! Your project details have been logged and our team will be in touch shortly.';
        statusEl.className =
          'block rounded-xl border border-green-300 bg-green-50 p-3 text-center text-sm font-medium text-green-800 dark:border-green-800 dark:bg-green-950 dark:text-green-300';
        form.reset();
      } else {
        throw new Error(result.error || 'Server rejected submission');
      }
    } catch {
      statusEl.textContent = 'Something went wrong. Please email info@ziaflow.com directly.';
      statusEl.className =
        'block rounded-xl border border-red-300 bg-red-50 p-3 text-center text-sm font-medium text-red-800 dark:border-red-800 dark:bg-red-950 dark:text-red-300';
    } finally {
      btn.disabled = false;
      btn.textContent = originalText;
    }
  });
</script>
