---
// src/components/ContactUsForm.astro
---

<form data-lead-form action="/api/contact" method="POST" id="contact-us-form" class="space-y-6">
  <input type="hidden" name="page" value={Astro.url.pathname} />
  <input type="hidden" name="form_type" value="contact_us" />
  <input type="hidden" name="page_submitted_from" value={Astro.url.pathname} />

  {/* Anti-spam honeypot field: invisible to humans, traps automated spam bots */}
  <div
    class="opacity-0 absolute -z-10 select-none pointer-events-none"
    style="position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden;"
    aria-hidden="true"
    tabindex="-1"
  >
    <label for="contact_website_url">Leave this field blank</label>
    <input type="text" id="contact_website_url" name="website_url" value="" autocomplete="off" tabindex="-1" />
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Your Name *</label>
      <input
        type="text"
        name="name"
        required
        placeholder="First and last name"
        class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
      />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Email Address *</label>
      <input
        type="email"
        name="email"
        required
        placeholder="you@company.com"
        class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Phone Number</label>
      <input
        type="tel"
        name="phone"
        placeholder="(555) 000-0000"
        class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
      />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Company Name</label>
      <input
        type="text"
        name="company_name"
        placeholder="Your company / organization"
        class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
      />
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Service Needed *</label>
    <select
      name="service_needed"
      required
      class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white"
    >
      <option value="" disabled selected>Select a ZiaFlow service...</option>
      <option value="Custom Software Development">Custom Software Development</option>
      <option value="AI Voice & Workflow Automation">AI Voice & Workflow Automation</option>
      <option value="Cloud Infrastructure">Cloud Infrastructure</option>
      <option value="API Integration & Security">API Integration & Security</option>
      <option value="Technical SEO & Performance Marketing">Technical SEO & Performance Marketing</option>
    </select>
  </div>

  <div>
    <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Project Comments & Requirements</label>
    <textarea
      name="comments"
      rows="4"
      placeholder="Tell us about your infrastructure, development, or automation goals..."
      class="mt-1 block w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
    ></textarea>
  </div>

  <button
    type="submit"
    id="contact-submit-btn"
    class="w-full rounded-xl bg-[#3F9B93] py-3.5 px-4 font-bold text-black shadow-md transition hover:bg-[#4cd1c7] focus:outline-none focus:ring-2 focus:ring-[#3F9B93] disabled:cursor-wait disabled:opacity-70"
  >
    Submit Detailed Inquiry
  </button>
  <p
    data-form-status
    role="status"
    aria-live="polite"
    id="contact-status"
    class="hidden rounded-xl border p-3 text-center text-sm font-medium"
  >
  </p>
</form>

<script>
  import { bindLeadForms } from '~/utils/lead-form';
  bindLeadForms();
</script>
