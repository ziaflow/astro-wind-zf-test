---
// prettier-ignore
import { ANALYTICS } from 'astrowind:config';

// Analytics IDs sourced from Astro.env with fallback to config.yaml
const clarityId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID || ANALYTICS?.vendors?.clarity?.id;
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || ANALYTICS?.vendors?.googleAnalytics?.id;
const gtmId = import.meta.env.PUBLIC_GTM_ID || ANALYTICS?.vendors?.googleTagManager?.id;
---

<script is:inline define:vars={{ gaId }}>
  if (gaId) {
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      // eslint-disable-next-line prefer-rest-params
      window.dataLayer.push(arguments);
    }
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', gaId);
  }
</script>

<script is:inline>
  window.clarity = window.clarity || function(...args) { (window.clarity.q = window.clarity.q || []).push(args) };
</script>

<>
  {
    gtmId && (
      <>
        <script
          is:inline
          define:vars={{ gtmId }}
          set:html={`
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});const f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
      `}
        />
        <script is:inline define:vars={{ gaId }}>
          if (gaId) {
            const script = document.createElement('script');
            script.async = true;
            script.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
            document.head.appendChild(script);
          }
        </script>
      </>
    )
  }

  {
    clarityId && (
      <>
        <div id="clarity-setup" data-id={clarityId} class="hidden"></div>
        <script>
          import Clarity from '@microsoft/clarity';
          
          declare global {
            interface Window {
              clarity: (...args: unknown[]) => void;
            }
          }

          const element = document.getElementById('clarity-setup');
          if (element) {
            const id = element.dataset.id;
            if (id) {
              Clarity.init(id);

              // Tracking Scroll Depth
              let maxScroll = 0;
              window.addEventListener('scroll', () => {
                const scrollPercent = Math.round((window.scrollY + window.innerHeight) / document.documentElement.scrollHeight * 100);
                if (scrollPercent > maxScroll && scrollPercent % 25 === 0) {
                  maxScroll = scrollPercent;
                  if (window.clarity) {
                    window.clarity("set", "scroll_depth", maxScroll.toString());
                    if (maxScroll >= 75) window.clarity("upgrade", "high scroll depth");
                  }
                }
              }, { passive: true });

              // Track Dead Clicks (Simplified)
              document.addEventListener('click', (e) => {
                const target = e.target as HTMLElement;
                if (!target.closest('a') && !target.closest('button') && !target.closest('input')) {
                  // If it looks like it might be interactive (has title or specific classes) but isn't
                  if (target.innerText?.length < 50 && (target.classList.contains('icon') || target.title)) {
                     if (window.clarity) window.clarity("event", "potential_dead_click");
                  }
                }
              }, { passive: true });
            }
          }
        </script>
      </>
    )
  }

  <!-- Customer.io Web Analytics (CDP Snippet) -->
  <script is:inline>
    /* Vendor bootstrap is kept verbatim; its queue uses var and arguments. */
    /* eslint-disable no-var, prefer-rest-params, @typescript-eslint/no-unused-expressions */
    !function(){var i="cioanalytics", analytics=(window[i]=window[i]||[]);if(!analytics.initialize)if(analytics.invoked)window.console&&console.error&&console.error("Snippet included twice.");else{analytics.invoked=!0;analytics.methods=["trackSubmit","trackClick","trackLink","trackForm","pageview","identify","reset","group","track","ready","alias","debug","page","once","off","on","addSourceMiddleware","addIntegrationMiddleware","setAnonymousId","addDestinationMiddleware"];analytics.factory=function(e){return function(){var t=Array.prototype.slice.call(arguments);t.unshift(e);analytics.push(t);return analytics}};for(var e=0;e<analytics.methods.length;e++){var key=analytics.methods[e];analytics[key]=analytics.factory(key)}analytics.load=function(key,e){var t=document.createElement("script");t.type="text/javascript";t.async=!0;t.setAttribute('data-global-customerio-analytics-key', i);t.src="https://cdp.customer.io/v1/analytics-js/snippet/" + key + "/analytics.min.js";var n=document.getElementsByTagName("script")[0];n.parentNode.insertBefore(t,n);analytics._writeKey=key;analytics._loadOptions=e};analytics.SNIPPET_VERSION="4.15.3";
      analytics.load("8a4aa793f9846f20ff1e");
      analytics.page();
    }}();
  </script>
</>
