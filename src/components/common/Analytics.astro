---
import { ANALYTICS } from '~/config/site';

// prettier-ignore
// Analytics IDs are sourced from env or astrowind config
const clarityId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID || ANALYTICS?.vendors?.clarity?.id;
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || ANALYTICS?.vendors?.googleAnalytics?.id;
const gtmId = import.meta.env.PUBLIC_GTM_CONTAINER_ID || ANALYTICS?.vendors?.googleTagManager?.id;
const customerIoWriteKey = import.meta.env.PUBLIC_CUSTOMER_IO_WRITE_KEY || import.meta.env.PUBLIC_CIO_WRITE_KEY;
---

<script is:inline define:vars={{ gaId }}>
  (function () {
    if (typeof window === 'undefined') return;
    const urlParams = new URLSearchParams(window.location.search);
    let isInternalUser = false;
    try {
      isInternalUser = window.localStorage.getItem('zf_internal_user') === '1';
    } catch {
      // Browser storage may be unavailable; URL-based QA exclusions still apply.
    }
    const isInternalQA =
      urlParams.get('utm_source') === 'internal-qa' ||
      urlParams.get('utm_medium') === 'verification' ||
      urlParams.get('internal_qa') === '1' ||
      isInternalUser;

    const isElectron =
      typeof navigator !== 'undefined' && navigator.userAgent.toLowerCase().includes('electron');

    window.__zfIsProdHost = !isElectron && !isInternalQA && /^(www\.)?ziaflow\.com$/i.test(window.location.hostname);
    if (gaId && window.__zfIsProdHost) {
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        // eslint-disable-next-line prefer-rest-params
        window.dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId);
    }
  })();
</script>

<script is:inline>
  if (window.__zfIsProdHost) {
    window.clarity =
      window.clarity ||
      function (...args) {
        (window.clarity.q = window.clarity.q || []).push(args);
      };
  }
</script>

<script is:inline define:vars={{ gtmId }}>
  if (gtmId && window.__zfIsProdHost) {
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      const f = d.getElementsByTagName(s)[0],
        j = d.createElement(s),
        dl = l != 'dataLayer' ? '&l=' + l : '';
      j.async = true;
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
      f.parentNode.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', gtmId);
  }
</script>

<script is:inline define:vars={{ gaId }}>
  if (gaId && window.__zfIsProdHost) {
    const script = document.createElement('script');
    script.async = true;
    script.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
    document.head.appendChild(script);
  }
</script>

{
  customerIoWriteKey && (
    <script is:inline define:vars={{ customerIoWriteKey }}>
      /* eslint-disable */
      if (customerIoWriteKey && window.__zfIsProdHost) {
        !(function () {
          var i = 'cioanalytics',
            analytics = (window[i] = window.analytics = window[i] || []);
          if (!analytics.initialize) {
            if (analytics.invoked) {
              window.console && console.error && console.error('Snippet included twice.');
            } else {
              analytics.invoked = !0;
              analytics.methods = [
                'trackSubmit',
                'trackClick',
                'trackLink',
                'trackForm',
                'pageview',
                'identify',
                'reset',
                'group',
                'track',
                'ready',
                'alias',
                'debug',
                'page',
                'once',
                'off',
                'on',
                'addSourceMiddleware',
                'addIntegrationMiddleware',
                'setAnonymousId',
                'addDestinationMiddleware',
              ];
              analytics.factory = function (e) {
                return function () {
                  var t = Array.prototype.slice.call(arguments);
                  t.unshift(e);
                  analytics.push(t);
                  return analytics;
                };
              };
              for (var e = 0; e < analytics.methods.length; e++) {
                var key = analytics.methods[e];
                analytics[key] = analytics.factory(key);
              }
              analytics.load = function (key, e) {
                var t = document.createElement('script');
                t.type = 'text/javascript';
                t.async = !0;
                t.setAttribute('data-global-customerio-analytics-key', i);
                t.src = 'https://cdp.customer.io/v1/analytics-js/snippet/' + key + '/analytics.min.js';
                var n = document.getElementsByTagName('script')[0];
                if (n && n.parentNode) {
                  n.parentNode.insertBefore(t, n);
                } else {
                  document.head.appendChild(t);
                }
                analytics._writeKey = key;
                analytics._loadOptions = e;
              };
              analytics.SNIPPET_VERSION = '4.15.3';
              analytics.load(customerIoWriteKey);
              analytics.page();
              window._cio = window._cio || analytics;
            }
          }
        })();
      }
    </script>
  )
}

{clarityId && <div id="clarity-setup" data-id={clarityId} class="hidden" />}

<script>
  import Clarity from '@microsoft/clarity';

  declare global {
    interface Window {
      clarity: (...args: unknown[]) => void;
      dataLayer?: Record<string, unknown>[];
      __zfIsProdHost?: boolean;
    }
  }

  const isElectron =
    typeof navigator !== 'undefined' && navigator.userAgent.toLowerCase().includes('electron');
  const isProdHost =
    !isElectron && Boolean(window.__zfIsProdHost) && /^(www\.)?ziaflow\.com$/i.test(window.location.hostname);

  const pushDataLayer = (payload: Record<string, unknown>) => {
    if (Array.isArray(window.dataLayer)) {
      window.dataLayer.push(payload);
    }
  };

  const trackClarityEvent = (eventName: string) => {
    if (typeof window.clarity === 'function') {
      window.clarity('event', eventName);
    }
  };

  if (isProdHost) {
    const element = document.getElementById('clarity-setup');
    const id = element?.dataset.id;
    if (id) {
      Clarity.init(id);

      // Tracking Scroll Depth
      let maxScroll = 0;
      window.addEventListener(
        'scroll',
        () => {
          const scrollPercent = Math.round(
            ((window.scrollY + window.innerHeight) / document.documentElement.scrollHeight) * 100
          );
          if (scrollPercent > maxScroll && scrollPercent % 25 === 0) {
            maxScroll = scrollPercent;
            if (window.clarity) {
              window.clarity('set', 'scroll_depth', maxScroll.toString());
              if (maxScroll >= 75) window.clarity('upgrade', 'high scroll depth');
            }
          }
        },
        { passive: true }
      );

      // Track Dead Clicks (Simplified)
      document.addEventListener(
        'click',
        (e) => {
          const target = e.target as HTMLElement | null;
          if (!target) return;
          if (!target.closest('a') && !target.closest('button') && !target.closest('input')) {
            if (target.innerText?.length < 50 && (target.classList.contains('icon') || target.title)) {
              trackClarityEvent('potential_dead_click');
            }
          }
        },
        { passive: true }
      );
    }

    // Micro-conversion tracking: primary CTA clicks
    document.addEventListener(
      'click',
      (e) => {
        const target = e.target as HTMLElement | null;
        const interactive = target?.closest('a, button') as HTMLElement | null;
        if (!interactive) return;

        const rawText = (interactive.textContent || '').replace(/\s+/g, ' ').trim();
        const normalized = rawText.toLowerCase();
        let ctaName = '';

        if (normalized.includes('request a lead-flow review')) {
          ctaName = 'request_lead_flow_review';
        } else if (normalized.includes('book a scoping call')) {
          ctaName = 'book_scoping_call';
        }

        if (!ctaName) return;

        pushDataLayer({
          event: 'cta_click',
          cta_name: ctaName,
          cta_text: rawText.slice(0, 100),
          cta_href: interactive.getAttribute('href') || '',
          page_path: window.location.pathname,
        });
        trackClarityEvent(`cta_click_${ctaName}`);
      },
      { passive: true }
    );

    // Micro-conversion tracking: form focus & abandonment
    const focusedForms = new Set<HTMLFormElement>();
    const dirtyForms = new WeakSet<HTMLFormElement>();
    const submittedForms = new WeakSet<HTMLFormElement>();
    const abandonedForms = new WeakSet<HTMLFormElement>();

    const getFormIdentifier = (form: HTMLFormElement): string => {
      if (form.id) return form.id;
      if (form.hasAttribute('data-short-lead-form')) return 'short_lead_form';
      if (form.hasAttribute('data-ai-triage-form')) return 'ai_triage_form';
      return form.getAttribute('name') || 'unnamed_form';
    };

    const isTrackableField = (el: EventTarget | null): el is HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement => {
      if (!(el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement)) {
        return false;
      }
      if (el instanceof HTMLInputElement && el.type === 'hidden') return false;
      if (el.name === 'website_url') return false;
      return true;
    };

    document.addEventListener(
      'focusin',
      (e) => {
        if (!isTrackableField(e.target)) return;
        const form = e.target.form;
        if (!form || focusedForms.has(form)) return;

        focusedForms.add(form);
        const formId = getFormIdentifier(form);
        pushDataLayer({
          event: 'form_focus',
          form_id: formId,
          field_name: e.target.name || e.target.id || '',
          page_path: window.location.pathname,
        });
        trackClarityEvent('form_focus');
        if (typeof window.clarity === 'function') {
          window.clarity('set', 'active_form', formId);
        }
      },
      { passive: true }
    );

    const markFormDirty = (e: Event) => {
      if (!isTrackableField(e.target)) return;
      if (e.target.form) dirtyForms.add(e.target.form);
    };
    document.addEventListener('input', markFormDirty, { passive: true });
    document.addEventListener('change', markFormDirty, { passive: true });

    document.addEventListener(
      'submit',
      (e) => {
        if (e.target instanceof HTMLFormElement) {
          submittedForms.add(e.target);
        }
      },
      { passive: true }
    );

    const reportAbandonment = () => {
      focusedForms.forEach((form) => {
        if (submittedForms.has(form) || abandonedForms.has(form)) return;
        abandonedForms.add(form);
        const hadInput = dirtyForms.has(form);
        const formId = getFormIdentifier(form);
        pushDataLayer({
          event: 'form_abandon',
          form_id: formId,
          had_input: hadInput,
          page_path: window.location.pathname,
        });
        trackClarityEvent(hadInput ? 'form_abandon_with_input' : 'form_abandon_no_input');
      });
    };

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') reportAbandonment();
    });
    window.addEventListener('pagehide', reportAbandonment);
  }
</script>

<script is:inline>
  (function () {
    const PHONE_DIGITS = '6028344239';

    document.addEventListener(
      'click',
      function (e) {
        const link = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
        if (!link) return;

        const href = link.getAttribute('href') || '';
        const digits = href.replace(/\D/g, '');
        if (digits.slice(-10) !== PHONE_DIGITS) return;

        const props = {
          phone_number: '(602) 834-4239',
          page_url: window.location.href,
          page_path: window.location.pathname,
          link_text: (link.textContent || '').trim().slice(0, 100),
        };

        if (window._cio && typeof window._cio.track === 'function') {
          window._cio.track('phone_click', props);
        } else if (window.analytics && typeof window.analytics.track === 'function') {
          window.analytics.track('phone_click', props);
        }

        if (window.dataLayer && Array.isArray(window.dataLayer)) {
          window.dataLayer.push({
            event: 'phone_click',
            ...props,
          });
        }
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'phone_click', props);
        }
      },
      { passive: true }
    );
  })();
</script>
