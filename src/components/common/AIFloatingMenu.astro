---
import siteIcon from '~/assets/favicons/favicon.svg';

const query =
  'As a business owner, I want to know why ZiaFlow is the best digital transformation partner for website development, SEO, and business automation. What are their core strengths, solutions, and success stories?';

const encodedQuery = encodeURIComponent(query);

const platforms = [
  {
    name: 'ChatGPT',
    href: `https://chatgpt.com/?q=${encodedQuery}`,
    logo: 'https://www.singlegrain.com/wp-content/themes/singlegrain/assets/dist/images/redesign2024/ai-logos/small-chat-gpt.webp',
  },
  {
    name: 'Gemini',
    href: `https://gemini.google.com/app?prompt=${encodedQuery}`,
    logo: 'https://www.singlegrain.com/wp-content/themes/singlegrain/assets/dist/images/redesign2024/ai-logos/small-gemini.webp',
  },
  {
    name: 'Perplexity',
    href: `https://www.perplexity.ai/search/new?q=${encodedQuery}`,
    logo: 'https://www.singlegrain.com/wp-content/themes/singlegrain/assets/dist/images/redesign2024/ai-logos/small-perplexity.webp',
  },
  {
    name: 'Claude',
    href: `https://claude.ai/new?q=${encodedQuery}`,
    logo: 'https://www.singlegrain.com/wp-content/themes/singlegrain/assets/dist/images/redesign2024/ai-logos/small-claude.webp',
  },
  {
    name: 'Grok',
    href: `https://x.com/i/grok?text=${encodedQuery}`,
    logo: 'https://www.singlegrain.com/wp-content/themes/singlegrain/assets/dist/images/redesign2024/ai-logos/small-grok.webp',
  },
];

const variant = Astro.props.variant ?? 'side';
const isInline = variant === 'inline';
const isSide = variant === 'side';
const rootId = isInline ? undefined : 'aiSummaryFloat';
---

<div
  id={rootId}
  class:list={[
    'ai-summary-root',
    isInline ? 'ai-summary-inline' : isSide ? 'ai-summary-side' : 'ai-summary-float',
  ]}
  data-ai-summary-root
>
  <div class="ai-floating-bar">
    <button
      class:list={[
        'ai-summary-toggle',
        isInline && 'ai-summary-toggle-inline',
        isSide && 'ai-summary-toggle-side group',
      ]}
      data-ai-toggle
      aria-label="Quick Intake & Ask AI about ZiaFlow"
      type="button"
    >
      <!-- Live indicator badge -->
      <span class="ai-live-indicator">
        <span class="ai-live-ping"></span>
        <span class="ai-live-dot"></span>
      </span>

      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="ai-icon">
        <path
          d="M12 2L2 7L12 12L22 7L12 2Z"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        ></path>
        <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        ></path>
      </svg>
      <span class="ai-label">Ask AI</span>
    </button>
    {!isInline && (
      <button
        type="button"
        class="ai-dismiss-btn"
        data-ai-dismiss
        aria-label="Close Ask AI button"
        title="Dismiss Ask AI"
      >
        &times;
      </button>
    )}
  </div>

  <div class="ai-summary-menu" data-ai-menu>
    <div class="ai-summary-menu-header">
      <span class="ai-summary-menu-title">
        <img src={siteIcon.src} alt="ZiaFlow" width="20" height="20" loading="lazy" />
        ZiaFlow Assistant
      </span>
      <button class="ai-summary-close" aria-label="Close" type="button">&times;</button>
    </div>

    <div class="ai-tabs" role="tablist">
      <button type="button" class="ai-tab active" data-ai-tab="triage" role="tab" aria-selected="true">
        Quick Triage
      </button>
      <button type="button" class="ai-tab" data-ai-tab="platforms" role="tab" aria-selected="false">
        Ask AI Models
      </button>
    </div>

    <!-- Panel 1: Instant Project Triage & Callback -->
    <div class="ai-panel active" data-ai-panel="triage">
      <p class="ai-triage-intro">
        Request a fast engineering callback or run an interactive diagnostic tool.
      </p>
      <form class="ai-triage-form" data-ai-triage-form>
        <input
          type="text"
          name="name"
          placeholder="Your name *"
          required
          maxlength="120"
          class="ai-input"
        />
        <input
          type="email"
          name="email"
          placeholder="Work email *"
          required
          maxlength="254"
          class="ai-input"
        />
        <input
          type="tel"
          name="phone"
          placeholder="Phone (optional)"
          maxlength="40"
          class="ai-input"
        />
        <select name="service_interest" class="ai-input">
          <option value="Lead Capture & Follow-Up Sprint">Lead Capture & Follow-Up Sprint</option>
          <option value="Web Development & Astro Rebuild">Web Development & Astro Rebuild</option>
          <option value="Phoenix Technical SEO & GBP">Phoenix Technical SEO & GBP</option>
          <option value="Google Local Service Ads (LSA)">Google Local Service Ads (LSA)</option>
          <option value="Conversion Rate Optimization">Conversion Rate Optimization</option>
        </select>
        <input type="text" name="website_url" tabindex="-1" autocomplete="off" class="ai-honeypot" aria-hidden="true" />
        <button type="submit" class="ai-submit-btn" data-ai-triage-submit>
          Request Fast Callback →
        </button>
        <p class="ai-triage-status" data-ai-triage-status aria-live="polite"></p>
      </form>
      <div class="ai-quick-actions">
        <a href="tel:+16028344239" class="ai-quick-link">📞 Call (602) 834-4239</a>
        <a href="/growth-tools" class="ai-quick-link">⚡ 5 Free Diagnostic Tools</a>
      </div>
    </div>

    <!-- Panel 2: External AI Platforms -->
    <div class="ai-panel" data-ai-panel="platforms">
      <div class="ai-summary-menu-links">
        {
          platforms.map(({ name, href, logo }) => (
            <a class="ai-summary-menu-link" href={href} target="_blank" rel="noopener" data-ai-platform={name}>
              <img src={logo} alt={name} width="28" height="28" loading="lazy" />
              <span>Ask {name} about ZiaFlow</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .ai-summary-root {
    z-index: 9999;
  }

  .ai-summary-side {
    position: fixed;
    bottom: 18px;
    right: 18px;
    z-index: 9999;
  }

  .ai-floating-bar {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .ai-summary-toggle-side {
    position: relative;
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    background: linear-gradient(145deg, #232323 0%, #1a1a1a 100%);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.55);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    min-width: auto;
  }

  .ai-summary-toggle-side:hover {
    transform: translateY(-2px);
    border-color: #a22a36;
    box-shadow: 0 0 24px rgba(162, 42, 54, 0.45), 0 12px 28px rgba(0, 0, 0, 0.65);
  }

  .ai-dismiss-btn {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: rgba(26, 26, 26, 0.92);
    color: #b8b8b8;
    border: 1px solid rgba(255, 255, 255, 0.18);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.45);
  }

  .ai-dismiss-btn:hover {
    color: #ffffff;
    border-color: #a22a36;
    background: #a22a36;
  }

  .ai-live-indicator {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 10px;
    height: 10px;
  }

  .ai-live-ping {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: #34d399;
    opacity: 0.75;
    animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .ai-live-dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #10b981;
  }

  .ai-icon {
    color: #a22a36;
    transition: transform 0.3s ease;
  }

  .ai-summary-toggle-side:hover .ai-icon {
    transform: scale(1.1);
  }

  .ai-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1;
    color: #ffffff;
  }

  .ai-summary-side .ai-summary-menu {
    position: absolute;
    right: 0;
    bottom: calc(100% + 12px);
    top: auto;
    transform: translateY(10px);
    background: #1e1e1e;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 18px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.85);
    width: 310px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ai-summary-side .ai-summary-menu.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .ai-summary-float {
    position: fixed;
    bottom: 20px;
    right: 20px;
  }

  .ai-summary-inline {
    position: relative;
    display: inline-block;
  }

  .ai-summary-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #a22a36;
    color: white;
    border: none;
    border-radius: 50px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(162, 42, 54, 0.3);
    transition: all 0.3s ease;
    white-space: nowrap;
    width: auto;
    min-width: 120px;
    justify-content: center;
  }

  .ai-summary-toggle-inline {
    border-radius: 8px;
    box-shadow: none;
    padding: 6px 16px;
    font-size: 13px;
    background: linear-gradient(135deg, #a22a36 0%, #7c1e29 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    min-width: auto;
  }

  .ai-summary-menu {
    position: absolute;
    bottom: 60px;
    right: 0;
    background: #1e1e1e;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 16px;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.75);
    width: 300px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.3s ease;
    color: #f5f5f2;
  }

  .ai-summary-inline .ai-summary-menu {
    bottom: auto;
    top: calc(100% + 0.75rem);
    right: 0;
  }

  .ai-summary-menu.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .ai-summary-menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-weight: 700;
    font-size: 14px;
    color: #f5f5f2;
  }

  .ai-summary-menu-title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .ai-summary-menu-title img {
    border-radius: 4px;
  }

  .ai-summary-close {
    background: none;
    border: none;
    font-size: 22px;
    color: #9ca3af;
    cursor: pointer;
    padding: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .ai-summary-close:hover {
    color: #ffffff;
  }

  .ai-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: #161616;
  }

  .ai-tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 10px 8px;
    font-size: 12px;
    font-weight: 600;
    color: #9ca3af;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .ai-tab.active {
    color: #f5f5f2;
    border-bottom-color: #a22a36;
    background: rgba(162, 42, 54, 0.1);
  }

  .ai-panel {
    display: none;
    padding: 14px 16px;
  }

  .ai-panel.active {
    display: block;
  }

  .ai-triage-intro {
    font-size: 12px;
    line-height: 1.45;
    color: #b8b8b8;
    margin: 0 0 10px;
  }

  .ai-triage-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-input {
    width: 100%;
    padding: 8px 10px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: #141414;
    color: #f5f5f2;
    font-size: 12.5px;
  }

  .ai-input:focus {
    outline: none;
    border-color: #a22a36;
  }

  .ai-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .ai-submit-btn {
    margin-top: 2px;
    width: 100%;
    padding: 10px 12px;
    border-radius: 9999px;
    border: none;
    background: #a22a36;
    color: #ffffff;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .ai-submit-btn:hover:not(:disabled) {
    background: #89212c;
  }

  .ai-submit-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .ai-triage-status {
    font-size: 11.5px;
    line-height: 1.4;
    margin: 2px 0 0;
    min-height: 16px;
    color: #34d399;
  }

  .ai-quick-actions {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .ai-quick-link {
    font-size: 11.5px;
    font-weight: 600;
    color: #d4d4d0;
    text-decoration: none;
  }

  .ai-quick-link:hover {
    color: #a22a36;
  }

  .ai-summary-menu-links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-summary-menu-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: #d4d4d0;
    font-size: 13px;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .ai-summary-menu-link:hover {
    background: #2c2c2c;
    color: #ffffff;
    transform: translateX(3px);
  }

  .ai-summary-menu-link img {
    border-radius: 6px;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .ai-summary-side .ai-summary-menu {
      width: 280px;
    }
  }
</style>

<script is:inline>
  function initAISummaryMenus() {
    const roots = document.querySelectorAll('[data-ai-summary-root]');
    roots.forEach((root) => {
      if (root.dataset.aiInitialized === 'true') return;
      root.dataset.aiInitialized = 'true';

      const toggle = root.querySelector('[data-ai-toggle]');
      const dismissBtn = root.querySelector('[data-ai-dismiss]');
      const menu = root.querySelector('[data-ai-menu]');
      const closeBtn = root.querySelector('.ai-summary-close');
      const links = root.querySelectorAll('.ai-summary-menu-link');
      const tabs = root.querySelectorAll('[data-ai-tab]');
      const panels = root.querySelectorAll('[data-ai-panel]');
      const triageForm = root.querySelector('[data-ai-triage-form]');
      const triageSubmit = root.querySelector('[data-ai-triage-submit]');
      const triageStatus = root.querySelector('[data-ai-triage-status]');

      try {
        if (sessionStorage.getItem('ziaflow:ai-dismissed') === '1') {
          root.style.display = 'none';
        }
      } catch (e) {}

      dismissBtn?.addEventListener('click', (event) => {
        event.stopPropagation();
        root.style.display = 'none';
        try {
          sessionStorage.setItem('ziaflow:ai-dismissed', '1');
        } catch (e) {}
      });

      if (!toggle || !menu) return;

      const makeKey = () =>
        typeof crypto !== 'undefined' && crypto.randomUUID
          ? crypto.randomUUID()
          : 'ai-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);
      let activeKey = makeKey();

      const closeMenu = () => menu.classList.remove('active');

      toggle.addEventListener('click', (event) => {
        event.stopPropagation();
        menu.classList.toggle('active');
      });

      closeBtn?.addEventListener('click', (event) => {
        event.stopPropagation();
        closeMenu();
      });

      tabs.forEach((tab) => {
        tab.addEventListener('click', (event) => {
          event.stopPropagation();
          const target = tab.getAttribute('data-ai-tab');
          tabs.forEach((t) => {
            const isMatch = t.getAttribute('data-ai-tab') === target;
            t.classList.toggle('active', isMatch);
            t.setAttribute('aria-selected', String(isMatch));
          });
          panels.forEach((p) => {
            p.classList.toggle('active', p.getAttribute('data-ai-panel') === target);
          });
        });
      });

      triageForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!triageSubmit || !triageStatus) return;
        const formData = new FormData(triageForm);
        const params = new URLSearchParams(window.location.search);
        triageSubmit.disabled = true;
        triageStatus.style.color = '#b8b8b8';
        triageStatus.textContent = 'Saving inquiry...';

        const payload = {
          name: String(formData.get('name') || '').trim(),
          email: String(formData.get('email') || '').trim(),
          phone: String(formData.get('phone') || '').trim(),
          service_interest: String(formData.get('service_interest') || 'Quick Triage Callback'),
          message: 'Submitted via floating Quick Triage assistant',
          form_type: 'quick_triage',
          page: window.location.pathname,
          page_url: window.location.href,
          utm_source: params.get('utm_source') || '',
          utm_medium: params.get('utm_medium') || '',
          utm_campaign: params.get('utm_campaign') || '',
          utm_term: params.get('utm_term') || '',
          utm_content: params.get('utm_content') || '',
          website_url: String(formData.get('website_url') || ''),
          idempotency_key: activeKey,
        };

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const body = await res.json().catch(() => ({}));
          if (res.ok) {
            if (!body.duplicate) {
              if (window.dataLayer) {
                window.dataLayer.push({
                  event: 'form_submission',
                  form_name: 'ai_quick_triage',
                  service_interest: payload.service_interest,
                });
              }
              if (typeof window.gtag === 'function') {
                window.gtag('event', 'generate_lead', {
                  event_category: 'engagement',
                  event_label: 'ai_quick_triage',
                  value: 1,
                });
              }
            }
            activeKey = makeKey();
            triageStatus.style.color = '#34d399';
            triageStatus.textContent = 'Saved! Our Phoenix team will reach out shortly.';
            triageForm.reset();
          } else {
            triageStatus.style.color = '#f87171';
            triageStatus.textContent = body.message || 'Could not save. Call (602) 834-4239.';
          }
        } catch {
          triageStatus.style.color = '#f87171';
          triageStatus.textContent = 'Network error. Call (602) 834-4239.';
        } finally {
          triageSubmit.disabled = false;
        }
      });

      document.addEventListener('click', (event) => {
        if (!root.contains(event.target)) {
          closeMenu();
        }
      });

      links.forEach((link) => {
        link.addEventListener('click', () => {
          const platform = link.getAttribute('data-ai-platform');
          if (typeof window !== 'undefined' && typeof window.gtag === 'function') {
            window.gtag('event', 'ai_summary_click', {
              event_category: 'ai_summary_component',
              event_label: platform,
              event_url: link.getAttribute('href'),
            });
          }
          closeMenu();
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAISummaryMenus);
  } else {
    initAISummaryMenus();
  }
  document.addEventListener('astro:after-swap', initAISummaryMenus);
</script>
