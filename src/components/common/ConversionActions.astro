<script>
  import { trackEvent } from '~/utils/analytics';

  document.addEventListener('click', (event) => {
    const link = event.target instanceof Element ? event.target.closest('a') : null;
    if (!link) return;
    const url = new URL(link.href, location.href);
    const eventName =
      url.protocol === 'mailto:'
        ? 'email_click'
        : url.protocol === 'tel:'
          ? 'phone_click'
          : url.hostname === 'outlook.office.com' ||
              (url.origin === location.origin && /^\/booking\/?$/.test(url.pathname))
            ? 'booking_click'
            : url.origin === location.origin && (/^\/contact\/?$/.test(url.pathname) || url.hash === '#hero-quick-form')
              ? 'contact_click'
              : null;
    if (eventName) {
      // Destination addresses and form values are not analytics properties.
      try {
        trackEvent(eventName, {
          link_location: link.closest('header') ? 'header' : link.closest('footer') ? 'footer' : 'content',
        });
      } catch {
        /* best effort */
      }
    }
  });
</script>
