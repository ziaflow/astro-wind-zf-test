---
const bookingUrl = 'https://calendly.com/jeremy-sanchez-ziaflow';
---

<div class="booking-frame" role="region" aria-label="Book with ZiaFlow">
  <iframe
    data-booking-iframe
    src={bookingUrl}
    title="Book a consultation"
    loading="lazy"
    referrerpolicy="no-referrer"
    allowfullscreen
  ></iframe>

  <div class="booking-fallback">
    <p>Having trouble with the calendar? Open the booking page in a new tab.</p>
    <a
      data-booking-fallback
      data-cta="book-scoping-call"
      class="booking-fallback__button"
      href={bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Open Booking Portal
    </a>
  </div>
</div>

<script>
  const UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
  const currentParams = new URLSearchParams(window.location.search);
  const utmEntries = UTM_KEYS.filter((key) => currentParams.get(key)).map((key) => [key, currentParams.get(key)!]);

  if (utmEntries.length > 0) {
    const appendUtms = (rawUrl: string) => {
      const url = new URL(rawUrl);
      for (const [k, v] of utmEntries) url.searchParams.set(k, v);
      return url.toString();
    };
    const iframe = document.querySelector<HTMLIFrameElement>('[data-booking-iframe]');
    if (iframe?.src) iframe.src = appendUtms(iframe.src);
    const fallback = document.querySelector<HTMLAnchorElement>('[data-booking-fallback]');
    if (fallback?.href) fallback.href = appendUtms(fallback.href);
  }

  window.addEventListener('message', (event) => {
    if (!event.origin.endsWith('calendly.com')) return;
    const payload = event.data;
    if (!payload || typeof payload !== 'object' || payload.event !== 'calendly.event_scheduled') return;

    const w = window as unknown as {
      dataLayer?: Record<string, unknown>[];
      gtag?: (...args: unknown[]) => void;
      _cio?: { track?: (event: string, props?: unknown) => void };
    };

    if (w.dataLayer) {
      w.dataLayer.push({
        event: 'call_booked',
        source: 'calendly_embed',
        page_path: window.location.pathname,
      });
    }
    if (typeof w.gtag === 'function') {
      w.gtag('event', 'schedule_call', {
        event_category: 'conversion',
        event_label: 'calendly_embed',
        value: 1,
      });
    }
    if (w._cio && typeof w._cio.track === 'function') {
      w._cio.track('call_booked', { source: 'calendly_embed', page_path: window.location.pathname });
    }

    window.setTimeout(() => {
      window.location.assign('/call-booked?source=calendly');
    }, 150);
  });
</script>

<style>
  .booking-frame {
    width: 100%;
    max-width: 100%;
    min-height: 720px;
    border: none;
    border-radius: 1.25rem;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.2);
    overflow: hidden;
    background: #ffffff;
  }

  .booking-frame iframe {
    width: 100%;
    display: block;
    height: 720px;
    border: 0;
  }

  .booking-fallback {
    margin-top: 1.25rem;
    padding: 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid rgb(226 232 240);
    background: linear-gradient(135deg, rgba(162, 42, 54, 0.08), rgba(63, 155, 147, 0.08));
    text-align: center;
    display: block;
  }

  .booking-fallback p {
    margin-bottom: 0.75rem;
    color: #374151;
    font-weight: 500;
  }

  .booking-fallback__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    font-weight: 600;
    color: #ffffff;
    background: linear-gradient(120deg, #a22a36, #000000, #3f9b93);
    background-size: 200% 200%;
    transition:
      background-position 0.4s ease,
      transform 0.2s ease;
  }

  .booking-fallback__button:hover {
    background-position: 100% 0;
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .booking-frame iframe {
      height: 560px;
    }

    .booking-frame {
      min-height: 560px;
      border-radius: 1rem;
    }
  }
</style>
