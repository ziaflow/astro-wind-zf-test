---
interface Props {
  name: string;
  description: string;
  url: string;
  image?: string;
}

const { name, description, url, image = '/images/product-reveal.jpg' } = Astro.props;

const siteUrl = 'https://ziaflow.com';
const absoluteImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;

const organization = {
  '@type': 'ProfessionalService',
  name: 'ZiaFlow',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  sameAs: [
    'https://www.linkedin.com/company/ziaflow/',
    'https://www.facebook.com/ZiaFlowAZ/',
    'https://www.yelp.com/biz/ziaflow-phoenix',
  ],
  telephone: '+1-602-834-4239',
  email: 'info@ziaflow.com',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '2822 E Greenway Rd Suite 10 B',
    addressLocality: 'Phoenix',
    addressRegion: 'AZ',
    postalCode: '85032',
    addressCountry: 'US',
  },
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: name,
  provider: organization,
  areaServed: [
    { '@type': 'City', name: 'Phoenix' },
    { '@type': 'City', name: 'Scottsdale' },
    { '@type': 'City', name: 'Mesa' },
    { '@type': 'City', name: 'Tempe' },
    { '@type': 'City', name: 'Chandler' },
    { '@type': 'City', name: 'Glendale' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Digital Growth & Lead Automation Services',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: name,
          description: description,
          url: url,
          image: absoluteImageUrl,
        },
      },
    ],
  },
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
