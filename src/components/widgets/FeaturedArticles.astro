---
import { APP_BLOG } from 'astrowind:config';
import { findLatestPosts } from '~/utils/blog';
import { getBlogPermalink } from '~/utils/permalinks';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import { findImage } from '~/utils/images';
import { Icon } from 'astro-icon/components';

export interface Props {
  id?: string;
  isDark?: boolean;
  title?: string;
  subtitle?: string;
  tagline?: string;
  count?: number;
}

const {
  id = 'featured-articles',
  isDark = false,
  title = 'Insights, Search Analytics & Automation Playbooks',
  subtitle = 'Research-backed articles on website conversion, Google Local Service Ads, and connecting high-performance web apps to operational CRMs.',
  tagline = 'Knowledge & Playbooks',
  count = 3,
} = Astro.props;

const posts = APP_BLOG.isEnabled ? await findLatestPosts({ count }) : [];
---

{
  APP_BLOG.isEnabled && posts.length > 0 && (
    <WidgetWrapper id={id} isDark={isDark} containerClass="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-10">
        <Headline
          title={title}
          subtitle={subtitle}
          tagline={tagline}
          classes={{ container: 'text-left mb-0 md:mb-0 max-w-2xl' }}
        />

        <div class="mt-4 md:mt-0">
          <Button variant="secondary" href={getBlogPermalink()}>
            All Insights
            <Icon name="tabler:arrow-right" class="w-4 h-4 ml-1 inline-block" />
          </Button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map(async (post) => {
          const image = await findImage(post.image);
          return (
            <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900/90">
              <div>
                {/* Media Header */}
                {image && (
                  <div class="relative h-52 w-full overflow-hidden bg-slate-100 dark:bg-slate-800">
                    <Image
                      src={image}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      widths={[400, 768]}
                      width={600}
                      sizes="(max-width: 768px) 100vw, 400px"
                      alt={post.title}
                      aspectRatio="16:9"
                      loading="lazy"
                      decoding="async"
                    />
                    {post.category && (
                      <span class="absolute top-3 left-3 inline-flex items-center rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-slate-800 shadow-sm backdrop-blur dark:bg-slate-900/90 dark:text-slate-200">
                        {post.category.title}
                      </span>
                    )}
                  </div>
                )}

                {/* Content */}
                <div class="p-6">
                  <div class="mb-2 flex items-center gap-2 text-xs text-muted dark:text-slate-400">
                    <Icon name="tabler:calendar" class="w-3.5 h-3.5" />
                    <time datetime={String(post.publishDate)}>
                      {new Date(post.publishDate).toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric',
                      })}
                    </time>
                    {post.readingTime && (
                      <>
                        <span>·</span>
                        <Icon name="tabler:clock" class="w-3.5 h-3.5" />
                        <span>{Math.ceil(post.readingTime)} min read</span>
                      </>
                    )}
                  </div>

                  <h3 class="mb-2 text-xl font-bold font-heading text-slate-900 transition-colors group-hover:text-primary dark:text-white">
                    <a href={post.permalink} class="focus:outline-none">
                      <span class="absolute inset-0" aria-hidden="true" />
                      {post.title}
                    </a>
                  </h3>

                  {post.excerpt && (
                    <p class="line-clamp-2 text-sm text-slate-600 dark:text-slate-300">
                      {post.excerpt}
                    </p>
                  )}
                </div>
              </div>

              {/* Read Action Footer */}
              <div class="border-t border-slate-100 p-6 pt-3 dark:border-slate-800">
                <span class="inline-flex items-center text-xs font-bold uppercase tracking-wider text-primary group-hover:underline">
                  Read Article
                  <Icon name="tabler:chevron-right" class="w-4 h-4 ml-0.5" />
                </span>
              </div>
            </article>
          );
        })}
      </div>
    </WidgetWrapper>
  )
}
