---
import { Icon } from 'astro-icon/components';

export interface Action {
  text: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'tertiary' | 'link';
  icon?: string;
  target?: string;
  class?: string;
}

export interface Metric {
  value: string;
  label: string;
  sublabel?: string;
  tag?: string;
}

export interface Props {
  tagline?: string;
  title?: string;
  subtitle?: string;
  actions?: Array<Action>;
  metrics?: Array<Metric>;
}

const {
  tagline = 'Engineering the Future',
  title,
  subtitle = 'Deploy autonomous AI agents, HIPAA-compliant voice assistants, and enterprise-grade web applications. We build the technology that scales Arizona businesses.',
  actions = [
    {
      variant: 'primary',
      text: 'Get Automation Strategy',
      href: '/contact',
      icon: 'tabler:robot',
    },
    {
      text: 'Book Tech Consult',
      href: 'https://outlook.office.com/book/ZiaFlowIntake@ziaflow.com/?ismsaljsauthenabled',
      target: '_blank',
      icon: 'tabler:calendar',
    },
  ],
  metrics = [
    { value: '50+', label: 'Arizona Businesses Scaled', sublabel: 'Phoenix & Scottsdale SMBs' },
    { value: '39%', label: 'AI Citation Share', sublabel: 'Copilot & Perplexity visibility' },
    { value: '150%', label: 'Avg. Pipeline Growth', sublabel: 'Verified via GA4 & Clarity' },
    { value: '24/7', label: 'Autonomous Voice AI', sublabel: 'HIPAA-compliant client intake' },
  ],
} = Astro.props;
---

<section
  class="relative isolate overflow-hidden bg-[#070b19] text-white pt-20 pb-16 md:pt-28 md:pb-24 border-b border-slate-800/80"
>
  <!-- Subtle Ambient Glow Orbs -->
  <div
    class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[720px] h-[400px] bg-gradient-to-tr from-[#a22a36]/25 via-[#7c1e29]/15 to-[#3f9b93]/20 blur-[130px] rounded-full -z-10"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute bottom-0 right-0 w-[420px] h-[320px] bg-[#3f9b93]/10 blur-[100px] rounded-full -z-10"
    aria-hidden="true"
  >
  </div>

  <!-- Subtle Precision Tech Grid Background -->
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,#1e293b0a_1px,transparent_1px),linear-gradient(to_bottom,#1e293b0a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] -z-10"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Content Column -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        <!-- Live Status Pill Badge -->
        <div
          class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-slate-700/80 bg-slate-900/80 backdrop-blur-md mb-6 shadow-sm"
        >
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#3f9b93] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#3f9b93]"></span>
          </span>
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-300">
            {tagline}
          </span>
        </div>

        <!-- Headline -->
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] mb-6 font-heading text-white"
        >
          {
            title ? (
              title
            ) : (
              <>
                Custom Software & <span class="digital-gradient-text">AI Solutions</span> That Power Growth
              </>
            )
          }
        </h1>

        <!-- Subtitle Copy -->
        <p class="text-lg sm:text-xl text-slate-300 font-normal leading-relaxed mb-8 max-w-2xl">
          {subtitle}
        </p>

        <!-- Call to Actions -->
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
          {
            actions.map((action, idx) => (
              <a
                href={action.href}
                target={action.target || '_self'}
                class:list={[
                  'inline-flex items-center justify-center font-semibold text-base py-3.5 px-7 rounded-full transition-all duration-200 cursor-pointer shadow-lg',
                  idx === 0
                    ? 'bg-primary text-white border border-primary hover:bg-[#8e232f] hover:shadow-primary/25 hover:scale-[1.02]'
                    : 'bg-slate-900/90 text-white border border-slate-700 hover:border-slate-500 hover:bg-slate-800 hover:scale-[1.02]',
                  action.class,
                ]}
              >
                {action.icon && <Icon name={action.icon} class="w-5 h-5 mr-2 -ml-1 inline-block" />}
                <span>{action.text}</span>
              </a>
            ))
          }
        </div>

        <!-- Trust Note -->
        <div class="mt-8 flex items-center gap-2 text-xs text-slate-400">
          <Icon name="tabler:shield-check" class="w-4 h-4 text-[#3f9b93]" />
          <span>HIPAA Compliant Architecture · Enterprise Security · Local Arizona Support</span>
        </div>
      </div>

      <!-- Right Column: Interactive Modern Metric Grid (Kairo-style cards) -->
      <div class="lg:col-span-5 w-full">
        <div class="grid grid-cols-2 gap-4">
          {
            metrics.map((m, i) => (
              <div
                class:list={[
                  'relative p-6 rounded-2xl border border-slate-800/80 bg-slate-900/60 backdrop-blur-md shadow-xl transition-all duration-300 hover:border-slate-700 hover:bg-slate-900/90 group',
                  i === 0 ? 'border-primary/30' : '',
                ]}
              >
                <div class="text-3xl sm:text-4xl font-extrabold tracking-tight font-heading text-white group-hover:text-primary transition-colors">
                  {m.value}
                </div>
                <div class="mt-2 text-sm font-semibold text-slate-200 leading-snug">{m.label}</div>
                {m.sublabel && <div class="mt-1 text-xs text-slate-400 font-normal">{m.sublabel}</div>}
                <div class="absolute top-3 right-3 text-slate-600 group-hover:text-[#3f9b93] transition-colors">
                  <Icon name="tabler:arrow-up-right" class="w-4 h-4" />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
