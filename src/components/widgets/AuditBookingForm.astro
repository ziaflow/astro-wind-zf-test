---
/**
 * AuditBookingForm - Embedded lead capture form for audit booking
 * Submits to a serverless function or email handler
 * Fires dataLayer event on submission for GTM tracking
 */

interface Props {
  id?: string;
  class?: string;
}

const { id = 'audit-form', class: className = '' } = Astro.props;
---

<div class:list={['audit-booking-form w-full max-w-xl mx-auto', className]} {id}>
  <div class="relative overflow-hidden rounded-2xl border border-line-strong bg-ink-2/95 p-6 sm:p-8 md:p-10 shadow-[0_20px_60px_rgba(0,0,0,0.7)] backdrop-blur-md">
    <div class="absolute -top-24 -right-24 size-48 rounded-full bg-signal/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="absolute -bottom-24 -left-24 size-48 rounded-full bg-teal/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10 mb-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-line bg-ink-3/80 px-3 py-1 text-xs font-mono uppercase tracking-wider text-signal mb-4">
        <span class="size-1.5 rounded-full bg-signal animate-pulse"></span>
        Free Forensic Review
      </div>
      <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-bone">
        Book Your Growth Audit
      </h2>
      <p class="mt-2 text-sm text-mute leading-relaxed">
        We record a personalized video audit breaking down your Core Web Vitals, SEO positions, and conversion bottlenecks within 48 hours.
      </p>
    </div>

    <form
      id="audit-booking-form"
      method="POST"
      action="/api/contact"
      class="space-y-5 relative z-10"
      data-ga-event="form_submission"
      data-ga-label="audit_booking"
    >
      <input type="hidden" name="form_type" value="audit_booking" />
      <input type="hidden" name="service_interest" value="Growth Audit" />
      <input type="hidden" name="from_email" value="mailto:info@ziaflow.com" />

      {/* Anti-spam honeypot field */}
      <div class="opacity-0 absolute -z-10 select-none pointer-events-none" style="position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden;" aria-hidden="true" tabindex="-1">
        <label for="audit_website_url">Leave this field blank</label>
        <input type="text" id="audit_website_url" name="website_url" value="" autocomplete="off" tabindex="-1" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- First Name -->
        <div>
          <label for="first_name" class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">
            First Name *
          </label>
          <input
            type="text"
            id="first_name"
            name="first_name"
            required
            placeholder="John"
            class="w-full px-4 py-3 border border-line rounded-xl bg-ink-3/70 text-bone placeholder:text-dim text-sm transition-all duration-200 focus:outline-none focus:border-bone focus:bg-ink-3"
          />
        </div>

        <!-- Last Name -->
        <div>
          <label for="last_name" class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">
            Last Name *
          </label>
          <input
            type="text"
            id="last_name"
            name="last_name"
            required
            placeholder="Doe"
            class="w-full px-4 py-3 border border-line rounded-xl bg-ink-3/70 text-bone placeholder:text-dim text-sm transition-all duration-200 focus:outline-none focus:border-bone focus:bg-ink-3"
          />
        </div>
      </div>

      <!-- Company Name -->
      <div>
        <label for="company_name" class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">
          Company Name & Website *
        </label>
        <input
          type="text"
          id="company_name"
          name="company_name"
          required
          placeholder="Acme Corp (acme.com)"
          class="w-full px-4 py-3 border border-line rounded-xl bg-ink-3/70 text-bone placeholder:text-dim text-sm transition-all duration-200 focus:outline-none focus:border-bone focus:bg-ink-3"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Email -->
        <div>
          <label for="email" class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">
            Work Email *
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="john@acme.com"
            class="w-full px-4 py-3 border border-line rounded-xl bg-ink-3/70 text-bone placeholder:text-dim text-sm transition-all duration-200 focus:outline-none focus:border-bone focus:bg-ink-3"
          />
        </div>

        <!-- Phone Number -->
        <div>
          <label for="phone" class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">
            Phone Number *
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            required
            placeholder="+1 (602) 000-0000"
            class="w-full px-4 py-3 border border-line rounded-xl bg-ink-3/70 text-bone placeholder:text-dim text-sm transition-all duration-200 focus:outline-none focus:border-bone focus:bg-ink-3"
          />
        </div>
      </div>

      <!-- Message -->
      <div>
        <label for="message" class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">
          Current Bottlenecks (optional)
        </label>
        <textarea
          id="message"
          name="message"
          rows="3"
          placeholder="Tell us about your conversion rate, speed issues, or growth targets..."
          class="w-full px-4 py-3 border border-line rounded-xl bg-ink-3/70 text-bone placeholder:text-dim text-sm transition-all duration-200 focus:outline-none focus:border-bone focus:bg-ink-3 resize-none"
        ></textarea>
      </div>

      <!-- Privacy Notice -->
      <p class="text-xs text-dim leading-relaxed">
        🔒 100% confidential. No spam or high-pressure pitches. Delivered directly to your inbox.
      </p>

      <!-- Submit Button -->
      <button
        type="submit"
        class="btn group relative w-full h-14 bg-signal hover:bg-signal-dark text-bone font-semibold rounded-full shadow-[0_0_24px_rgba(162,42,54,0.35)] transition-all flex items-center justify-center gap-3 text-sm uppercase tracking-wider cursor-pointer"
        data-ga-event="form_submit_click"
        data-ga-label="audit_booking_submit"
      >
        <span class="btn-fill bg-bone" aria-hidden="true"></span>
        <span>Claim Free 48-Hour Audit</span>
        <svg class="size-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" fill="currentColor">
          <path fill-rule="evenodd" d="M1 8a.75.75 0 0 1 .75-.75h11.19l-3.72-3.72a.75.75 0 0 1 1.06-1.06l5 5a.75.75 0 0 1 0 1.06l-5 5a.75.75 0 0 1-1.06-1.06l3.72-3.72H1.75A.75.75 0 0 1 1 8Z" clip-rule="evenodd"/>
        </svg>
      </button>
    </form>

    <!-- Success Message (hidden, shown on submit) -->
    <div
      id="audit-form-success"
      class="hidden mt-6 p-8 rounded-xl border border-emerald-500/30 bg-ink-3/90 text-center relative z-10 space-y-3"
    >
      <div class="size-12 rounded-full bg-emerald-500/20 text-emerald-400 mx-auto flex items-center justify-center text-xl font-bold">
        ✓
      </div>
      <h3 class="font-display text-xl font-bold text-bone">Audit Request Confirmed</h3>
      <p class="text-sm text-mute max-w-sm mx-auto">
        Thanks! Our engineering team has received your details. We will analyze your site and email your custom forensic video within 48 hours.
      </p>
    </div>
  </div>
</div>

<script is:inline>
  const form = document.getElementById('audit-booking-form');
  const successDiv = document.getElementById('audit-form-success');
  const makeAuditKey = () =>
    typeof crypto !== 'undefined' && crypto.randomUUID
      ? crypto.randomUUID()
      : 'audit-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);
  let activeAuditKey = makeAuditKey();

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const rawData = Object.fromEntries(formData);
      const params = new URLSearchParams(window.location.search);

      const fullName = [rawData.first_name, rawData.last_name].filter(Boolean).join(' ').trim() || rawData.name || '';
      const payload = {
        ...rawData,
        name: fullName,
        company: rawData.company_name || rawData.company || '',
        service_interest: rawData.service_interest || 'Growth Audit',
        page: window.location.pathname,
        page_url: window.location.href,
        utm_source: params.get('utm_source') || '',
        utm_medium: params.get('utm_medium') || '',
        utm_campaign: params.get('utm_campaign') || '',
        utm_term: params.get('utm_term') || '',
        utm_content: params.get('utm_content') || '',
        idempotency_key: activeAuditKey,
      };

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await response.json().catch(() => ({}));

        if (response.ok) {
          if (!body.duplicate) {
            if (window.dataLayer) {
              window.dataLayer.push({
                event: 'form_submission',
                form_name: 'audit_booking',
                email: payload.email,
                company: payload.company,
              });
            }
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'generate_lead', {
                event_category: 'engagement',
                event_label: 'audit_booking',
                value: 1,
              });
            }
          }
          activeAuditKey = makeAuditKey();
          form.classList.add('hidden');
          successDiv.classList.remove('hidden');
        } else {
          alert(body.message || 'Something went wrong. Please try again.');
        }
      } catch (error) {
        console.error('Form submission error:', error);
        alert('Error submitting form. Please try again.');
      }
    });
  }
</script>

<style>
  input:disabled,
  textarea:disabled {
    background-color: #f3f4f6;
    cursor: not-allowed;
  }
</style>
