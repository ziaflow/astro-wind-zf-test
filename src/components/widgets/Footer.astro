---
import { getHomePermalink, getPermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  label?: string;
  href?: string;
  ariaLabel?: string;
}

interface LinkGroup {
  title?: string;
  links?: Array<Link>;
}

export interface Props {
  links?: Array<LinkGroup>;
  secondaryLinks?: Array<Link>;
  socialLinks?: Array<Link>;
  footNote?: string;
  theme?: string;
}

const {
  links = [
    {
      title: 'Services',
      links: [
        { text: 'AI & Automation', href: getPermalink('/services/automation') },
        { text: 'Web Development', href: getPermalink('/services/web-development') },
        { text: 'SEO', href: getPermalink('/services/seo') },
        { text: 'PPC Management', href: getPermalink('/services/ppc') },
        { text: 'Ecommerce', href: getPermalink('/services/ecommerce') },
      ],
    },
    {
      title: 'Company',
      links: [
        { text: 'Home', href: getHomePermalink() },
        { text: 'About ZiaFlow', href: getPermalink('/about') },
        { text: 'Contact', href: getPermalink('/contact') },
        { text: 'Articles & Insights', href: getPermalink('/blog') },
      ],
    },
  ],
  secondaryLinks = [
    { text: 'Privacy Policy', href: getPermalink('/privacy') },
    { text: 'Terms', href: getPermalink('/terms') },
  ],
  socialLinks = [
    { text: 'LinkedIn', ariaLabel: 'LinkedIn', href: 'https://www.linkedin.com/company/ziaflow/' },
    { text: 'Instagram', ariaLabel: 'Instagram', href: 'https://www.instagram.com/ziaflowaz/' },
    { text: 'Facebook', ariaLabel: 'Facebook', href: 'https://www.facebook.com/ZiaFlowAZ/' },
    { text: 'Google', ariaLabel: 'Google', href: 'https://share.google/BE2Y4QPhcqrfZdnvi' },
    { text: 'Yelp', ariaLabel: 'Yelp', href: 'https://www.yelp.com/biz/ziaflow-phoenix' },
    { text: 'RSS', ariaLabel: 'RSS', href: '/rss.xml' },
  ],
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap grid">
    <section class="brand" aria-label="ZiaFlow contact">
      <a class="wordmark" href={getHomePermalink()}>
        Zia<span>Flow</span>
      </a>
      <p>Websites, software, and automation.<br />Built to work together.</p>
      <address>
        <span>Phoenix, Arizona</span>
        <a href="tel:+16028344239">(602) 834-4239</a>
        <a href="mailto:jeremy@ziaflow.com">jeremy@ziaflow.com</a>
      </address>
      <a class="cta" href={getPermalink('/contact')}>
        <span>Let’s build what’s next</span>
        <span aria-hidden="true">↗</span>
      </a>
    </section>

    {
      links &&
        links.map((group) => (
          <nav aria-label={group.title}>
            <h2>{group.title}</h2>
            <ul>
              {group.links &&
                group.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.text || link.label}</a>
                  </li>
                ))}
            </ul>
          </nav>
        ))
    }

    {
      socialLinks && socialLinks.length > 0 && (
        <nav aria-label="Connect">
          <h2>Connect</h2>
          <ul>
            {socialLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  target={item.href?.startsWith('http') ? '_blank' : undefined}
                  rel={item.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                  aria-label={item.ariaLabel || item.text}
                >
                  {item.text || item.ariaLabel}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>

  <div class="wrap tagline">
    <span>ARIZONA ROOTS. CONNECTED POSSIBILITIES.</span>
    <span>Custom software · AI automation · Digital growth</span>
  </div>

  <div class="scene">
    <svg viewBox="0 0 1600 420" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <linearGradient id="zf-footer-sky" x2="0" y2="1">
          <stop stop-color="#1a1a1a"></stop>
          <stop offset="1" stop-color="#7c1e29"></stop>
        </linearGradient>
        <linearGradient id="zf-footer-sun" x2="0" y2="1">
          <stop stop-color="#fff0e6"></stop>
          <stop offset="1" stop-color="#a22a36"></stop>
        </linearGradient>
        <pattern id="zf-footer-grain" width="19" height="23" patternUnits="userSpaceOnUse">
          <circle cx="3" cy="5" r=".7" fill="white" opacity=".16"></circle>
          <circle cx="14" cy="17" r=".8" fill="black" opacity=".16"></circle>
        </pattern>
      </defs>
      <path fill="url(#zf-footer-sky)" d="M0 0h1600v420H0z"></path>
      <circle cx="1040" cy="174" r="120" fill="url(#zf-footer-sun)"></circle>
      <path
        fill="#7c1e29"
        d="M0 267 150 208 250 244 460 70 625 218 760 169 910 261 1120 181 1270 235 1430 140 1600 217V420H0Z"></path>
      <path fill="#a22a36" d="M0 300Q210 213 430 292T880 283T1300 268T1600 250V420H0Z"></path>
      <path fill="#1a1a1a" d="M0 360Q210 283 430 350T900 330T1330 345T1600 310V420H0Z"></path>
      <g fill="none" stroke="#3f9b93" stroke-width="19" stroke-linecap="round" stroke-linejoin="round">
        <path d="M190 347V197M190 272H157V228M190 295H224V246"></path>
        <path d="M1380 341V208M1380 274H1351V238M1380 291H1411V248"></path>
        <path d="M532 353V280M532 319H513V296" stroke-width="10"></path>
        <path d="M1200 331V281M1200 309H1216V290" stroke-width="8"></path>
      </g>
      <path
        fill="url(#zf-footer-grain)"
        d="M0 267 150 208 250 244 460 70 625 218 760 169 910 261 1120 181 1270 235 1430 140 1600 217V420H0Z"></path>
    </svg>
  </div>

  <div class="wrap legal">
    <span>© {currentYear} ZiaFlow. All rights reserved.</span>
    <nav aria-label="Legal">
      {secondaryLinks.map((link) => <a href={link.href}>{link.text || link.label}</a>)}
    </nav>
    <span>Built in Arizona. Engineered for what’s next.</span>
  </div>
</footer>

<style>
  .footer {
    background: #1a1a1a;
    color: #fff;
    font-family: inherit;
    position: relative;
    z-index: 10;
  }
  .wrap {
    max-width: 1360px;
    margin: auto;
    padding-inline: clamp(24px, 5vw, 80px);
  }
  .grid {
    padding-top: 76px;
    display: grid;
    grid-template-columns: 1.6fr repeat(auto-fit, minmax(150px, 1fr));
    gap: 48px;
  }
  .wordmark {
    font-size: 36px;
    font-weight: 750;
    letter-spacing: -1.5px;
    text-decoration: none;
    color: #fff;
    display: inline-block;
  }
  .wordmark span {
    color: #3f9b93;
  }
  .brand p {
    font-size: 15px;
    line-height: 1.8;
    color: #cfcfcf;
    margin: 20px 0;
  }
  .footer a {
    color: inherit;
    text-underline-offset: 5px;
  }
  .footer a:focus-visible {
    outline: 2px solid white;
    outline-offset: 5px;
  }
  address {
    display: grid;
    gap: 12px;
    font-size: 14px;
    font-style: normal;
  }
  address a {
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 25px;
    padding: 15px 24px;
    border-radius: 99px;
    background: #a22a36;
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }
  .cta:hover {
    background: #7c1e29;
    transform: translateY(-1px);
  }
  nav h2 {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #fff;
    margin: 8px 0 23px;
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 15px;
  }
  nav a {
    font-size: 14px;
    color: #ccc;
    text-decoration: none;
    line-height: 1.5;
    transition: color 0.15s ease;
  }
  nav a:hover,
  address a:hover {
    text-decoration: underline;
    color: white;
  }
  .tagline {
    padding-top: 55px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: #aaa;
  }
  .scene {
    overflow: hidden;
    margin-top: 14px;
    position: relative;
  }
  .scene svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .legal {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    padding-block: 24px;
    border-top: 1px solid #3b3b3b;
    color: #bbb;
    font-size: 12px;
  }
  .legal nav {
    display: flex;
    gap: 24px;
  }
  .legal a {
    font-size: 12px;
    color: #bbb;
    text-decoration: none;
  }
  .legal a:hover {
    color: #fff;
    text-decoration: underline;
  }

  @media (min-width: 1500px) {
    .scene {
      max-height: 410px;
    }
    .scene svg {
      margin-top: -20px;
    }
  }
  @media (max-width: 950px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 35px;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-top: 45px;
      gap: 35px 25px;
    }
    .tagline {
      flex-direction: column;
      padding-top: 40px;
      gap: 10px;
    }
    .scene svg {
      width: 185%;
      max-width: none;
      margin-left: -43%;
    }
    .legal {
      flex-direction: column;
      align-items: flex-start;
    }
    nav a {
      overflow-wrap: anywhere;
    }
  }
</style>
