---
import FormContainer from '~/components/ui/Form.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Contact as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  inputs,
  textarea,
  disclaimer,
  button,
  description,
  accessKey = import.meta.env.WEB3FORMS_ACCESS_KEY,
  redirect,
  subject = 'New Contact Request',
  fromName = 'ZiaFlow Website',

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props as Props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />

  {
    inputs && (
      <div class="flex flex-col w-full h-full max-w-3xl mx-auto rounded-2xl border border-neutral-200/80 bg-white shadow-xl overflow-hidden dark:bg-[#1A1A1A] dark:border-neutral-800">
        <!-- Brand Logo Band matching Customer.io Email Alert -->
        <div class="bg-[#A22A36] px-6 py-4 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-white text-lg font-bold tracking-[0.05em]">ZiaFlow</span>
          </div>
          <span class="text-xs uppercase tracking-[0.15em] font-semibold text-white/80">Direct Intake</span>
        </div>

        <div class="p-6 sm:p-10">
          <FormContainer
            inputs={inputs}
            textarea={textarea}
            disclaimer={disclaimer}
            button={button}
            description={description}
            accessKey={accessKey}
            redirect={redirect}
            subject={subject}
            fromName={fromName}
          />
        </div>
      </div>
    )
  }
</WidgetWrapper>
