---
// src/components/HeroQuickForm.astro
---

<div class="mt-8 mx-auto max-w-2xl bg-white/95 dark:bg-slate-900/95 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xl p-5 sm:p-6 backdrop-blur">
  <div class="mb-4 text-center">
    <span class="inline-block px-3 py-1 bg-blue-50 dark:bg-blue-950/50 text-primary text-xs font-bold rounded-full uppercase tracking-wider mb-1">
      ⚡ Fast Project Scoping
    </span>
    <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
      Discuss Your Project with ZiaFlow
    </h3>
    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
      Tell us your goal. We’ll review your systems and reply with a practical next step.
    </p>
  </div>

  <form id="hero-quick-form" class="space-y-3 text-left">
    <input type="hidden" name="form_type" value="hero_quick" />
    <input type="hidden" name="page_submitted_from" value="/" />
    <input type="hidden" name="utm_source" id="hero-utm-source" value="" />
    <input type="hidden" name="utm_medium" id="hero-utm-medium" value="" />
    <input type="hidden" name="utm_campaign" id="hero-utm-campaign" value="" />
    <input type="hidden" name="referrer" id="hero-referrer" value="" />

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div>
        <label for="hero-name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Your Name *</label>
        <input
          type="text"
          id="hero-name"
          name="name"
          required
          placeholder="First & Last"
          class="w-full text-sm rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-slate-900 shadow-sm focus:border-primary focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-800 dark:text-white"
        />
      </div>

      <div>
        <label for="hero-email" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Business Email *</label>
        <input
          type="email"
          id="hero-email"
          name="email"
          required
          placeholder="you@company.com"
          class="w-full text-sm rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-slate-900 shadow-sm focus:border-primary focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-800 dark:text-white"
        />
      </div>

      <div>
        <label for="hero-service" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Service Needed *</label>
        <select
          id="hero-service"
          name="service_needed"
          required
          class="w-full text-sm rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-slate-900 shadow-sm focus:border-primary focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-800 dark:text-white"
        >
          <option value="" disabled selected>Select priority...</option>
          <option value="Website & Conversion Engineering">Website & Conversion Engineering</option>
          <option value="Lead Intake & CRM Automation">Lead Intake & CRM Automation</option>
          <option value="Search Visibility & AI Citations">Search Visibility & AI Citations</option>
          <option value="Custom Internal Software">Custom Internal Software</option>
          <option value="General Consultation">General Consultation</option>
        </select>
      </div>
    </div>

    <div class="pt-2">
      <button
        type="submit"
        id="hero-submit-btn"
        class="w-full py-3 px-6 rounded-xl font-bold text-white bg-primary hover:bg-blue-700 transition shadow-md flex items-center justify-center gap-2 text-sm sm:text-base cursor-pointer"
      >
        <span>Request Project Scoping</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </button>
    </div>

    <div id="hero-status-message" class="hidden rounded-xl border p-2.5 text-center text-xs font-medium"></div>

    <p class="text-[11px] text-center text-slate-500 dark:text-slate-400">
      🔒 No spam. Fast 24h founder response. Confidential diagnostic.
    </p>
  </form>
</div>

<script>
  function initHeroForm() {
    const form = document.getElementById('hero-quick-form') as HTMLFormElement | null;
    if (!form || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    // Capture URL UTMs & Referrer dynamically
    const params = new URLSearchParams(window.location.search);
    const setField = (id: string, val: string) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el) el.value = val;
    };
    setField('hero-utm-source', params.get('utm_source') || '');
    setField('hero-utm-medium', params.get('utm_medium') || '');
    setField('hero-utm-campaign', params.get('utm_campaign') || '');
    setField('hero-referrer', document.referrer || '');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('hero-submit-btn') as HTMLButtonElement;
      const statusEl = document.getElementById('hero-status-message') as HTMLDivElement;

      btn.disabled = true;
      const originalText = btn.innerHTML;
      btn.textContent = 'Sending...';
      statusEl.className = 'hidden';

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await res.json();

        if (res.ok && result.ok) {
          statusEl.textContent = '✅ Inbound request received! We will follow up shortly.';
          statusEl.className = 'block rounded-xl border border-green-300 bg-green-50 p-2.5 text-center text-xs font-semibold text-green-800 dark:border-green-800 dark:bg-green-950 dark:text-green-300';
          form.reset();
        } else {
          throw new Error(result.error || 'Submission failed');
        }
      } catch (err) {
        statusEl.textContent = '⚠️ Request error. Please email info@ziaflow.com directly.';
        statusEl.className = 'block rounded-xl border border-red-300 bg-red-50 p-2.5 text-center text-xs font-semibold text-red-800 dark:border-red-800 dark:bg-red-950 dark:text-red-300';
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    });
  }

  document.addEventListener('astro:page-load', initHeroForm);
  initHeroForm();
</script>
