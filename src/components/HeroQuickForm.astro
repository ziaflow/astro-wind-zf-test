---
import InquiryForm from '~/components/forms/InquiryForm.astro';
---

<div
  class="mx-auto mt-6 max-w-2xl rounded-2xl border border-slate-200 bg-white p-5 text-left shadow-lg sm:p-6 dark:border-slate-700 dark:bg-slate-900"
>
  <h2 class="mb-2 text-xl font-bold text-slate-900 dark:text-white">What would you like to improve?</h2>
  <p class="mb-5 text-sm text-slate-600 dark:text-slate-300">
    Share your goal. We'll follow up to discuss the fit, scope, and next step.
  </p>
  <InquiryForm id="hero-quick-form" formType="hero_quick" compact />
</div>
