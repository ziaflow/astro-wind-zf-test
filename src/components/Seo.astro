---
/**
 * Global SEO structured data component.
 *
 * Renders only Organization and WebSite JSON-LD — these are appropriate
 * for every page. Page-specific schemas (Service, FAQPage, BlogPosting,
 * LocalBusiness) should be added by individual page templates.
 *
 * OG and Twitter meta tags are handled by Metadata.astro — they are NOT
 * duplicated here.
 */
const { siteUrl, description: defaultDescription, logo, social = {} } = Astro.props.site || {};

const sameAs = [social.linkedin, social.facebook, social.instagram].filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'ZiaFlow',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: logo,
      },
      sameAs: sameAs,
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+1-480-819-2929',
        email: 'info@ziaflow.com',
        contactType: 'customer service',
        areaServed: 'US',
        availableLanguage: 'English',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'ZiaFlow',
      description: defaultDescription,
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
    },
  ],
};

let jsonLdString = JSON.stringify(jsonLd);
jsonLdString = jsonLdString.replace(/<\/script>/gi, '<\\/script>');
---

<script is:inline type="application/ld+json" set:html={jsonLdString} />
