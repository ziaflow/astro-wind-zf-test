---
import Button from '~/components/ui/Button.astro';
import type { Form as Props } from '~/types';

const {
  inputs = [],
  textarea,
  disclaimer,
  button = 'Contact us',
  description = '',
  action = '/api/contact',
  method = 'POST',
  formId,
  resultId,
  successMessage = 'Thanks! We received your message.',
} = Astro.props as Props;

const idSuffix =
  typeof crypto !== 'undefined' && 'randomUUID' in crypto
    ? crypto.randomUUID()
    : Math.random().toString(36).slice(2, 10);
const resolvedFormId = formId || `web3forms-form-${idSuffix}`;
const resolvedResultId = resultId || `${resolvedFormId}-result`;
---

<form
  data-lead-form
  data-success-message={successMessage}
  action={action}
  method={method}
  id={resolvedFormId}
  class="space-y-6"
>
  <input type="hidden" name="page" value={Astro.url.pathname} />
  {/* Anti-spam honeypot field: invisible to humans, traps automated spam bots */}
  <div
    class="opacity-0 absolute -z-10 select-none pointer-events-none"
    style="position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden;"
    aria-hidden="true"
    tabindex="-1"
  >
    <label for="website_url">Leave this field blank</label>
    <input type="text" id="website_url" name="website_url" value="" autocomplete="off" tabindex="-1" />
  </div>
  <input type="checkbox" name="botcheck" class="hidden" aria-hidden="true" tabindex="-1" />

  {
    inputs &&
      inputs.map(
        ({ type = 'text', name, label = '', autocomplete = 'on', placeholder = '', required = false }) =>
          name && (
            <div class="mb-6">
              {label && (
                <label for={name} class="block text-sm font-medium">
                  {label}
                </label>
              )}
              <input
                type={type}
                name={name}
                id={name}
                autocomplete={autocomplete}
                placeholder={placeholder}
                required={required}
                class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
              />
            </div>
          )
      )
  }

  {
    textarea && (
      <div>
        <label for="textarea" class="block text-sm font-medium">
          {textarea.label}
        </label>
        <textarea
          id="textarea"
          name={textarea.name ? textarea.name : 'message'}
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
        />
      </div>
    )
  }

  {
    disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
          <input
            id="disclaimer"
            name="disclaimer"
            type="checkbox"
            class="cursor-pointer mt-1 py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
          />
        </div>
        <div class="ml-3">
          <label for="disclaimer" class="cursor-pointer select-none text-sm text-gray-600 dark:text-gray-400">
            {disclaimer.label}
          </label>
        </div>
      </div>
    )
  }

  {
    button && (
      <div class="mt-10 grid">
        <Button variant="primary" type="submit">
          {button}
        </Button>
      </div>
    )
  }

  {
    description && (
      <div class="mt-3 text-center">
        <p class="text-sm text-gray-600 dark:text-gray-400">{description}</p>
      </div>
    )
  }

  <p
    data-form-status
    role="status"
    aria-live="polite"
    id={resolvedResultId}
    class="text-base text-center text-gray-500"
  >
  </p>
</form>

<script>
  import { bindLeadForms } from '~/utils/lead-form';
  bindLeadForms();
</script>
