---
// src/components/ui/StickyMobileContactBar.astro
// Provides mobile visitors with direct contact options
---

<div
  class="fixed bottom-0 inset-x-0 z-40 block sm:hidden bg-white/95 dark:bg-slate-900/95 border-t border-slate-200 dark:border-slate-800 p-3 backdrop-blur shadow-2xl"
>
  <div class="grid grid-cols-2 gap-2 max-w-md mx-auto">
    <a
      href="tel:+14808192929"
      class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-bold text-slate-800 dark:text-slate-100 shadow-sm active:scale-95 transition"
    >
      <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
        ></path>
      </svg>
      <span>Call (480) 819-2929</span>
    </a>

    <a
      href="/contact"
      class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl bg-primary text-xs font-bold text-white shadow-sm active:scale-95 transition"
    >
      <span>Request a consultation</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </a>
  </div>
</div>
