---
// src/components/blog/ArticleLeadCta.astro
// In-article conversion card to stop 85-100% bounce on organic blog visits
interface Props {
  topic?: string;
}

const { topic = 'Website & Automation Engineering' } = Astro.props;
---

<div class="my-10 rounded-2xl border-2 border-primary/30 bg-gradient-to-br from-blue-50 to-indigo-50/50 p-6 sm:p-8 dark:border-primary/40 dark:from-slate-900 dark:to-slate-800/80 shadow-md not-prose">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
    <div class="max-w-xl">
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-block p-1.5 rounded-lg bg-primary/10 text-primary">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </span>
        <span class="text-xs font-bold tracking-wider uppercase text-primary">Need This Implemented?</span>
      </div>
      <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-2">
        Put this {topic} strategy to work for your business.
      </h3>
      <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
        ZiaFlow designs custom websites, connects CRMs, and automates client intake for growing Arizona companies. Discuss your setup in a quick 15-minute diagnostic.
      </p>
    </div>

    <div class="w-full sm:w-auto shrink-0 flex flex-col gap-2">
      <a
        href="/contact"
        class="inline-flex items-center justify-center rounded-xl bg-primary px-6 py-3.5 text-sm font-bold text-white shadow-md transition hover:bg-blue-700 text-center"
      >
        <span>Request Scoping Call</span>
        <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
      <a
        href="tel:+14808192929"
        class="text-xs text-center font-medium text-slate-500 hover:text-primary transition"
      >
        Or call: (480) 819-2929
      </a>
    </div>
  </div>
</div>
