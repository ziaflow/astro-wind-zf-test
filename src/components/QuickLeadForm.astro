---
// src/components/QuickLeadForm.astro
---

<form id="quick-lead-form" class="space-y-4">
  <input type="hidden" name="form_type" value="quick" />
  <input type="hidden" name="page_submitted_from" value={Astro.url.pathname} />
  <input type="hidden" name="utm_source" id="ql-utm-source" value="" />
  <input type="hidden" name="utm_medium" id="ql-utm-medium" value="" />
  <input type="hidden" name="utm_campaign" id="ql-utm-campaign" value="" />
  <input type="hidden" name="utm_term" id="ql-utm-term" value="" />
  <input type="hidden" name="utm_content" id="ql-utm-content" value="" />
  <input type="hidden" name="referrer" id="ql-referrer" value="" />

  <div>
    <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Name *</label>
    <input
      type="text"
      name="name"
      required
      placeholder="Your full name"
      class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
    />
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Email *</label>
      <input
        type="email"
        name="email"
        required
        placeholder="you@company.com"
        class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
      />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Phone</label>
      <input
        type="tel"
        name="phone"
        placeholder="(555) 000-0000"
        class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
      />
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Company Name</label>
    <input
      type="text"
      name="company_name"
      placeholder="Your company / organization"
      class="mt-1 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
    />
  </div>

  <div>
    <label class="block text-sm font-medium text-slate-800 dark:text-slate-200">Comments / Project Notes</label>
    <textarea
      name="comments"
      rows="3"
      placeholder="Tell us briefly about your goals or challenges..."
      class="mt-1 block w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:placeholder:text-slate-500"
    ></textarea>
  </div>

  <button
    type="submit"
    id="quick-submit-btn"
    class="w-full rounded-xl bg-[#3F9B93] py-3.5 px-4 font-bold text-black shadow-md transition hover:bg-[#4cd1c7] focus:outline-none focus:ring-2 focus:ring-[#3F9B93] disabled:cursor-wait disabled:opacity-70"
  >
    Submit Inquiry
  </button>
  <p id="quick-status" class="hidden rounded-xl border p-3 text-center text-sm font-medium"></p>
</form>

<script>
  function initQuickLeadForm() {
    const form = document.getElementById('quick-lead-form') as HTMLFormElement;
    const statusEl = document.getElementById('quick-status') as HTMLElement;
    const btn = document.getElementById('quick-submit-btn') as HTMLButtonElement;

    if (!form || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    // Populate UTMs & Referrer dynamically
    const params = new URLSearchParams(window.location.search);
    const setField = (id: string, val: string) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el) el.value = val;
    };
    setField('ql-utm-source', params.get('utm_source') || '');
    setField('ql-utm-medium', params.get('utm_medium') || '');
    setField('ql-utm-campaign', params.get('utm_campaign') || '');
    setField('ql-utm-term', params.get('utm_term') || '');
    setField('ql-utm-content', params.get('utm_content') || '');
    setField('ql-referrer', document.referrer || '');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (btn.disabled) return;
      btn.disabled = true;
      const originalText = btn.textContent;
      btn.textContent = 'Sending...';
      statusEl.classList.add('hidden');
      statusEl.className = 'hidden rounded-xl border p-3 text-center text-sm font-medium';

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await res.json();
        if (res.ok && result.ok) {
          // Fire GTM, GA4, and Customer.io Events
          import('~/utils/analytics').then(
            ({ trackFormSubmission, trackEmailSent, identifyCustomerIo, trackCustomerIoEvent }) => {
              trackFormSubmission({
                form_id: 'quick-lead-form',
                form_name: 'quick_lead',
                service_needed: (data.service_needed as string) || 'Quick Form',
              });
              trackEmailSent({
                email_type: 'lead_notification',
                status: 'sent',
                form_name: 'quick_lead',
              });

              // Customer.io: 1. Identify person by email
              const rawName = ((data.name as string) || '').trim();
              const nameParts = rawName.split(/\s+/);
              const firstName = nameParts[0] || '';
              const lastName = nameParts.slice(1).join(' ') || '';
              const userEmail = ((data.email as string) || '').trim();

              identifyCustomerIo({
                email: userEmail,
                first_name: firstName,
                last_name: lastName,
                phone: (data.phone as string) || '',
                service_interest: (data.service_needed as string) || 'General Inquiry',
                intake_source: 'contact_form',
              });

              // Customer.io: 2. Track contact_form_submitted event with message and page URL
              trackCustomerIoEvent('contact_form_submitted', {
                message: (data.comments as string) || '',
                company_name: (data.company_name as string) || '',
                form_id: 'quick-lead-form',
                intake_source: 'contact_form',
              });
            }
          );

          statusEl.textContent = 'Success! We have received your inquiry and will reply shortly.';
          statusEl.className =
            'block rounded-xl border border-green-300 bg-green-50 p-3 text-center text-sm font-medium text-green-800 dark:border-green-800 dark:bg-green-950 dark:text-green-300';
          form.reset();
        } else {
          throw new Error(result.error || 'Server rejected submission');
        }
      } catch {
        statusEl.textContent = 'Submission failed. Please email info@ziaflow.com directly.';
        statusEl.className =
          'block rounded-xl border border-red-300 bg-red-50 p-3 text-center text-sm font-medium text-red-800 dark:border-red-800 dark:bg-red-950 dark:text-red-300';
      } finally {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    });
  }

  document.addEventListener('astro:page-load', initQuickLeadForm);
  initQuickLeadForm();
</script>
