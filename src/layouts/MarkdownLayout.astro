---
import KairoLayout from '@/layouts/layout.astro';
import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
    description?: string;
    robots?: MetaData['robots'];
  };
}

const { frontmatter } = Astro.props;
---

<KairoLayout
  title={frontmatter?.title ? `${frontmatter.title} | ZiaFlow` : undefined}
  description={frontmatter?.description}
  metadata={{ robots: frontmatter?.robots }}
>
  <section class="shell pt-36 pb-24 md:pt-44 md:pb-32">
    <div class="max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-wider text-signal mb-4">ZiaFlow Legal & Policy</p>
      <h1 class="font-display text-title font-bold text-bone tracking-tight">{frontmatter.title}</h1>
      <div class="prose-kairo mt-10 text-mute leading-relaxed space-y-6">
        <slot />
      </div>
    </div>
  </section>
</KairoLayout>
