---
import { pricingPage } from '@/data/pages';
import Icon from '@/components/shared/icons/icon.astro';
import { faqs as defaultFaqs } from '@/data/pricing';
import type { Faq } from '@/interface';

interface Props {
  title?: string;
  items?: Faq[];
  id?: string;
}

const {
  title = pricingPage.faq.title,
  items = defaultFaqs,
  id = 'faq-title',
} = Astro.props;
---

<section class="shell pb-24 md:pb-36" aria-labelledby={id}>
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
    <h2 id={id} class="max-w-[12ch] font-display text-title font-bold text-bone lg:col-span-4" data-split>
      {title}
    </h2>
    <div class="lg:col-span-7 lg:col-start-6" data-accordion>
      {items.map((faq, i) => (
        <div class="border-b border-line" data-accordion-item data-reveal>
          <h3>
            <button
              type="button"
              class="group flex w-full items-center justify-between gap-6 py-6 text-left text-lg font-medium text-bone"
              aria-expanded="false"
              aria-controls={`${id}-${i}`}
              id={`${id}-button-${i}`}
              data-accordion-trigger>
              {faq.question}
              <span class="grid size-9 shrink-0 place-items-center rounded-full border border-line-strong transition-[rotate,background-color,color] duration-500 ease-(--ease-out-expo) group-aria-expanded:rotate-45 group-aria-expanded:bg-signal group-aria-expanded:text-ink">
                <Icon name="plus" />
              </span>
            </button>
          </h3>
          <div
            id={`${id}-${i}`}
            role="region"
            aria-labelledby={`${id}-button-${i}`}
            class="h-0 overflow-hidden"
            data-accordion-panel>
            <p class="max-w-[60ch] pb-6 text-mute">{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
