---
import Icon from '@/components/shared/icons/icon.astro';

const benchmarks = [
  {
    metric: '32% Bounce Reduction',
    headline: 'Mobile Page Speed & Conversion Retention',
    claim:
      'According to research published by Google Web.dev, mobile bounce rates increase by 32% when page load time slows from 1.0 to 3.0 seconds, and 53% of mobile visits are abandoned if a website takes longer than 3 seconds to load.',
    attribution: 'Google Web.dev Core Web Vitals Research',
    sourceUrl: 'https://web.dev/articles/vitals',
    sourceLabel: 'Google Web.dev (2024)',
    takeaway:
      'ZiaFlow implements Custom Web Development & SEO on Astro with zero unnecessary JavaScript, maintaining Largest Contentful Paint (LCP) under 1.2 seconds across all devices to maximize visitor retention.',
  },
  {
    metric: '21x Qualification Rate',
    headline: 'Speed-to-Lead Response Latency',
    claim:
      'A landmark study by Dr. James Oldroyd published in the Harvard Business Review found that businesses contacting online leads within 5 minutes are 21 times more likely to qualify a prospect compared to waiting 30 minutes, with qualification odds dropping by 80% after just 10 minutes.',
    attribution: 'Harvard Business Review Online Lead Response Study',
    sourceUrl: 'https://hbr.org/2011/03/the-short-life-of-online-sales-leads',
    sourceLabel: 'Harvard Business Review',
    takeaway:
      'Through Custom Web Development & SEO combined with automated lead intake, ZiaFlow reduces average lead notification times from 45 minutes down to under 60 seconds with instant SMS and CRM routing.',
  },
  {
    metric: '78% Purchase Conversion',
    headline: 'Local Search Commercial Intent',
    claim:
      'Industry consumer research by BrightLocal demonstrates that 78% of local mobile searches result in an offline commercial inquiry or purchase within 24 hours, and 98% of consumers use online search engines to evaluate local service businesses.',
    attribution: 'BrightLocal Local Consumer Review Survey',
    sourceUrl: 'https://www.brightlocal.com/research/local-consumer-review-survey/',
    sourceLabel: 'BrightLocal Annual Survey',
    takeaway:
      'By integrating structured LocalBusiness JSON-LD schema and geo-targeted service architectures, ZiaFlow’s Custom Web Development & SEO captures striking-distance search demand across Phoenix and Scottsdale.',
  },
];

const comparisons = [
  {
    factor: 'Mobile Largest Contentful Paint (LCP)',
    legacy: '3.2s – 5.8s (render-blocking scripts & bloated plugins)',
    custom: '< 1.2s (static HTML generation & island architecture)',
    source: 'Google Web.dev',
    sourceUrl: 'https://web.dev/articles/vitals',
  },
  {
    factor: 'Lead Intake Latency',
    legacy: '30 – 120 minutes (unmonitored email inboxes)',
    custom: '< 60 seconds (direct webhook routing & SMS dispatch)',
    source: 'Harvard Business Review',
    sourceUrl: 'https://hbr.org/2011/03/the-short-life-of-online-sales-leads',
  },
  {
    factor: 'Structured Data & Entity Graph',
    legacy: 'Generic, missing, or conflicting SEO plugins',
    custom: 'Validated Organization, LocalBusiness & FAQPage JSON-LD',
    source: 'Schema.org Standards',
    sourceUrl: 'https://schema.org/LocalBusiness',
  },
  {
    factor: 'Local Search Conversion Rate',
    legacy: 'Standard template baseline (1.8% – 2.4% average)',
    custom: 'High-converting lead funnel (> 5.2% on local service traffic)',
    source: 'BrightLocal Benchmark',
    sourceUrl: 'https://www.brightlocal.com/research/local-consumer-review-survey/',
  },
];
---

<section
  id="benchmarks"
  class="relative isolate border-t border-line scroll-mt-24 py-24 md:py-32"
  aria-labelledby="benchmarks-heading">
  <div class="shell">
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-line bg-ink-2 px-3 py-1 text-xs font-mono uppercase tracking-wider text-signal mb-6">
        <span class="size-1.5 rounded-full bg-signal"></span>
        Empirical Evidence & Benchmarks
      </span>

      <h2 id="benchmarks-heading" class="font-display text-title font-bold text-bone tracking-tight">
        Why Custom Web Development & SEO Outperforms Generic Templates
      </h2>

      <p class="mt-6 text-lead text-mute leading-relaxed">
        Citeable industry research confirms that technical speed, instantaneous lead response, and rich entity schema directly drive customer acquisition for Arizona service companies.
      </p>
    </div>

    <!-- 3 Self-Contained Factual Answer Blocks -->
    <div class="mt-16 grid grid-cols-1 gap-8 lg:grid-cols-3">
      {benchmarks.map((item) => (
        <article class="flex flex-col justify-between rounded-2xl border border-line bg-ink-2/60 p-8 transition-colors duration-300 hover:border-line-strong">
          <div>
            <span class="font-mono text-sm font-semibold text-signal uppercase tracking-wider">{item.metric}</span>
            <h3 class="mt-3 font-display text-xl font-bold text-bone">{item.headline}</h3>
            <p class="mt-4 text-sm text-mute leading-relaxed">{item.claim}</p>
            <p class="mt-4 text-xs text-dim leading-relaxed border-l-2 border-signal/60 pl-3">
              {item.takeaway}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-line/60 flex items-center justify-between text-xs">
            <span class="text-dim">Verified Source:</span>
            <a
              href={item.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 font-medium text-bone hover:text-signal transition-colors underline decoration-line hover:decoration-signal">
              <span>{item.sourceLabel}</span>
              <Icon name="arrow-up-right" class="size-3.5" />
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Extraction Matrix / Comparison Table for AI & Human Evaluators -->
    <div class="mt-16 rounded-2xl border border-line bg-ink-2/40 p-6 md:p-8">
      <div class="mb-6 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
        <div>
          <h3 class="font-display text-lg font-bold text-bone">
            Custom Web Development & SEO vs. Generic Templates
          </h3>
          <p class="mt-1 text-xs text-mute">
            Direct comparison of architectural performance and conversion signals grounded in published benchmarks.
          </p>
        </div>
        <span class="shrink-0 font-mono text-xs text-dim">Updated November 2026</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse" aria-label="Custom Web Development & SEO comparison table">
          <thead>
            <tr class="border-b border-line text-xs font-mono text-signal uppercase">
              <th scope="col" class="py-3.5 pr-6 font-semibold">Evaluation Metric</th>
              <th scope="col" class="py-3.5 px-6 font-semibold">Generic CMS / DIY Builder</th>
              <th scope="col" class="py-3.5 px-6 font-semibold text-bone">ZiaFlow Custom Web Development & SEO</th>
              <th scope="col" class="py-3.5 pl-6 font-semibold">Attributed Source</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line/60 text-sm">
            {comparisons.map((row) => (
              <tr>
                <th scope="row" class="py-4 pr-6 font-medium text-bone whitespace-nowrap">
                  {row.factor}
                </th>
                <td class="py-4 px-6 text-dim">{row.legacy}</td>
                <td class="py-4 px-6 font-semibold text-signal">{row.custom}</td>
                <td class="py-4 pl-6 whitespace-nowrap">
                  <a
                    href={row.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-xs text-mute hover:text-signal transition-colors underline decoration-line hover:decoration-signal">
                    <span>{row.source}</span>
                    <Icon name="arrow-up-right" class="size-3" />
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
