---
import Icon from '@/components/shared/icons/icon.astro';

export interface Props {
  title?: string;
  subtitle?: string;
  defaultService?: string;
  id?: string;
  class?: string;
}

const {
  title = 'Turn more inquiries into booked work.',
  subtitle = 'Share your business details for rapid engineering follow-up on your website, lead intake, or automation.',
  defaultService = 'Lead Capture & Follow-Up Sprint',
  id = 'short-lead',
  class: className = '',
} = Astro.props;

const services = [
  'Lead Capture & Follow-Up Sprint',
  'Marketing Automation & AI Workflows',
  'Custom Website & CRO Engineering',
  'Local Phoenix SEO & GBP Optimization',
  'Google Local Service Ads (LSA) & PPC',
  'Custom Software / Full-Stack App',
];

const inputClass =
  'h-12 w-full rounded-xl border border-line-strong bg-ink-2 px-4 text-sm text-bone placeholder:text-dim transition-colors duration-200 focus:border-bone focus:outline-none aria-invalid:border-signal';
---

<div
  id={id}
  data-lead-form-card
  class:list={[
    'scroll-mt-24 relative rounded-3xl border border-line-strong bg-ink-2/90 p-6 sm:p-10 shadow-[0_20px_60px_-20px_rgb(0_0_0/0.8)] transition-shadow duration-300',
    className,
  ]}
>
  <div class="mb-8">
    <span class="inline-flex items-center gap-2 rounded-full border border-line bg-ink px-3 py-1 text-xs font-mono uppercase tracking-wider text-signal mb-4">
      <span class="size-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      Rapid Scoping Intake
    </span>
    <h3 class="font-display text-2xl font-bold text-bone sm:text-3xl leading-tight">
      {title}
    </h3>
    <p class="mt-3 text-sm text-mute leading-relaxed max-w-[54ch]">
      {subtitle}
    </p>
  </div>

  <form data-short-lead-form novalidate class="space-y-5">
    {/* Anti-spam honeypot */}
    <div
      class="opacity-0 absolute -z-10 select-none pointer-events-none"
      style="position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden;"
      aria-hidden="true"
      tabindex="-1"
    >
      <label for={`${id}-website-url`}>Leave this field blank</label>
      <input type="text" id={`${id}-website-url`} name="website_url" value="" autocomplete="off" tabindex="-1" />
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <label for={`${id}-name`} class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">
          Your Name *
        </label>
        <input
          id={`${id}-name`}
          name="name"
          type="text"
          required
          autocomplete="name"
          placeholder="First and last name"
          class={inputClass}
          aria-describedby={`${id}-name-error`}
        />
        <p id={`${id}-name-error`} class="mt-1 min-h-4 text-xs text-signal" data-error-for="name"></p>
      </div>

      <div>
        <label for={`${id}-company`} class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">
          Company Name *
        </label>
        <input
          id={`${id}-company`}
          name="company"
          type="text"
          required
          autocomplete="organization"
          placeholder="Your company / organization"
          class={inputClass}
          aria-describedby={`${id}-company-error`}
        />
        <p id={`${id}-company-error`} class="mt-1 min-h-4 text-xs text-signal" data-error-for="company"></p>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <label for={`${id}-email`} class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">
          Work Email *
        </label>
        <input
          id={`${id}-email`}
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@company.com"
          class={inputClass}
          aria-describedby={`${id}-email-error`}
        />
        <p id={`${id}-email-error`} class="mt-1 min-h-4 text-xs text-signal" data-error-for="email"></p>
      </div>

      <div>
        <label for={`${id}-service`} class="block text-xs font-mono uppercase tracking-wider text-mute mb-2">
          Primary Service Interest *
        </label>
        <div class="relative">
          <select
            id={`${id}-service`}
            name="service_interest"
            required
            class={`${inputClass} appearance-none pr-10 bg-ink-2`}
            aria-describedby={`${id}-service-error`}
          >
            {services.map((srv) => (
              <option value={srv} selected={srv === defaultService}>{srv}</option>
            ))}
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-mute">
            <Icon name="arrow-right" class="size-4 rotate-90" />
          </div>
        </div>
        <p id={`${id}-service-error`} class="mt-1 min-h-4 text-xs text-signal" data-error-for="service_interest"></p>
      </div>
    </div>

    <div class="pt-2">
      <button
        type="submit"
        data-short-submit
        class="inline-flex h-13 w-full items-center justify-center gap-3 rounded-full bg-signal px-8 font-semibold text-bone hover:bg-signal-dark focus:outline-none focus:ring-2 focus:ring-signal transition-all duration-300 disabled:opacity-60 disabled:cursor-wait cursor-pointer"
      >
        <span>Request Engineering Review</span>
        <Icon name="arrow-right" class="size-4" />
      </button>
      <p role="status" aria-live="polite" data-short-status class="mt-3 min-h-5 text-sm text-center"></p>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6 text-xs text-mute">
      <div class="flex items-center gap-3 font-mono">
        <span>Prefer direct phone?</span>
        <a
          href="tel:+16028344239"
          class="inline-flex items-center gap-1.5 font-bold text-bone hover:text-signal transition-colors"
        >
          <span class="size-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          (602) 834-4239
        </a>
      </div>
      <a
        href="/booking"
        data-cta="book-scoping-call"
        class="inline-flex items-center gap-1 font-semibold text-bone hover:text-signal transition-colors underline underline-offset-4"
      >
        <span>Book calendar session directly</span>
        <Icon name="arrow-up-right" class="size-3.5" />
      </a>
    </div>
  </form>
</div>
