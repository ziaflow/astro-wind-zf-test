---
import Layout from '@/layouts/layout.astro';
import PageHero from '@/components/shared/page-hero.astro';
import Icon from '@/components/shared/icons/icon.astro';
import Button from '@/components/shared/ui/button.astro';
import RoiCalculator from '@/components/home/roi-calculator.astro';
import AuditSection from '@/components/home/audit-section.astro';
import SalesForm from '@/components/pricing/sales-form.astro';
import Cta from '@/components/shared/cta.astro';
import ServiceSchema from '~/components/seo/ServiceSchema.astro';
import { site } from '@/data/site';

export interface Deliverable {
  title: string;
  description: string;
  tag?: string;
}

export interface ProcessStep {
  step: string;
  title: string;
  description: string;
}

export interface ServiceFaq {
  question: string;
  answer: string;
}

export interface RelatedLink {
  label: string;
  href: string;
  category?: string;
}

interface Props {
  title: string;
  description: string;
  url: string;
  eyebrow: string;
  heroLines: [string, string];
  heroIntro: string;
  deliverablesTitle?: string;
  deliverablesIntro?: string;
  deliverables: Deliverable[];
  processTitle?: string;
  processSteps: ProcessStep[];
  faqs: ServiceFaq[];
  relatedLinks?: RelatedLink[];
  showRoiCalculator?: boolean;
}

const {
  title,
  description,
  url,
  eyebrow,
  heroLines,
  heroIntro,
  deliverablesTitle = 'Engineered deliverables & scope.',
  deliverablesIntro = 'Every engagement is built around verifiable milestones, clean architecture, and measurable business outcomes.',
  deliverables,
  processTitle = 'How we implement & verify.',
  processSteps,
  faqs,
  relatedLinks = [
    { label: 'Marketing Automation for Arizona SMBs', href: '/marketing-automation-for-arizona-service-businesses-save-time-increase-bookings', category: 'Guide' },
    { label: 'Website Conversion Checklist for Phoenix Businesses', href: '/website-conversion-checklist-for-phoenix-businesses', category: 'Checklist' },
    { label: 'View Pricing & Sprint Scopes', href: '/pricing', category: 'Pricing' },
    { label: 'Explore Arizona Case Studies', href: '/case-studies', category: 'Case Studies' },
  ],
  showRoiCalculator = true,
} = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<Layout title={title} description={description}>
  <ServiceSchema slot="head" name={title} description={description} url={url} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <PageHero lines={heroLines} intro={heroIntro} accent={1} />

  <!-- Quick Action & Defensible Promise Bar -->
  <section class="shell pb-16 md:pb-24" aria-label="Service overview bar">
    <div class="flex flex-col gap-6 rounded-2xl border border-line bg-ink-2/80 p-6 sm:p-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="space-y-2 max-w-2xl">
        <span class="inline-flex items-center gap-2 font-mono text-xs uppercase text-signal">
          <span class="size-2 rounded-full bg-signal"></span>
          {eyebrow}
        </span>
        <p class="text-sm sm:text-base text-bone font-medium leading-relaxed">
          For every agreed inquiry source, each accepted inquiry is recorded, assigned an owner, given a next action, and tracked to a known status.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <Button label={site.cta.primary.label} href={site.cta.primary.href} />
        <Button label="Request Free Audit" href="#audit" variant="outline" />
      </div>
    </div>
  </section>

  <!-- Core Deliverables Grid -->
  <section class="shell py-20 md:py-28 border-t border-line" aria-labelledby="deliverables-heading">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="font-mono text-label text-signal uppercase">Scope & Architecture</p>
        <h2 id="deliverables-heading" class="mt-4 font-display text-title font-bold text-bone">
          {deliverablesTitle}
        </h2>
        <p class="mt-4 text-mute leading-relaxed">
          {deliverablesIntro}
        </p>
      </div>
      <div class="lg:col-span-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {deliverables.map((item, idx) => (
          <article class="flex flex-col justify-between rounded-2xl border border-line bg-ink-2/60 p-6 sm:p-8 transition-colors hover:border-bone/40">
            <div>
              <div class="flex items-center justify-between gap-4 mb-4">
                <span class="font-mono text-xs text-signal">0{idx + 1}</span>
                {item.tag && (
                  <span class="rounded-full border border-line bg-ink px-2.5 py-0.5 font-mono text-[11px] uppercase text-mute">
                    {item.tag}
                  </span>
                )}
              </div>
              <h3 class="font-display text-xl font-bold text-bone">{item.title}</h3>
              <p class="mt-3 text-sm text-mute leading-relaxed">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Process -->
  <section class="shell py-20 md:py-28 border-t border-line" aria-labelledby="process-heading">
    <div class="mb-14 max-w-2xl">
      <p class="font-mono text-label text-signal uppercase">Execution Protocol</p>
      <h2 id="process-heading" class="mt-4 font-display text-title font-bold text-bone">
        {processTitle}
      </h2>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {processSteps.map((p) => (
        <div class="rounded-2xl border border-line bg-ink p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <span class="inline-block rounded-full bg-signal/15 px-3 py-1 font-mono text-xs font-bold text-signal uppercase">
              {p.step}
            </span>
            <h3 class="mt-5 font-display text-lg font-bold text-bone">{p.title}</h3>
            <p class="mt-3 text-sm text-mute leading-relaxed">{p.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  {showRoiCalculator && <RoiCalculator />}

  <!-- Service FAQs (GEO / AEO Direct Answers) -->
  <section class="shell py-20 md:py-28 border-t border-line" aria-labelledby="service-faq-heading">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="font-mono text-label text-signal uppercase">Direct Answers</p>
        <h2 id="service-faq-heading" class="mt-4 font-display text-title font-bold text-bone">
          Frequently asked questions.
        </h2>
        <p class="mt-4 text-sm text-mute leading-relaxed">
          Clear answers on timelines, deliverables, ownership, and technical integration in Phoenix, AZ.
        </p>
      </div>
      <div class="lg:col-span-8 divide-y divide-line border-t border-b border-line">
        {faqs.map((faq) => (
          <details class="group py-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-lg font-semibold text-bone hover:text-signal transition-colors">
              <span>{faq.question}</span>
              <span class="grid size-8 shrink-0 place-items-center rounded-full border border-line text-mute group-open:rotate-45 group-open:border-signal group-open:text-signal transition-transform">
                +
              </span>
            </summary>
            <p class="mt-4 text-sm text-mute leading-relaxed max-w-[68ch]">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Contextual Internal Links & Playbooks -->
  <section class="shell py-16 md:py-24 border-t border-line" aria-label="Related playbooks and services">
    <p class="font-mono text-xs uppercase tracking-wider text-mute mb-6">
      Connected Resources & Playbooks
    </p>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {relatedLinks.map((link) => (
        <a
          href={link.href}
          class="group flex flex-col justify-between rounded-xl border border-line bg-ink-2/50 p-5 transition-all hover:border-signal"
        >
          <div>
            {link.category && (
              <span class="font-mono text-[11px] uppercase text-signal">{link.category}</span>
            )}
            <p class="mt-2 font-display text-base font-bold text-bone group-hover:text-signal transition-colors">
              {link.label}
            </p>
          </div>
          <span class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs text-mute group-hover:text-bone">
            Explore <Icon name="arrow-up-right" class="size-3.5" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Embedded Lead Funnel & Forensic Audit -->
  <AuditSection />
  <SalesForm />
  <Cta />
</Layout>
