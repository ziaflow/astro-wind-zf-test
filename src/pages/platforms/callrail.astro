      description: 'We install lightweight swap scripts and connect CallRail webhooks to your intake database.',
    },
    {
      step: 'Step 3 · Automate',
      title: 'Missed-Call Recovery',
      description: 'We activate instant SMS follow-up when lines are busy or after hours.',
    },
    {
      step: 'Step 4 · Attribute',
      title: 'Unified Lead Reporting',
      description: 'Phone leads and web forms appear side-by-side by source page and campaign.',
    },
  ]}
  faqs={[
    {
      question: 'Will Dynamic Number Insertion (DNI) hurt our Local SEO or NAP consistency?',
      answer:
        'No. Dynamic Number Insertion only swaps the phone number for human browser sessions using JavaScript, while search engine crawlers (Googlebot) always read your canonical primary business phone number in the raw HTML and LocalBusiness schema.',
