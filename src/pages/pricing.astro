---
import Layout from '@/layouts/layout.astro';
import PageHero from '@/components/shared/page-hero.astro';
import Plans from '@/components/pricing/plans.astro';
import Compare from '@/components/pricing/compare.astro';
import RoiCalculator from '@/components/home/roi-calculator.astro';
import Faq from '@/components/pricing/faq.astro';
import SalesForm from '@/components/pricing/sales-form.astro';
import AuditSection from '@/components/home/audit-section.astro';
import Cta from '@/components/shared/cta.astro';
import { pricingPage } from '@/data/pages';
import { faqs } from '@/data/pricing';

export const prerender = true;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<Layout
  title="Pricing, Sprint Scopes & Growth Retainers | ZiaFlow Phoenix"
  description="Transparent pricing for Arizona service businesses: Starter Growth ($950/mo), Lead Capture & Automation ($1,950/mo), and Custom Engineering ($3,800/mo)."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <PageHero
    lines={pricingPage.hero.lines}
    intro={pricingPage.hero.intro}
    accent={pricingPage.hero.accent}
  />
  <Plans />
  <Compare />
  <RoiCalculator />
  <Faq />
  <SalesForm />
  <AuditSection />
  <Cta />
</Layout>
