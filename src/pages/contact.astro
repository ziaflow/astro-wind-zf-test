---
import Layout from '@/layouts/layout.astro';
import PageHero from '@/components/shared/page-hero.astro';
import SalesForm from '@/components/pricing/sales-form.astro';
import AuditSection from '@/components/home/audit-section.astro';
import Faq from '@/components/pricing/faq.astro';
import Icon from '@/components/shared/icons/icon.astro';
import { site } from '@/data/site';

export const prerender = true;
---

<Layout
  title="Contact ZiaFlow | Phoenix Web & Intake Engineering"
  description="Contact ZiaFlow in Phoenix, AZ. Call (602) 834-4239, book a consultation, or share your inquiry and intake requirements below."
>
  <PageHero
    lines={['Discuss your website', 'and follow-up.']}
    accent={1}
    intro="Speak with our Phoenix engineering team. Call our direct line, choose a time on our consultation calendar, or describe what happens after an inquiry reaches your business today."
  />

  <!-- Direct Channels Band -->
  <section class="shell pb-16 md:pb-24" aria-label="Direct contact channels">
    <div class="grid grid-cols-1 gap-6 border-t border-line pt-12 md:grid-cols-3">
      <a
        href="tel:+16028344239"
        class="group flex flex-col justify-between rounded-2xl border border-line bg-ink-2/70 p-8 transition-all hover:border-signal"
      >
        <div>
          <span class="inline-flex items-center gap-2 font-mono text-xs uppercase text-signal">
            <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Direct Phoenix Line
          </span>
          <h2 class="mt-4 font-display text-2xl font-bold text-bone group-hover:text-signal transition-colors">
            (602) 834-4239
          </h2>
          <p class="mt-2 text-sm text-mute leading-relaxed">
            Speak directly with our team about new project scopes, Sprint availability, or urgent intake repairs.
          </p>
        </div>
        <span class="mt-8 inline-flex items-center gap-2 font-mono text-xs uppercase text-bone group-hover:text-signal">
          Call Now <Icon name="arrow-up-right" class="size-4" />
        </span>
      </a>

      <a
        href={site.cta.primary.href}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col justify-between rounded-2xl border border-signal/60 bg-ink-2 p-8 transition-all hover:border-bone"
      >
        <div>
          <span class="font-mono text-xs uppercase text-signal"> Consultation Calendar </span>
          <h2 class="mt-4 font-display text-2xl font-bold text-bone">Book Scoping Call</h2>
          <p class="mt-2 text-sm text-mute leading-relaxed">
            Choose an available time on our calendar to review your website, inquiry handoffs, and lead follow-up goals.
          </p>
        </div>
        <span class="mt-8 inline-flex items-center gap-2 font-mono text-xs uppercase text-signal group-hover:text-bone">
          Open Calendar <Icon name="arrow-up-right" class="size-4" />
        </span>
      </a>

      <a
        href="mailto:info@ziaflow.com"
        class="group flex flex-col justify-between rounded-2xl border border-line bg-ink-2/70 p-8 transition-all hover:border-bone"
      >
        <div>
          <span class="font-mono text-xs uppercase text-mute"> Direct Email </span>
          <h2 class="mt-4 font-display text-2xl font-bold text-bone">info@ziaflow.com</h2>
          <p class="mt-2 text-sm text-mute leading-relaxed">
            Send architectural notes, RFP questions, or current tool workflows directly to our Phoenix team.
          </p>
        </div>
        <span class="mt-8 inline-flex items-center gap-2 font-mono text-xs uppercase text-bone">
          Email Us <Icon name="arrow-up-right" class="size-4" />
        </span>
      </a>
    </div>
  </section>

  <!-- Primary Lead Funnel Form (#form & #sales) -->
  <SalesForm />

  <!-- Secondary Video Audit Option -->
  <AuditSection />

  <!-- Common Intake FAQs -->
  <Faq />
</Layout>
