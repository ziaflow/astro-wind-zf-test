---
import { getCollection, render } from 'astro:content';
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import QuickLeadForm from '~/components/QuickLeadForm.astro';
import { Icon } from 'astro-icon/components';

export const prerender = true;

export const getStaticPaths = (async () => {
  const caseStudies = await getCollection('case-studies');
  return caseStudies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { study } = Astro.props as Props;
const { data } = study;
const { Content } = await render(study);

const metadata = {
  title: `${data.title} | ZiaFlow Case Study`,
  description: data.description,
  openGraph: {
    type: 'article',
    ...(data.image ? { images: [{ url: data.image }] } : {}),
  },
};
---

<Layout metadata={metadata}>
  <section class="py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl px-4 sm:px-6">
    {/* Breadcrumb / Back Link */}
    <div class="mb-8">
      <a href="/" class="inline-flex items-center text-sm font-medium text-muted hover:text-primary transition-colors">
        <Icon name="tabler:chevron-left" class="mr-1 h-4 w-4" />
        Back to Home
      </a>
    </div>

    {/* Header & Meta Pill Bar */}
    <header class="mb-10">
      <div class="mb-4 flex flex-wrap items-center gap-2">
        {
          data.industry && (
            <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary dark:bg-primary/20">
              {data.industry}
            </span>
          )
        }
        {
          data.metrics && (
            <span class="rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-bold text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-400">
              <Icon name="tabler:trending-up" class="mr-1 inline-block h-3.5 w-3.5" />
              {data.metrics}
            </span>
          )
        }
      </div>

      <h1
        class="text-3xl font-extrabold tracking-tight font-heading text-slate-900 sm:text-4xl lg:text-5xl dark:text-white mb-4"
      >
        {data.title}
      </h1>

      <p class="text-lg text-slate-600 sm:text-xl dark:text-slate-300 leading-relaxed mb-6">
        {data.description}
      </p>

      {/* Meta Specifications Box */}
      <div
        class="grid grid-cols-2 gap-4 rounded-xl border border-slate-200 bg-slate-50 p-4 sm:grid-cols-4 dark:border-slate-800 dark:bg-slate-800/50"
      >
        <div>
          <span class="block text-xs uppercase tracking-wider text-muted">Client</span>
          <span class="text-sm font-semibold text-slate-900 dark:text-white">{data.organisation}</span>
        </div>
        <div>
          <span class="block text-xs uppercase tracking-wider text-muted">Role</span>
          <span class="text-sm font-semibold text-slate-900 dark:text-white">{data.role || 'Web Engineering'}</span>
        </div>
        <div>
          <span class="block text-xs uppercase tracking-wider text-muted">Timeline</span>
          <span class="text-sm font-semibold text-slate-900 dark:text-white">{data.duration || '3 Weeks'}</span>
        </div>
        <div>
          <span class="block text-xs uppercase tracking-wider text-muted">Tech Stack</span>
          <span class="text-xs font-medium text-slate-900 dark:text-white truncate block">
            {data.tools.slice(0, 3).join(', ')}
          </span>
        </div>
      </div>
    </header>

    {/* Featured Cover Image */}
    {
      data.heroImage && (
        <div class="mb-12 overflow-hidden rounded-2xl shadow-xl border border-slate-200 dark:border-slate-800">
          <img src={data.heroImage} alt={data.title} class="w-full h-auto max-h-[460px] object-cover" />
        </div>
      )
    }

    {/* MDX Content Body */}
    <article
      class="prose prose-lg dark:prose-invert max-w-none mb-16 prose-headings:font-heading prose-headings:font-bold prose-a:text-primary"
    >
      <Content />
    </article>

    {/* Embedded Conversion Form for Inbound Scoping */}
    <div
      class="my-12 rounded-3xl border border-slate-200 bg-white p-6 shadow-xl dark:border-slate-800 dark:bg-slate-900 sm:p-10"
    >
      <div class="mb-6 text-center">
        <span class="text-xs font-bold uppercase tracking-wider text-primary">Need Similar Results?</span>
        <h2 class="mt-1 text-2xl font-bold font-heading text-slate-900 dark:text-white sm:text-3xl">
          Request an Architecture Diagnostic
        </h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
          We’ll review your existing forms, CRM syncs, and page speed to show where you are losing qualified inquiries.
        </p>
      </div>

      <QuickLeadForm />
    </div>
  </section>
</Layout>
