---
import Layout from '@/layouts/layout.astro';
import PageHero from '@/components/shared/page-hero.astro';
import StoryGrid from '@/components/customers/story-grid.astro';
import ResultsBand from '@/components/customers/results-band.astro';
import RoiCalculator from '@/components/home/roi-calculator.astro';
import AuditSection from '@/components/home/audit-section.astro';
import SalesForm from '@/components/pricing/sales-form.astro';
import Cta from '@/components/shared/cta.astro';
import { customersPage } from '@/data/pages';

export const prerender = true;
---

<Layout
  title="Arizona Case Studies & Lead Capture Blueprints | ZiaFlow"
  description="Explore real Arizona client results. See how commercial contractors and service businesses recovered lost pipeline, reduced response times, and automated lead intake."
>
  <PageHero
    lines={['Arizona case studies.', 'Measured lead results.']}
    intro="How Arizona service businesses and local operators use ZiaFlow to automate intake, eliminate lost inquiries, and turn clicks into booked revenue."
    accent={1}
  />
  <StoryGrid />
  <ResultsBand />
  <RoiCalculator />
  <AuditSection />
  <SalesForm />
  <Cta title={customersPage.cta.title} body={customersPage.cta.body} />
</Layout>

