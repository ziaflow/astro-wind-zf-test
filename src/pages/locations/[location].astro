---
import ExpansionPage from '~/components/expansion/ExpansionPage.astro';
import { pagesOfKind } from '~/data/expansion-pages';
export const prerender = true;
export function getStaticPaths() {
  return pagesOfKind('location').map((page) => ({ params: { location: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---

<ExpansionPage page={page} />
