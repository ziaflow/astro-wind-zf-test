---
import Layout from '~/layouts/PageLayout.astro';
import { supabase } from '~/lib/supabase';

export const prerender = false;

const currentTab = Astro.url.searchParams.get('tab') || 'overview';

let gscData: any[] = [];
let ga4Data: any[] = [];
let clarityData: any[] = [];
let unifiedData: any[] = [];
let leadsData: any[] = [];
let fetchError: string | null = null;

if (supabase) {
  try {
    const [gscRes, ga4Res, clarityRes, unifiedRes, leadsRes] = await Promise.all([
      supabase.from('metrics_gsc_daily').select('*').order('date', { ascending: false }).limit(50),
      supabase.from('metrics_ga4_daily').select('*').order('date', { ascending: false }).limit(50),
      supabase.from('metrics_clarity_daily').select('*').order('date', { ascending: false }).limit(50),
      supabase.from('view_unified_page_intelligence').select('*').order('date', { ascending: false }).limit(50),
      supabase.from('leads').select('*').order('created_at', { ascending: false }).limit(50),
    ]);

    gscData = gscRes.data || [];
    ga4Data = ga4Res.data || [];
    clarityData = clarityRes.data || [];
    unifiedData = unifiedRes.data || [];
    leadsData = leadsRes.data || [];
  } catch (err: any) {
    fetchError = err.message;
  }
}

// Overview aggregations
const totalGoogleClicks = gscData.reduce((acc, row) => acc + (row.clicks || 0), 0);
const totalGoogleImpressions = gscData.reduce((acc, row) => acc + (row.impressions || 0), 0);
const totalGaSessions = ga4Data.reduce((acc, row) => acc + (row.sessions || 0), 0);
const totalClaritySessions = clarityData.filter(c => c.page_path === '*').reduce((acc, row) => acc + (row.total_sessions || 0), 0);
const totalDeadClicks = clarityData.reduce((acc, row) => acc + (row.dead_clicks || 0), 0);
const totalRageClicks = clarityData.reduce((acc, row) => acc + (row.rage_clicks || 0), 0);
const totalLeads = leadsData.length;

const metadata = {
  title: 'Telemetry & Intelligence Command Center | ZiaFlow Admin',
};
---

<Layout metadata={metadata}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
    <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 border-b border-gray-200 dark:border-slate-800 gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary">
            Realtime Analytics Warehouse
          </span>
          <span class="text-xs text-gray-500">Live Supabase Telemetry</span>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 dark:text-white">
          Intelligence & Analytics Hub
        </h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
          Unified telemetry from Google Search Console, Google Analytics 4, Microsoft Clarity, and Inbound Leads.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a
          href="/admin/analytics"
          class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-slate-700 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-slate-800 hover:bg-gray-50 shadow-sm"
        >
          ↻ Refresh
        </a>
        <a
          href="/admin/communications"
          class="inline-flex items-center px-4 py-2 border border-transparent rounded-lg text-sm font-medium text-white bg-primary hover:bg-primary-dark shadow-sm"
        >
          Communications Feed →
        </a>
      </div>
    </div>

    {fetchError && (
      <div class="mt-6 p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-sm">
        ⚠️ Connection Notice: {fetchError}
      </div>
    )}

    {/* Navigation Tabs */}
    <div class="flex space-x-2 border-b border-gray-200 dark:border-slate-800 mt-6 overflow-x-auto pb-px">
      <a
        href="/admin/analytics?tab=overview"
        class:list={[
          'px-4 py-2 text-sm font-medium whitespace-nowrap border-b-2 transition-colors',
          currentTab === 'overview'
            ? 'border-primary text-primary font-bold'
            : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300',
        ]}
      >
        Executive Overview
      </a>
      <a
        href="/admin/analytics?tab=clarity"
        class:list={[
          'px-4 py-2 text-sm font-medium whitespace-nowrap border-b-2 transition-colors',
          currentTab === 'clarity'
            ? 'border-primary text-primary font-bold'
            : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300',
        ]}
      >
        Microsoft Clarity (UX & Friction)
      </a>
      <a
        href="/admin/analytics?tab=gsc"
        class:list={[
          'px-4 py-2 text-sm font-medium whitespace-nowrap border-b-2 transition-colors',
          currentTab === 'gsc'
            ? 'border-primary text-primary font-bold'
            : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300',
        ]}
      >
        Search Console (SEO Demand)
      </a>
      <a
        href="/admin/analytics?tab=ga4"
        class:list={[
          'px-4 py-2 text-sm font-medium whitespace-nowrap border-b-2 transition-colors',
          currentTab === 'ga4'
            ? 'border-primary text-primary font-bold'
            : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300',
        ]}
      >
        Google Analytics 4 (Behavior)
      </a>
      <a
        href="/admin/analytics?tab=unified"
        class:list={[
          'px-4 py-2 text-sm font-medium whitespace-nowrap border-b-2 transition-colors',
          currentTab === 'unified'
            ? 'border-primary text-primary font-bold'
            : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300',
        ]}
      >
        Unified AI View
      </a>
    </div>

    {/* TAB 1: EXECUTIVE OVERVIEW */}
    {currentTab === 'overview' && (
      <div class="mt-8 space-y-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="text-xs uppercase tracking-wider font-semibold text-gray-500">Total Leads Ingested</div>
            <div class="mt-2 text-3xl font-black text-gray-900 dark:text-white">{totalLeads}</div>
            <div class="mt-1 text-xs text-emerald-600 font-medium">Direct to Supabase & Customer.io</div>
          </div>
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="text-xs uppercase tracking-wider font-semibold text-gray-500">Google Search Demand</div>
            <div class="mt-2 text-3xl font-black text-gray-900 dark:text-white">{totalGoogleClicks} <span class="text-sm font-normal text-gray-400">clicks</span></div>
            <div class="mt-1 text-xs text-gray-500">{totalGoogleImpressions} total organic impressions</div>
          </div>
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="text-xs uppercase tracking-wider font-semibold text-gray-500">GA4 Sessions</div>
            <div class="mt-2 text-3xl font-black text-gray-900 dark:text-white">{totalGaSessions}</div>
            <div class="mt-1 text-xs text-gray-500">On-site behavioral telemetry</div>
          </div>
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
            <div class="text-xs uppercase tracking-wider font-semibold text-gray-500">Clarity UX Friction</div>
            <div class="mt-2 text-3xl font-black text-amber-600">{totalDeadClicks} <span class="text-xs font-normal text-gray-400">dead clicks</span></div>
            <div class="mt-1 text-xs text-gray-500">{totalRageClicks} rage clicks recorded</div>
          </div>
        </div>

        {/* Unified Table Preview */}
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm">
          <div class="p-5 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white">Recent Unified Intelligence Telemetry</h2>
            <span class="text-xs text-gray-400">Combining GSC + GA4 + Clarity + Leads</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-50 dark:bg-slate-800/50 text-gray-600 dark:text-gray-300 font-semibold text-xs uppercase">
                <tr>
                  <th class="px-5 py-3">Date</th>
                  <th class="px-5 py-3">Page Path</th>
                  <th class="px-5 py-3">GSC Clicks</th>
                  <th class="px-5 py-3">GA4 Sessions</th>
                  <th class="px-5 py-3">Clarity Dead Clicks</th>
                  <th class="px-5 py-3">Leads</th>
                  <th class="px-5 py-3">AI Agent Signal</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-gray-700 dark:text-gray-300">
                {unifiedData.length === 0 ? (
                  <tr>
                    <td colspan="7" class="px-5 py-8 text-center text-gray-400">No unified telemetry records logged yet.</td>
                  </tr>
                ) : (
                  unifiedData.slice(0, 10).map((row) => (
                    <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
                      <td class="px-5 py-3.5 whitespace-nowrap font-mono text-xs">{row.date}</td>
                      <td class="px-5 py-3.5 font-medium text-gray-900 dark:text-white">{row.page_path}</td>
                      <td class="px-5 py-3.5">{row.google_clicks ?? 0}</td>
                      <td class="px-5 py-3.5">{row.ga_sessions ?? 0}</td>
                      <td class="px-5 py-3.5">{row.clarity_dead_clicks ?? 0}</td>
                      <td class="px-5 py-3.5 font-bold text-emerald-600">{row.leads_generated ?? 0}</td>
                      <td class="px-5 py-3.5">
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                          {row.agent_health_signal || 'Healthy'}
                        </span>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    )}

    {/* TAB 2: CLARITY */}
    {currentTab === 'clarity' && (
      <div class="mt-8 space-y-6">
        <div class="p-4 rounded-xl bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 text-blue-900 dark:text-blue-300 text-sm flex justify-between items-center">
          <div>
            <strong>Microsoft Clarity API Connected:</strong> Ingesting rage clicks, dead clicks, quick backs, and scroll depth directly from the live telemetry export API.
          </div>
          <form method="POST" action="/api/sync/clarity">
            <button type="submit" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-blue-600 text-white hover:bg-blue-700">
              Trigger Live Fetch
            </button>
          </form>
        </div>

        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm">
          <div class="p-5 border-b border-slate-200 dark:border-slate-800">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white">Clarity Session Friction Records</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-50 dark:bg-slate-800/50 text-gray-600 dark:text-gray-300 font-semibold text-xs uppercase">
                <tr>
                  <th class="px-5 py-3">Date</th>
                  <th class="px-5 py-3">Page Path</th>
                  <th class="px-5 py-3">Total Sessions</th>
                  <th class="px-5 py-3">Dead Clicks</th>
                  <th class="px-5 py-3">Rage Clicks</th>
                  <th class="px-5 py-3">Quick Backs</th>
                  <th class="px-5 py-3">Excessive Scroll</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-gray-700 dark:text-gray-300">
                {clarityData.map((row) => (
                  <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
                    <td class="px-5 py-3.5 whitespace-nowrap font-mono text-xs">{row.date}</td>
                    <td class="px-5 py-3.5 font-medium text-gray-900 dark:text-white">{row.page_path}</td>
                    <td class="px-5 py-3.5 font-bold">{row.total_sessions}</td>
                    <td class="px-5 py-3.5 text-amber-600">{row.dead_clicks}</td>
                    <td class="px-5 py-3.5 text-rose-600">{row.rage_clicks}</td>
                    <td class="px-5 py-3.5">{row.quick_backs}</td>
                    <td class="px-5 py-3.5">{row.excessive_scrolling}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    )}

    {/* TAB 3: SEARCH CONSOLE */}
    {currentTab === 'gsc' && (
      <div class="mt-8 space-y-6">
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm">
          <div class="p-5 border-b border-slate-200 dark:border-slate-800">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white">Google Search Console Daily Ingestion</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-50 dark:bg-slate-800/50 text-gray-600 dark:text-gray-300 font-semibold text-xs uppercase">
                <tr>
                  <th class="px-5 py-3">Date</th>
                  <th class="px-5 py-3">Search Query</th>
                  <th class="px-5 py-3">Target Page</th>
                  <th class="px-5 py-3">Clicks</th>
                  <th class="px-5 py-3">Impressions</th>
                  <th class="px-5 py-3">CTR</th>
                  <th class="px-5 py-3">Avg Position</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-gray-700 dark:text-gray-300">
                {gscData.map((row) => (
                  <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
                    <td class="px-5 py-3.5 whitespace-nowrap font-mono text-xs">{row.date}</td>
                    <td class="px-5 py-3.5 font-bold text-gray-900 dark:text-white">{row.query}</td>
                    <td class="px-5 py-3.5 text-gray-500">{row.page_path}</td>
                    <td class="px-5 py-3.5 font-semibold text-emerald-600">{row.clicks}</td>
                    <td class="px-5 py-3.5">{row.impressions}</td>
                    <td class="px-5 py-3.5">{((row.ctr || 0) * 100).toFixed(1)}%</td>
                    <td class="px-5 py-3.5 font-mono">{Number(row.position || 0).toFixed(1)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    )}

    {/* TAB 4: GA4 */}
    {currentTab === 'ga4' && (
      <div class="mt-8 space-y-6">
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm">
          <div class="p-5 border-b border-slate-200 dark:border-slate-800">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white">Google Analytics 4 On-Page Telemetry</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-50 dark:bg-slate-800/50 text-gray-600 dark:text-gray-300 font-semibold text-xs uppercase">
                <tr>
                  <th class="px-5 py-3">Date</th>
                  <th class="px-5 py-3">Page Path</th>
                  <th class="px-5 py-3">Active Users</th>
                  <th class="px-5 py-3">Sessions</th>
                  <th class="px-5 py-3">Conversions</th>
                  <th class="px-5 py-3">Bounce Rate</th>
                  <th class="px-5 py-3">Avg Engagement</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-gray-700 dark:text-gray-300">
                {ga4Data.map((row) => (
                  <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
                    <td class="px-5 py-3.5 whitespace-nowrap font-mono text-xs">{row.date}</td>
                    <td class="px-5 py-3.5 font-medium text-gray-900 dark:text-white">{row.page_path}</td>
                    <td class="px-5 py-3.5">{row.active_users}</td>
                    <td class="px-5 py-3.5 font-bold">{row.sessions}</td>
                    <td class="px-5 py-3.5 text-emerald-600 font-semibold">{row.conversions}</td>
                    <td class="px-5 py-3.5">{((row.bounce_rate || 0) * 100).toFixed(1)}%</td>
                    <td class="px-5 py-3.5 font-mono">{row.avg_engagement_time_sec}s</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    )}

    {/* TAB 5: UNIFIED */}
    {currentTab === 'unified' && (
      <div class="mt-8 space-y-6">
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm">
          <div class="p-5 border-b border-slate-200 dark:border-slate-800">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white">Full Unified Intelligence Data View</h2>
            <p class="text-xs text-gray-400 mt-1">Queried from `public.view_unified_page_intelligence` in Supabase</p>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="bg-slate-50 dark:bg-slate-800/50 text-gray-600 dark:text-gray-300 font-semibold text-xs uppercase">
                <tr>
                  <th class="px-5 py-3">Date</th>
                  <th class="px-5 py-3">Page</th>
                  <th class="px-5 py-3">GSC Clicks / Impr</th>
                  <th class="px-5 py-3">GA4 Sessions</th>
                  <th class="px-5 py-3">Clarity Dead Clicks</th>
                  <th class="px-5 py-3">Leads</th>
                  <th class="px-5 py-3">Agent Signal</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-gray-700 dark:text-gray-300">
                {unifiedData.map((row) => (
                  <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30">
                    <td class="px-5 py-3.5 whitespace-nowrap font-mono text-xs">{row.date}</td>
                    <td class="px-5 py-3.5 font-medium text-gray-900 dark:text-white">{row.page_path}</td>
                    <td class="px-5 py-3.5">{row.google_clicks ?? 0} / {row.google_impressions ?? 0}</td>
                    <td class="px-5 py-3.5">{row.ga_sessions ?? 0}</td>
                    <td class="px-5 py-3.5 text-amber-600">{row.clarity_dead_clicks ?? 0}</td>
                    <td class="px-5 py-3.5 font-bold text-emerald-600">{row.leads_generated ?? 0}</td>
                    <td class="px-5 py-3.5">
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                        {row.agent_health_signal || 'Healthy'}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    )}
  </section>
</Layout>
