---
import Capabilities from '@/components/home/capabilities.astro';
import Hero from '@/components/home/hero.astro';
import HowItWorks from '@/components/home/how-it-works.astro';
import Logos from '@/components/home/logos.astro';
import Manifesto from '@/components/home/manifesto.astro';
import ProductReveal from '@/components/home/product-reveal.astro';
import Proof from '@/components/home/proof.astro';
import Stories from '@/components/home/stories.astro';
import Cta from '@/components/shared/cta.astro';
import Layout from '@/layouts/layout.astro';

export const prerender = true;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How does ZiaFlow help Arizona service businesses manage incoming inquiries?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Through our Lead Capture & Follow-Up Sprint, we audit your agreed inquiry sources (such as web forms, call-tracking endpoints, and Google Local Service Ads), repair broken capture points, connect automated prospect acknowledgement, alert responsible staff, and provide a documented operating runbook so every accepted inquiry has an owner and a next step.',
      },
    },
    {
      '@type': 'Question',
      name: 'What services does ZiaFlow provide in Phoenix, Arizona?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ZiaFlow provides custom web development & SEO, building fast Astro websites and implementing lead capture, CRM routing, technical SEO, and conversion systems for Arizona service businesses.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do we get started with ZiaFlow?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You can book a consultation call or contact our Phoenix team directly. We will review how inquiries enter your business today, identify broken handoffs, and outline a fixed-scope Sprint.',
      },
    },
  ],
};
---

<Layout
  title="Custom Web Development & SEO for Arizona Service Businesses | ZiaFlow"
  description="ZiaFlow provides custom web development & SEO for Arizona service businesses. Fast Astro websites, local search optimization, and automated lead follow-up. Call (602) 834-4239."
  preloader
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Hero />
  <Logos />
  <Manifesto />
  <ProductReveal />
  <Capabilities />
  <HowItWorks />
  <Stories />
  <Proof />
  <Cta />
</Layout>
