---
import Capabilities from '@/components/home/capabilities.astro';
import Hero from '@/components/home/hero.astro';
import HowItWorks from '@/components/home/how-it-works.astro';
import Logos from '@/components/home/logos.astro';
import Manifesto from '@/components/home/manifesto.astro';
import ProductReveal from '@/components/home/product-reveal.astro';
import Proof from '@/components/home/proof.astro';
import Stories from '@/components/home/stories.astro';
import Cta from '@/components/shared/cta.astro';
import Layout from '@/layouts/layout.astro';

export const prerender = true;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How does ZiaFlow fix lost leads for Arizona service businesses?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Through our Lead Capture & Follow-Up Sprint, we audit every inbound source (web forms, phone tracking numbers, and Google Local Service Ads), repair silent capture failures, wire sub-60-second automated acknowledgement and staff SMS/CRM dispatch, and hand over a documented operator runbook.',
      },
    },
    {
      '@type': 'Question',
      name: 'What services does ZiaFlow provide in Phoenix, Arizona?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ZiaFlow specializes in high-speed Astro web development, marketing and lead follow-up automation, technical local SEO, Google Business Profile (GBP) optimization, Google Local Service Ads (LSA) management, conversion rate optimization (CRO), and custom software engineering.',
      },
    },
    {
      '@type': 'Question',
      name: 'How quickly can we get a technical website and conversion audit?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Our Phoenix engineering team records and delivers a custom 10-minute forensic video audit breaking down your Core Web Vitals, search visibility, and lead capture leaks within 48 business hours.',
      },
    },
  ],
};
---

<Layout
  title="Turn More Inquiries Into Booked Work | ZiaFlow Phoenix"
  description="ZiaFlow helps Phoenix service businesses capture every inquiry, respond in under 60 seconds, and turn website traffic into booked work. Call (602) 834-4239."
  preloader
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Hero />
  <Logos />
  <Manifesto />
  <ProductReveal />
  <Capabilities />
  <HowItWorks />
  <Stories />
  <Proof />
  <Cta />
</Layout>
