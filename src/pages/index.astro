---
import Layout from '~/layouts/PageLayout.astro';
import Features3 from '~/components/widgets/Features3.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import LocalBusinessSchema from '~/components/seo/LocalBusinessSchema.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import HeroQuickForm from '~/components/HeroQuickForm.astro';
import Content from '~/components/widgets/Content.astro';
import { Icon } from 'astro-icon/components'; // Added for the custom section icons

const metadata = {
  title: 'Phoenix Web Development & Business Automation | ZiaFlow',
  description:
    'ZiaFlow helps Arizona service businesses build better websites, connect their tools, and simplify client intake. Call (602) 834-4239 or schedule a consultation.',
  ignoreTitleTemplate: true,
  openGraph: {
    url: 'https://ziaflow.com/',
    siteName: 'ZiaFlow',
    type: 'website',
    locale: 'en',
    title: 'Phoenix Web Development & Business Automation | ZiaFlow',
    description:
      'ZiaFlow helps Arizona service businesses build websites, custom tools, CRM integrations, and workflow automation. Call (602) 834-4239 to discuss your next project.',
    images: [
      {
        url: 'https://ziaflow.com/logo.png',
        width: 1200,
        height: 630,
        alt: 'ZiaFlow Digital Growth Partner',
      },
    ],
  },
  extend: {
    meta: [
      {
        property: 'og:logo',
        content: 'https://ziaflow.com/logo.png',
      },
      {
        name: 'twitter:card',
        content: 'summary_large_image',
      },
      {
        name: 'twitter:url',
        content: 'https://ziaflow.com/',
      },
      {
        name: 'twitter:title',
        content: 'Phoenix Web Development & Business Automation | ZiaFlow',
      },
      {
        name: 'twitter:image',
        content: 'https://ziaflow.com/logo.png',
      },
    ],
  },
};
---

<Layout metadata={metadata}>
  <LocalBusinessSchema />

  <section class="bg-slate-50 dark:bg-slate-950">
    <div class="mx-auto grid max-w-7xl items-center gap-8 px-4 py-10 sm:px-6 md:py-16 lg:grid-cols-2 lg:gap-14">
      <div class="max-w-xl">
        <p class="mb-4 text-base font-semibold text-primary">Websites &amp; business automation in Arizona</p>
        <h1 class="mb-5 text-4xl font-bold leading-tight tracking-tight text-slate-900 sm:text-5xl dark:text-white">
          Turn more website inquiries into customer conversations.
        </h1>
        <p class="text-lg leading-relaxed text-slate-600 dark:text-slate-300">
          Make it easier for customers to contact you, send each inquiry to the right place, and keep follow-up moving.
          ZiaFlow builds websites and connects the tools behind them for Arizona service businesses.
        </p>
        <p class="mt-5 text-base text-slate-600 dark:text-slate-300">
          Start with the problem you need to solve. We’ll discuss the scope and next step before you commit to a
          project.
        </p>
        <a href="#how-we-help" class="mt-6 inline-block font-semibold text-primary underline underline-offset-4"
          >Explore how we can help</a
        >
      </div>
      <HeroQuickForm />
    </div>
  </section>

  <!-- 2. Three Core Buyer-Oriented Service Paths -->
  <WidgetWrapper id="how-we-help" containerClass="max-w-7xl mx-auto py-12 md:py-16" isDark={false}>
    <div class="text-center max-w-3xl mx-auto mb-12">
      <p class="text-primary font-bold text-sm tracking-widest uppercase mb-2">Build The Right System</p>
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-heading">
        Three Practical Ways We Help Your Business Operate Better
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
      <!-- Path 1: Websites & Custom Tools -->
      <div
        class="flex flex-col justify-between p-8 rounded-2xl border border-gray-200 hover:border-primary/50 shadow-sm hover:shadow-md transition-all bg-white dark:bg-slate-900 dark:border-slate-800"
      >
        <div>
          <div class="inline-block p-3 rounded-xl bg-blue-50 dark:bg-slate-800 text-primary mb-6">
            <Icon name="tabler:browser" class="w-8 h-8" />
          </div>
          <h3 class="text-2xl font-bold mb-3 leading-snug">Websites & Custom Tools</h3>
          <p class="text-gray-600 dark:text-gray-400 text-base leading-relaxed mb-6">
            Build a website that explains your services clearly—or an internal application that fits how your business
            operates. Connect the two when your workflow needs more than a standard brochure site.
          </p>
        </div>
        <div class="pt-4 border-t border-gray-100 dark:border-slate-800 flex flex-col gap-2">
          <a href="/services/web-development" class="text-primary font-bold inline-flex items-center hover:underline">
            Web Development Details <Icon name="tabler:arrow-narrow-right" class="w-5 h-5 ml-1" />
          </a>
          <a href="/services/software" class="text-sm text-gray-500 hover:text-primary">
            Custom Software & Internal Tools →
          </a>
        </div>
      </div>

      <!-- Path 2: Lead & Workflow Automation -->
      <div
        class="flex flex-col justify-between p-8 rounded-2xl border-2 border-primary/30 hover:border-primary shadow-md hover:shadow-lg transition-all bg-white dark:bg-slate-900 dark:border-primary/40 relative"
      >
        <div
          class="absolute -top-3 right-6 bg-primary text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full"
        >
          Core Focus
        </div>
        <div>
          <div class="inline-block p-3 rounded-xl bg-blue-50 dark:bg-slate-800 text-primary mb-6">
            <Icon name="tabler:settings-automation" class="w-8 h-8" />
          </div>
          <h3 class="text-2xl font-bold mb-3 leading-snug">Lead & Workflow Automation</h3>
          <p class="text-gray-600 dark:text-gray-400 text-base leading-relaxed mb-6">
            Connect website inquiries, CRM records, scheduling, and follow-up. Reduce repetitive handoffs while keeping
            ownership, exceptions, and human review visible.
          </p>
        </div>
        <div class="pt-4 border-t border-gray-100 dark:border-slate-800">
          <a href="/services/automation" class="text-primary font-bold inline-flex items-center hover:underline">
            Explore Automation Systems <Icon name="tabler:arrow-narrow-right" class="w-5 h-5 ml-1" />
          </a>
        </div>
      </div>

      <!-- Path 3: SEO & Website Improvement -->
      <div
        class="flex flex-col justify-between p-8 rounded-2xl border border-gray-200 hover:border-primary/50 shadow-sm hover:shadow-md transition-all bg-white dark:bg-slate-900 dark:border-slate-800"
      >
        <div>
          <div class="inline-block p-3 rounded-xl bg-blue-50 dark:bg-slate-800 text-primary mb-6">
            <Icon name="tabler:chart-arrows-vertical" class="w-8 h-8" />
          </div>
          <h3 class="text-2xl font-bold mb-3 leading-snug">SEO & Website Improvement</h3>
          <p class="text-gray-600 dark:text-gray-400 text-base leading-relaxed mb-6">
            Identify technical search issues, improve important service pages, and measure how visitors move toward an
            inquiry. Prioritize useful changes over publishing more content for its own sake.
          </p>
        </div>
        <div class="pt-4 border-t border-gray-100 dark:border-slate-800 flex flex-col gap-2">
          <a href="/services/seo" class="text-primary font-bold inline-flex items-center hover:underline">
            Technical SEO Details <Icon name="tabler:arrow-narrow-right" class="w-5 h-5 ml-1" />
          </a>
          <a href="/services/cro" class="text-sm text-gray-500 hover:text-primary"> Conversion Optimization (CRO) → </a>
        </div>
      </div>
    </div>
  </WidgetWrapper>

  <!-- 3. Workflow Connectivity Section: "A better website is only the beginning" -->
  <WidgetWrapper
    containerClass="max-w-7xl mx-auto py-12 md:py-16 bg-slate-50 dark:bg-slate-900/50 rounded-3xl my-8 px-6 md:px-12"
    isDark={false}
  >
    <div class="max-w-3xl mx-auto text-center mb-10">
      <p class="text-primary font-bold text-sm tracking-widest uppercase mb-2">Connected Operations</p>
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-heading mb-4">
        A better website is only the beginning.
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-300">
        What happens after someone submits a form matters just as much as the page that brought them there. We help
        connect the customer-facing experience to the systems behind it.
      </p>
    </div>

    <!-- Process Diagram Flow -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 my-8">
      <div
        class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 text-center shadow-sm"
      >
        <div class="text-xs font-bold text-primary uppercase tracking-wider mb-1">Step 1</div>
        <div class="font-bold text-gray-900 dark:text-white mb-1">Website Inquiry</div>
        <p class="text-xs text-gray-500">Customers reach you through a short, clear form</p>
      </div>
      <div
        class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 text-center shadow-sm"
      >
        <div class="text-xs font-bold text-primary uppercase tracking-wider mb-1">Step 2</div>
        <div class="font-bold text-gray-900 dark:text-white mb-1">Validated Data</div>
        <p class="text-xs text-gray-500">Check the details before they reach your team</p>
      </div>
      <div
        class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 text-center shadow-sm"
      >
        <div class="text-xs font-bold text-primary uppercase tracking-wider mb-1">Step 3</div>
        <div class="font-bold text-gray-900 dark:text-white mb-1">CRM Record</div>
        <p class="text-xs text-gray-500">Keep the inquiry in the system your team uses</p>
      </div>
      <div
        class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 text-center shadow-sm"
      >
        <div class="text-xs font-bold text-primary uppercase tracking-wider mb-1">Step 4</div>
        <div class="font-bold text-gray-900 dark:text-white mb-1">Assigned Follow-Up</div>
        <p class="text-xs text-gray-500">Give the right person the details needed to respond</p>
      </div>
      <div
        class="p-4 bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 text-center shadow-sm"
      >
        <div class="text-xs font-bold text-primary uppercase tracking-wider mb-1">Step 5</div>
        <div class="font-bold text-gray-900 dark:text-white mb-1">Booking Confirmed</div>
        <p class="text-xs text-gray-500">Make it easy to agree on the next conversation</p>
      </div>
    </div>

    <div class="text-center max-w-2xl mx-auto mt-6 text-sm text-gray-500 italic">
      Example operational workflow. Every system needs clear ownership, sensible permissions, and a plan for
      exceptions—not just an automation that works once.
    </div>
  </WidgetWrapper>

  <Content
    title="Evidence-Backed Content Strategy"
    subtitle="Search intelligence that analyzes search intent, real citations, and competitor gaps to build authoritative, useful content."
    items={[
      {
        title: 'Search Intent & Gap Analysis',
        description:
          'We evaluate top-performing search queries and user intent to identify exact content opportunities that answer customer questions.',
      },
      {
        title: 'Expert-Reviewed Content',
        description:
          'Publish original, research-backed articles and actionable guides designed to satisfy Google helpful content standards and convert buyers.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Data Driven Dashboard',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-primary">Intelligence</span> Dashboard
      </h3>
    </Fragment>
  </Content>

  <CallToAction
    title="Where are customer inquiries getting stuck?"
    subtitle="Tell us what happens between the first inquiry and the first conversation. We’ll discuss what to fix, what it involves, and whether ZiaFlow is a fit."
    actions={[
      {
        variant: 'primary',
        text: 'Request a consultation',
        href: '#hero-quick-form',
        icon: 'tabler:arrow-right',
      },
      {
        variant: 'secondary',
        text: 'Schedule Consultation',
        href: 'https://outlook.office.com/book/ZiaFlowIntake@ziaflow.com/?ismsaljsauthenabled',
        icon: 'tabler:calendar',
      },
    ]}
  />

  <!-- Practical Guides for Better Websites and Workflows -->
  <BlogLatestPosts
    title="Practical Guides for Better Websites and Workflows"
    information="Explore lead routing, appointment reminders, CRM integration, and the checks that keep automated workflows reliable."
  />

  <FAQs
    title="Frequently Asked Questions"
    subtitle="Answers to common questions about our services and process."
    tagline="FAQ"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'What makes ZiaFlow different from other agencies?',
        description:
          'We connect the website to what happens after an inquiry: routing, follow-up, scheduling, and the tools your team uses. We start by discussing the workflow you need to improve.',
      },
      {
        title: 'How do you measure success?',
        description:
          'We focus on what matters: leads and revenue. Our transparent dashboards track calls, appointments, and sales, providing clear insight into your ROI.',
      },
      {
        title: 'Do you work with businesses outside of Arizona?',
        description:
          'Yes. While we proudly serve businesses in Phoenix, Scottsdale, Tucson, and Glendale, we also partner with companies nationwide to provide digital marketing, custom software, and cloud solutions.',
      },
      {
        title: 'How quickly will I see results?',
        description:
          'PPC campaigns can generate leads within days, while SEO typically shows significant improvement in 3-6 months. We provide realistic timelines for all projects upfront.',
      },
      {
        title: 'What is included in your marketing automation services?',
        description:
          'Our AI-powered automation can handle lead nurturing, appointment scheduling, customer follow-ups, review requests, and service inquiries. We customize every system to fit your specific business processes.',
      },
      {
        title: 'How does our existing software integrate with ZiaFlow?',
        description:
          'We engineer custom API connectors directly into your existing CRM, Jobber, ServiceTitan, HubSpot, or ERP without requiring you to replace your operational software.',
      },
    ]}
  />

  <Features3
    title="Contact ZiaFlow"
    subtitle="Choose the method that works best for you"
    columns={4}
    items={[
      {
        title: 'Call Us Now',
        icon: 'tabler:phone-call',
        callToAction: {
          text: '📞 (602) 834-4239',
          href: 'tel:+16028344239',
          variant: 'link',
        },
      },
      {
        title: 'Email',
        icon: 'tabler:mail',
        callToAction: {
          text: 'info@ziaflow.com',
          href: 'mailto:info@ziaflow.com',
          variant: 'link',
        },
      },
      {
        title: 'Visit',
        icon: 'tabler:map-pin',
        callToAction: {
          text: 'Phoenix, AZ 85023',
          href: 'https://maps.google.com?q=Phoenix+AZ+85023',
          variant: 'link',
        },
      },
      {
        title: 'Schedule',
        icon: 'tabler:calendar',
        callToAction: {
          text: 'Book Meeting',
          href: 'https://outlook.office.com/book/ZiaFlowIntake@ziaflow.com/?ismsaljsauthenabled',
          variant: 'link',
        },
      },
    ]}
  />
</Layout>
