---
import Layout from '@/layouts/layout.astro';
import Icon from '@/components/shared/icons/icon.astro';

export const prerender = true;
---

<Layout
  title="Scoping Call Booked | ZiaFlow"
  description="Your ZiaFlow scoping call is confirmed. Review how to prepare for our session."
  metadata={{ robots: { index: false, follow: false } }}
>
  <section class="relative isolate overflow-hidden border-b border-line pt-28 pb-20 md:pt-36 md:pb-28">
    <div
      class="pointer-events-none absolute -top-40 right-[-8rem] -z-10 size-[34rem] rounded-full bg-signal/15 blur-[120px]"
      aria-hidden="true"
    ></div>

    <div class="shell max-w-4xl">
      <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-line-strong bg-ink-2 px-3.5 py-1.5 font-mono text-xs uppercase tracking-[0.16em] text-emerald-400">
        <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Scoping Call Confirmed
      </p>

      <h1 class="font-display text-hero font-extrabold leading-[0.98] tracking-[-0.04em] text-bone">
        You’re on the <span class="text-signal">calendar.</span>
      </h1>

      <p class="mt-6 max-w-[58ch] text-lead leading-relaxed text-mute">
        Your calendar invite and meeting link have been sent to your inbox. We’ll use our 30 minutes together to map
        where leads are entering today and identify the smallest practical repairs.
      </p>

      <div class="mt-10 rounded-2xl border border-line bg-ink-2/70 p-6 sm:p-8">
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-signal">Before our call</p>
        <h2 class="mt-3 font-display text-xl font-bold text-bone">Three quick things to have handy (optional)</h2>
        <ul class="mt-5 space-y-3 text-sm text-mute">
          <li class="flex items-start gap-2.5">
            <span class="text-signal font-bold">✓</span>
            <span>Where your leads currently arrive (website forms, phone calls, Google Business Profile, ads).</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-signal font-bold">✓</span>
            <span>Who is supposed to respond first, and what happens if they’re on a job or unavailable.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-signal font-bold">✓</span>
            <span>Any CRM, dispatch, or calendar tools your team already uses so we can build around them.</span>
          </li>
        </ul>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href="/"
          class="btn h-13 rounded-full bg-bone px-7 font-semibold text-ink hover:bg-white"
          data-btn
        >
          <span class="btn-fill bg-signal text-bone" aria-hidden="true"></span>
          <span>Return to homepage</span>
          <Icon name="arrow-right" class="size-4" />
        </a>
        <a
          href="tel:+16028344239"
          class="inline-flex h-13 items-center gap-2 rounded-full border border-line-strong bg-ink-2 px-6 text-sm font-mono font-bold text-bone transition hover:border-signal hover:text-signal"
        >
          <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Need to reschedule? (602) 834-4239</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const source = params.get('source') || 'calendly';

  try {
    if (!sessionStorage.getItem('ziaflow:call_booked_tracked')) {
      sessionStorage.setItem('ziaflow:call_booked_tracked', '1');
      const w = window as unknown as {
        dataLayer?: Record<string, unknown>[];
        gtag?: (...args: unknown[]) => void;
      };
      if (w.dataLayer) {
        w.dataLayer.push({
          event: 'call_booked_confirmed',
          source,
          page_path: window.location.pathname,
        });
      }
      if (typeof w.gtag === 'function') {
        w.gtag('event', 'schedule_call_confirmed', {
          event_category: 'conversion',
          event_label: source,
          value: 1,
        });
      }
    }
  } catch {
    /* ignore storage errors */
  }
</script>
