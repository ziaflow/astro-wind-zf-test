---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import QuickLeadForm from '~/components/QuickLeadForm.astro';
import ServiceSchema from '~/components/seo/ServiceSchema.astro';

const metadata = {
  title: 'Shopify Store Development & Headless Commerce | ZiaFlow',
  description:
    'Custom Shopify and Shopify Plus development. High-converting storefronts, custom Liquid sections, headless commerce, and seamless ERP/CRM integrations.',
};

const serviceData = {
  name: 'Shopify Store Development',
  description:
    'Custom Shopify storefront engineering, theme speed optimization, app integrations, and conversion-focused checkout flows.',
  url: 'https://ziaflow.com/services/shopify',
  image: 'https://images.unsplash.com/photo-1556742049-0a67c5574f73?q=80&w=1200&auto=format&fit=crop',
};
---

<Layout metadata={metadata}>
  <ServiceSchema {...serviceData} />

  <Hero
    tagline="Shopify & E-Commerce Engineering"
    title="Custom Shopify Stores Built for High Conversion & Fast Load Times"
    subtitle="Turn product visitors into repeat buyers. We engineer bespoke Shopify themes and headless storefronts tailored for speed, intuitive checkout UX, and automated back-office inventory sync."
    actions={[
      {
        variant: 'primary',
        text: 'Request Shopify Store Audit',
        href: '#inquiry-form',
        icon: 'tabler:arrow-right',
      },
      {
        variant: 'secondary',
        text: 'Schedule Consultation',
        href: 'https://outlook.office.com/book/ZiaFlowIntake@ziaflow.com/?ismsaljsauthenabled',
        icon: 'tabler:calendar',
      },
    ]}
  />

  <Features
    tagline="Core Capabilities"
    title="How We Elevate Your Shopify Merchant Experience"
    subtitle="From single-brand direct-to-consumer launches to multi-channel B2B distributors."
    items={[
      {
        title: 'Custom Theme Engineering',
        description:
          'Bespoke Liquid templates built strictly to your brand guidelines without heavy multi-purpose marketplace bloat.',
        icon: 'tabler:shopping-cart',
      },
      {
        title: 'Speed & Mobile CRO Optimization',
        description:
          'Eliminate third-party app scripts that drag down mobile checkout speeds. We audit and streamline every tracking tag and asset.',
        icon: 'tabler:gauge',
      },
      {
        title: 'ERP & Fulfillment Integrations',
        description:
          'Automate inventory syncing, QuickBooks/NetSuite accounting hooks, and warehouse 3PL routing via custom private apps.',
        icon: 'tabler:arrows-exchange',
      },
      {
        title: 'Headless Commerce Architecture',
        description:
          'Pair the Shopify Storefront API with Astro or Next.js for lightning-fast catalog navigation and limitless design control.',
        icon: 'tabler:server',
      },
    ]}
  />

  <Steps
    tagline="Execution Process"
    title="From Concept to High-Volume Checkout"
    items={[
      {
        title: '1. Catalog & Conversion Strategy',
        description:
          'We evaluate your current SKU taxonomy, average order value (AOV), and cart drop-off funnels to plan high-impact upsell paths.',
        icon: 'tabler:chart-arrows',
      },
      {
        title: '2. Responsive Storefront Build',
        description:
          'We craft clean, pixel-perfect layouts optimized for thumb-friendly mobile purchases and frictionless 1-click payment methods.',
        icon: 'tabler:device-mobile',
      },
      {
        title: '3. Data & Customer Pipeline Sync',
        description:
          'Customer emails, abandoned carts, and purchase events are routed straight into Klaviyo, Customer.io, or your CRM.',
        icon: 'tabler:users',
      },
      {
        title: '4. QA & Production Go-Live',
        description:
          'Rigorous end-to-end checkout validation across credit cards, Apple Pay, Shop Pay, and PayPal before scaling ad traffic.',
        icon: 'tabler:check',
      },
    ]}
  />

  <FAQs
    tagline="Frequently Asked Questions"
    title="Common Questions About Shopify Development"
    classes={{ container: 'max-w-4xl' }}
    items={[
      {
        title: 'Can you migrate our store from WooCommerce or Magento to Shopify?',
        description:
          'Yes. We handle complete catalog, customer history, order data, and 301 URL redirect migrations with zero loss of SEO authority.',
      },
      {
        title: 'Do you help improve our Shopify store speed score?',
        description:
          'Yes. We audit app script execution, minify assets, lazy-load non-critical widgets, and refactor bloated theme code to elevate mobile speed.',
      },
      {
        title: 'Can you build custom private apps and backend webhooks?',
        description:
          'Yes. We engineer private Shopify apps connecting your store directly to custom ERP, warehouse management, and automated fulfillment workflows.',
      },
      {
        title: 'Do you provide ongoing Shopify maintenance and conversion optimization?',
        description:
          'We offer flexible month-to-month maintenance and ongoing A/B testing retainers to steadily improve average order value and checkout completion rates.',
      },
    ]}
  />

  <WidgetWrapper id="inquiry-form" containerClass="max-w-5xl mx-auto">
    <Headline
      tagline="Scale Your Store"
      title="Ready to Build or Modernize Your Shopify Store?"
      subtitle="Share your store goals or current site link for an honest architectural review."
    />
    <div
      class="mx-auto w-full max-w-2xl rounded-3xl border border-slate-200 bg-white p-6 shadow-xl dark:border-slate-800 dark:bg-slate-900/90 sm:p-10"
    >
      <QuickLeadForm />
    </div>
  </WidgetWrapper>
</Layout>
