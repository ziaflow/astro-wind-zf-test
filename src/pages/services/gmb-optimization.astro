---
import KairoServicePage from '@/components/services/kairo-service-page.astro';

export const prerender = true;
---

<KairoServicePage
  title="Google Business Profile Optimization Phoenix | ZiaFlow"
  description="Improve your local search visibility in Phoenix with Google Business Profile optimization, category alignment, and automated review requests."
  url="https://ziaflow.com/services/gmb-optimization"
  eyebrow="Local Map Pack · Phoenix & Valley-Wide"
  heroLines={['Improve local visibility in', 'the Google Map Pack.']}
  heroIntro="When Arizona customers search for a local contractor or service provider, the top 3 results in the Google Map Pack earn the vast majority of local calls. We tune your Google Business Profile categories, citations, and website links for local search visibility and direct phone calls."
  deliverables={[
    {
      title: 'Primary & Secondary Category Alignment',
      tag: 'Map Rank',
      description: 'Forensic competitor analysis across Phoenix metro zip codes to configure exact primary and secondary GBP categories and service catalogs.',
    },
    {
      title: 'UTM-Tagged Website & Booking Links',
      tag: 'Attribution',
      description: 'Dedicated tracking parameters on your profile website, appointment, and call actions so every Map Pack lead is attributed in Search Console and Supabase.',
    },
    {
      title: 'Automated Post-Job Review Velocity',
      tag: 'Trust Signal',
      description: 'Direct integration with your dispatch workflow to send automated SMS/email review requests right after service completion.',
    },
    {
      title: 'Structured Q&A, Services & Photo Geo-Relevance',
      tag: 'Entity Signals',
      description: 'Complete population of service descriptions, buyer FAQs, and authentic operational photography aligned with your website’s LocalBusiness schema.',
    },
  ]}
  processSteps={[
    { step: 'Step 1 · Audit', title: 'Map Grid & Category Check', description: 'We benchmark your current Map Pack visibility and category gaps across Phoenix.' },
    { step: 'Step 2 · Align', title: 'NAP & Schema Parity', description: 'We synchronize your GBP fields with your website’s LocalBusiness JSON-LD markup.' },
    { step: 'Step 3 · Automate', title: 'Review & Booking Wiring', description: 'We connect automated review requests and UTM-tracked booking links.' },
    { step: 'Step 4 · Grow', title: 'Ongoing Post & Q&A Cadence', description: 'Regular profile updates, review responses, and spam-listing defense.' },
  ]}
  faqs={[
    {
      question: 'Why isn’t our Google Business Profile showing up in the top 3 Map Pack?',
      answer: 'Map Pack rankings depend on three pillars: Relevance (exact primary/secondary categories and matching website schema), Prominence (consistent review velocity and local authority), and Proximity. Fixing mismatched categories and connecting your GBP to a fast, schema-rich service page often unlocks rapid movement.',
    },
    {
      question: 'How do you track calls and leads coming from our Google Business Profile?',
      answer: 'We configure UTM source/medium tags on your GBP website and booking links and integrate call tracking so every inquiry generated by Google Maps is recorded separately in your lead database.',
    },
  ]}
/>
