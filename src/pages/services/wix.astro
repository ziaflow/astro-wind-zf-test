---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import QuickLeadForm from '~/components/QuickLeadForm.astro';
import ServiceSchema from '~/components/seo/ServiceSchema.astro';

const metadata = {
  title: 'Wix Website Optimization, Redesign & Migration | ZiaFlow',
  description:
    'Wix Studio development, performance tuning, and professional migration services to high-speed modern platforms for growing businesses.',
};

const serviceData = {
  name: 'Wix Development & Migration Services',
  description:
    'Professional Wix Studio website design, Velo code customization, mobile speed optimization, and migration paths to custom modern frameworks.',
  url: 'https://ziaflow.com/services/wix',
  image: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=1200&auto=format&fit=crop',
};
---

<Layout metadata={metadata}>
  <ServiceSchema {...serviceData} />

  <Hero
    tagline="Wix & Wix Studio Engineering"
    title="Professional Wix Development, Speed Tuning & Platform Migrations"
    subtitle="Get the most out of your Wix investment, or cleanly migrate when your business outgrows closed website builders. We engineer custom Velo interactions, optimize mobile performance, or transition you to high-speed Astro stacks."
    actions={[
      {
        variant: 'primary',
        text: 'Request Wix Assessment',
        href: '#inquiry-form',
        icon: 'tabler:arrow-right',
      },
      {
        variant: 'secondary',
        text: 'Schedule Consultation',
        href: 'https://outlook.office.com/book/ZiaFlowIntake@ziaflow.com/?ismsaljsauthenabled',
        icon: 'tabler:calendar',
      },
    ]}
  />

  <Features
    tagline="Service Options"
    title="Tailored Wix Solutions Based on Your Growth Stage"
    subtitle="Whether you want to maximize your existing Wix site or transition to an unrestricted custom architecture."
    items={[
      {
        title: 'Wix Studio Design & Velo Code',
        description:
          'Advanced responsive layouts and custom JavaScript interactions using Wix Velo to connect database collections and external APIs.',
        icon: 'tabler:palette',
      },
      {
        title: 'Mobile Load Speed Optimization',
        description:
          'Audit heavy media assets, redundant apps, and animation layers to improve mobile responsiveness and user retention.',
        icon: 'tabler:gauge',
      },
      {
        title: 'Form & Lead Flow Repair',
        description:
          'Fix missed lead alerts and ensure every Wix form seamlessly transmits prospect details to your CRM or dispatch systems.',
        icon: 'tabler:send',
      },
      {
        title: 'Full Migration to Astro or React',
        description:
          'When outgrowing Wix’s monthly fees and script constraints, we recreate your design in clean Astro code with 10x faster speeds.',
        icon: 'tabler:transfer-in',
      },
    ]}
  />

  <Steps
    tagline="Evaluation Framework"
    title="How We Evaluate & Elevate Your Wix Site"
    items={[
      {
        title: '1. Platform & Performance Audit',
        description:
          'We inspect your site structure, app dependencies, Core Web Vitals, and organic search ranking health.',
        icon: 'tabler:search',
      },
      {
        title: '2. Strategy Alignment',
        description:
          'We determine whether optimizing your existing Wix setup or executing a clean migration to Astro best serves your ROI.',
        icon: 'tabler:compass',
      },
      {
        title: '3. Technical Execution',
        description:
          'Whether refactoring your Wix Studio components or engineering a new edge-hosted website, we ensure seamless delivery.',
        icon: 'tabler:code',
      },
      {
        title: '4. Testing & Search Protection',
        description:
          'Strict verification of forms, mobile layout breakpoints, analytics tracking, and URL redirect mapping.',
        icon: 'tabler:check',
      },
    ]}
  />

  <FAQs
    tagline="Common Questions"
    title="Frequently Asked Questions About Wix"
    classes={{ container: 'max-w-4xl' }}
    items={[
      {
        title: 'Why do businesses decide to migrate away from Wix?',
        description:
          'Wix is great for getting started quickly. However, growing companies often face limitations with mobile page speeds, vendor lock-in, recurring app subscription costs, and restricted technical SEO controls. Migrating to Astro gives you 100% code ownership, zero runtime overhead, and custom CRM connectivity.',
      },
      {
        title: 'Can we keep our existing website design if we migrate?',
        description:
          'Yes. We can faithfully reproduce your visual branding down to the pixel while replacing the underlying engine with ultra-fast modern code.',
      },
    ]}
  />

  <WidgetWrapper id="inquiry-form" containerClass="max-w-5xl mx-auto">
    <Headline
      tagline="Evaluate Your Wix Site"
      title="Ready to Optimize or Migrate Your Wix Website?"
      subtitle="Share your website URL and we will analyze your speed metrics and next steps."
    />
    <div class="mx-auto w-full max-w-2xl rounded-3xl border border-slate-200 bg-white p-6 shadow-xl dark:border-slate-800 dark:bg-slate-900/90 sm:p-10">
      <QuickLeadForm />
    </div>
  </WidgetWrapper>
</Layout>
