---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import QuickLeadForm from '~/components/QuickLeadForm.astro';
import ServiceSchema from '~/components/seo/ServiceSchema.astro';

const metadata = {
  title: 'WordPress Development, Maintenance & Modernization | ZiaFlow',
  description:
    'Custom WordPress theme development, security hardening, plugin consolidation, and modern headless migrations for Arizona businesses.',
};

const serviceData = {
  name: 'WordPress Development & Optimization',
  description:
    'High-performance custom WordPress builds, security hardening, speed optimization, and seamless migration paths.',
  url: 'https://ziaflow.com/services/wordpress',
  image: 'https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?q=80&w=1200&auto=format&fit=crop',
};
---

<Layout metadata={metadata}>
  <ServiceSchema {...serviceData} />

  <Hero
    tagline="WordPress Engineering"
    title="Custom WordPress Solutions Engineered for Stability, Speed & Security"
    subtitle="Break free from fragile page builders and 40+ plugin disasters. We build custom, lightweight WordPress themes and maintain existing installations with enterprise security and speed."
    actions={[
      {
        variant: 'primary',
        text: 'Request WordPress Audit',
        href: '#inquiry-form',
        icon: 'tabler:arrow-right',
      },
      {
        variant: 'secondary',
        text: 'Schedule Consultation',
        href: 'https://outlook.office.com/book/ZiaFlowIntake@ziaflow.com/?ismsaljsauthenabled',
        icon: 'tabler:calendar',
      },
    ]}
  />

  <Features
    tagline="Key Capabilities"
    title="How We Engineer Better WordPress Websites"
    subtitle="Tailored engineering for companies that rely on WordPress for content publishing and lead generation."
    items={[
      {
        title: 'Custom Block Themes (FSE)',
        description:
          'Native Gutenberg block development without relying on bloated third-party page builders like Elementor or Divi.',
        icon: 'tabler:brand-wordpress',
      },
      {
        title: 'Plugin Consolidation & Cleanup',
        description:
          'Replace dozens of redundant or outdated plugins with native PHP hooks and lightweight server-side functions.',
        icon: 'tabler:tool',
      },
      {
        title: 'Enterprise Security Hardening',
        description:
          'Automated malware scanning, Cloudflare WAF protection, database prefix isolation, and secure two-factor auth policies.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Headless WordPress Options',
        description:
          'Keep your WordPress admin for effortless editorial publishing while using Astro or React on the frontend for sub-second speeds.',
        icon: 'tabler:code',
      },
    ]}
  />

  <Steps
    tagline="WordPress Workflow"
    title="Our Stabilization & Optimization Roadmap"
    items={[
      {
        title: '1. Plugin & Code Audit',
        description:
          'We review your database, PHP error logs, and third-party plugins to isolate performance drags and security risks.',
        icon: 'tabler:search',
      },
      {
        title: '2. Caching & Server Modernization',
        description:
          'We configure Redis object caching, Cloudflare edge caching, and PHP OPcache on modern hosting (WP Engine, Kinsta, Cloudways).',
        icon: 'tabler:cpu',
      },
      {
        title: '3. Lead Intake & Form Routing',
        description:
          'Eliminate lost form submissions by replacing unreliable SMTP mailers with reliable API webhooks into your CRM.',
        icon: 'tabler:send',
      },
      {
        title: '4. Continuous Maintenance & Backups',
        description:
          'Daily offsite backups, staged plugin updates, and 24/7 uptime monitoring to ensure uninterrupted operations.',
        icon: 'tabler:check',
      },
    ]}
  />

  <FAQs
    tagline="Frequently Asked Questions"
    title="Common WordPress Questions"
    classes={{ container: 'max-w-4xl' }}
    items={[
      {
        title: 'Should we rebuild in WordPress or migrate to Astro?',
        description:
          'If your marketing team relies heavily on traditional editorial workflows and WooCommerce, an optimized WordPress build makes sense. If your priority is maximum Core Web Vitals speed, zero maintenance overhead, and custom CRM integrations, migrating to Astro is usually the smarter long-term investment.',
      },
      {
        title: 'Can you fix our slow, bloated WordPress site without rebuilding it?',
        description:
          'Yes. We regularly conduct deep performance optimizations—removing unused CSS/JS, consolidating plugins, compressing images, and setting up server-level caching to dramatically improve load times.',
      },
      {
        title: 'How do you handle WordPress security and malware prevention?',
        description:
          'We implement strict Cloudflare WAF firewalls, automated vulnerability patching, two-factor authentication, and isolated database backups.',
      },
      {
        title: 'Can you migrate our forms away from unreliable SMTP plugins?',
        description:
          'Yes. We replace fragile email plugins with direct REST API webhooks that instantly transmit lead inquiries to your CRM and notify your team.',
      },
    ]}
  />

  <WidgetWrapper id="inquiry-form" containerClass="max-w-5xl mx-auto">
    <Headline
      tagline="Fix Your WordPress"
      title="Ready to Upgrade or Stabilize Your WordPress Site?"
      subtitle="Send us your site URL and we will analyze your speed, plugin health, and upgrade path."
    />
    <div
      class="mx-auto w-full max-w-2xl rounded-3xl border border-slate-200 bg-white p-6 shadow-xl dark:border-slate-800 dark:bg-slate-900/90 sm:p-10"
    >
      <QuickLeadForm />
    </div>
  </WidgetWrapper>
</Layout>
