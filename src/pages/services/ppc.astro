---
import KairoServicePage from '@/components/services/kairo-service-page.astro';

export const prerender = true;
---

<KairoServicePage
  title="PPC Management in Phoenix | Google Ads | ZiaFlow"
  description="Plan, launch, and measure paid search campaigns for Phoenix businesses with clear targeting, landing pages, and conversion tracking."
  url="https://ziaflow.com/services/ppc"
  eyebrow="Paid Search & Campaign Measurement"
  overview="Set campaign goals, locations, budgets, landing pages, and inquiry tracking before paid search goes live."
  heroLines={['Paid search with', 'clear measurement.']}
  heroIntro="Paid search can reach people actively looking for a service. ZiaFlow helps Phoenix businesses plan and manage search campaigns with defined locations, budgets, landing pages, and conversion events."
  deliverablesTitle="A campaign built around agreed goals."
  deliverablesIntro="We clarify what counts as a useful inquiry and how it will be measured before launch. Scope depends on your account, market, and budget."
  deliverables={[
    {
      title: 'Account and campaign review',
      tag: 'Audit',
      description: 'Review campaign structure, search terms, targeting, ads, and existing conversion actions where account access is available.',
    },
    {
      title: 'Keyword and location planning',
      tag: 'Targeting',
      description: 'Organize search themes and service areas around the work you want to promote and the customers you can serve.',
    },
    {
      title: 'Ad and landing page alignment',
      tag: 'Experience',
      description: 'Make the ad message and destination page consistent, with a clear service description and contact option.',
    },
    {
      title: 'Conversion tracking review',
      tag: 'Measurement',
      description: 'Configure or review inquiry events for agreed forms and calls, and document what each event represents.',
    },
    {
      title: 'Search term refinement',
      tag: 'Optimization',
      description: 'Review search terms and exclusions to reduce irrelevant traffic and keep targeting aligned with campaign goals.',
    },
    {
      title: 'Plain-language reporting',
      tag: 'Reporting',
      description: 'Summarize spend, campaign activity, and recorded inquiries with known tracking limitations clearly identified.',
    },
  ]}
  processSteps={[
    { step: 'Review', title: 'Assess the account', description: 'Check existing setup, goals, landing pages, tracking, and available history.' },
    { step: 'Plan', title: 'Agree on targeting and budget', description: 'Define service areas, campaign themes, budget limits, and useful inquiry criteria.' },
    { step: 'Launch', title: 'Set up and verify', description: 'Build the agreed campaigns and check destination pages and conversion events.' },
    { step: 'Improve', title: 'Review and refine', description: 'Use account and inquiry data to guide changes to targeting, ads, and landing pages.' },
  ]}
  faqs={[
    {
      question: 'How quickly can a PPC campaign start?',
      answer: 'Launch timing depends on account access, campaign scope, landing-page readiness, and tracking. We confirm the required setup and approval steps before launch.',
    },
    {
      question: 'Do you guarantee a certain cost per lead?',
      answer: 'No. Costs and inquiry volume depend on competition, budget, offer, location, and follow-up. We agree on how performance will be measured and report the available data.',
    },
    {
      question: 'Should we use paid search or Local Services Ads?',
      answer: 'They serve different campaign formats and eligibility requirements. We can review your services, market, and account setup to determine which options are worth considering.',
    },
  ]}
  relatedLinks={[
    { label: 'Conversion optimization', href: '/services/cro', category: 'Related service' },
    { label: 'Lead capture and follow-up', href: '/services/automation', category: 'Related service' },
    { label: 'Website development services', href: '/services/web-development', category: 'Related service' },
  ]}
/>
