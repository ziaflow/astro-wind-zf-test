---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import ServiceSchema from '~/components/seo/ServiceSchema.astro';

const metadata = {
  title: 'Marketing Automation Phoenix & Arizona SMBs | ZiaFlow',
  description:
    'Connect website inquiries, CRM records, scheduling, and follow-up. Reduce repetitive handoffs with reliable workflow automation for Arizona service businesses.',
};

const serviceData = {
  name: 'Lead & Marketing Automation for Arizona SMBs',
  description:
    'Connect website inquiries, CRM records, scheduling, and follow-up. Practical automation systems engineered for Arizona service businesses.',
  url: 'https://ziaflow.com/services/automation',
  image: 'https://ziaflow.com/assets/images/automation-hero.jpg',
};
---

<Layout metadata={metadata}>
  <ServiceSchema {...serviceData} />

  <Hero
    tagline="Lead & Workflow Automation · Arizona"
    title="Marketing Automation for Phoenix Service Businesses"
    subtitle="Stop losing qualified inquiries to slow manual triage. We connect your website forms directly to your CRM, team notifications, and calendar scheduling—turning fragmented inquiries into dependable intake workflows."
    actions={[
      {
        variant: 'primary',
        text: 'Discuss Your Automation Project',
        href: 'https://outlook.office.com/book/ZiaFlowIntake@ziaflow.com/?ismsaljsauthenabled',
        icon: 'tabler:calendar',
      },
    ]}
  />

  <Features
    title="Core Intake & Workflow Touchpoints"
    items={[
      {
        title: 'Instant Lead Notification & Intake',
        description:
          'Immediately route web inquiries via transactional notifications to staff while acknowledging customer inquiries.',
        icon: 'tabler:bell-ringing',
      },
      {
        title: 'CRM & Pipeline Synchronization',
        description:
          'Automatically populate customer records into Supabase, HubSpot, or custom CRMs with zero manual copy-pasting.',
        icon: 'tabler:database-import',
      },
      {
        title: 'Automated Calendar Scheduling',
        description:
          'Route qualified prospects straight into Microsoft Bookings or Outlook calendars with pre-qualification answers attached.',
        icon: 'tabler:calendar-event',
      },
      {
        title: 'Human Review & Exception Handling',
        description:
          'Automation handles notifications and routing, while custom quotes and high-touch scoping remain strictly human-led.',
        icon: 'tabler:user-check',
      },
    ]}
  />

  <CallToAction
    title="Ready to automate your growth?"
    actions={[
      {
        variant: 'primary',
        text: 'Book Consultation',
        href: 'https://outlook.office.com/book/ZiaFlowIntake@ziaflow.com/?ismsaljsauthenabled',
      },
    ]}
  />
</Layout>
