---
import KairoServicePage from '@/components/services/kairo-service-page.astro';

export const prerender = true;
---

<KairoServicePage
  title="Business Automation in Phoenix | ZiaFlow"
  description="Connect website inquiries, CRM records, scheduling, and follow-up with practical business automation for Phoenix and Arizona service businesses."
  url="https://ziaflow.com/services/automation"
  eyebrow="Lead Capture & Follow-Up Sprint"
  overview="A fixed-scope engagement to map agreed inquiry sources, improve capture and routing, and give your team a clear process for follow-up."
  heroLines={['Keep customer inquiries', 'moving to follow-up.']}
  heroIntro="A new inquiry can arrive by phone, website form, email, or ad. ZiaFlow helps Arizona service businesses connect those entry points to the tools and people responsible for responding."
  deliverablesTitle="A defined scope for inquiry handling."
  deliverablesIntro="We agree on sources, integrations, and acceptance criteria before implementation. The standard Sprint covers up to three inquiry sources."
  deliverables={[
    {
      title: 'Inquiry source review',
      tag: 'Discovery',
      description: 'Map up to three agreed sources, such as a website form, primary call route, or advertising inquiry endpoint, and identify handoff gaps.',
    },
    {
      title: 'Capture and receipt records',
      tag: 'Capture',
      description: 'Configure validation and a record of accepted inquiries, with an agreed process for identifying and recovering from delivery failures.',
    },
    {
      title: 'Customer acknowledgement',
      tag: 'Follow-up',
      description: 'Set up an approved email or text acknowledgement that explains when the team is expected to respond.',
    },
    {
      title: 'Staff routing and ownership',
      tag: 'Handoff',
      description: 'Route inquiry details to the agreed staff member or team, with a clear next action for follow-up.',
    },
    {
      title: 'Supported system connection',
      tag: 'Integration',
      description: 'Connect an agreed CRM, intake, or scheduling tool where access and supported integration methods allow.',
    },
    {
      title: 'Operator runbook',
      tag: 'Handover',
      description: 'Document daily triage, exception handling, manual recovery steps, and client responsibilities.',
    },
  ]}
  processSteps={[
    {
      step: 'Scope',
      title: 'Map inquiry paths',
      description: 'Inventory the agreed forms and endpoints, confirm access, and document current routing and ownership.',
    },
    {
      step: 'Build',
      title: 'Configure capture and routing',
      description: 'Set up the agreed receipt, notification, and system handoffs with clear ownership.',
    },
    {
      step: 'Verify',
      title: 'Test the full journey',
      description: 'Run labeled test inquiries to check validation, delivery, duplicate handling, and record creation.',
    },
    {
      step: 'Handover',
      title: 'Review the runbook',
      description: 'Walk through the operating steps and recovery procedure with your designated staff owner.',
    },
  ]}
  faqs={[
    {
      question: 'What is included in the Lead Capture & Follow-Up Sprint?',
      answer: 'The standard scope covers up to three agreed inquiry sources, capture and routing setup, an approved prospect acknowledgement, staff ownership, end-to-end tests, and an operator runbook. Additional systems are scoped separately.',
    },
    {
      question: 'Does the Sprint guarantee more booked jobs?',
      answer: 'No. Bookings depend on customer fit, pricing, availability, and staff follow-through. The Sprint focuses on the agreed intake process: accepted inquiries are recorded, assigned an owner, given a next action, and tracked to a known status.',
    },
    {
      question: 'What do you need from our team?',
      answer: 'Your team provides timely administrative access, names the person responsible for inquiry triage, and takes part in the kickoff and runbook handover.',
    },
    {
      question: 'What is outside the Sprint?',
      answer: 'The Sprint does not include advertising spend, third-party subscription fees, custom mobile apps, or outbound cold outreach. Any additional integrations are scoped before work begins.',
    },
  ]}
  relatedLinks={[
    { label: 'Website conversion checklist', href: '/website-conversion-checklist-for-phoenix-businesses', category: 'Checklist' },
    { label: 'Web development services', href: '/services/web-development', category: 'Related service' },
    { label: 'SEO services', href: '/services/seo', category: 'Related service' },
  ]}
/>
