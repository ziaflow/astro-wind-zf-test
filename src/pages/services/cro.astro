---
import KairoServicePage from '@/components/services/kairo-service-page.astro';

export const prerender = true;
---

<KairoServicePage
  title="Conversion Rate Optimization in Phoenix | ZiaFlow"
  description="Find and fix friction in your Phoenix website’s contact paths, forms, calls to action, and measurement."
  url="https://ziaflow.com/services/cro"
  eyebrow="Conversion Rate Optimization"
  overview="Review what visitors see and do, prioritize practical changes, and measure the contact actions your site can reliably track."
  heroLines={['Make it easier', 'to contact you.']}
  heroIntro="If visitors reach your site but don’t take the next step, unclear messaging, a difficult form, or a confusing contact path may be getting in the way. ZiaFlow reviews those paths and helps prioritize practical improvements."
  deliverablesTitle="Improve the path from visit to inquiry."
  deliverablesIntro="We start with the available analytics and the customer journey. Recommendations depend on traffic, tracking quality, and the pages in scope."
  deliverables={[
    {
      title: 'Contact path review',
      tag: 'Journey',
      description: 'Review how visitors move from service pages to calls, forms, email, or scheduling links on key pages.',
    },
    {
      title: 'Form usability checks',
      tag: 'Forms',
      description: 'Check form clarity, field requirements, validation messages, mobile behavior, and what happens after submission.',
    },
    {
      title: 'Page messaging review',
      tag: 'Content',
      description: 'Look for unclear service descriptions, missing next steps, and gaps between the page promise and contact options.',
    },
    {
      title: 'Behavior and analytics review',
      tag: 'Evidence',
      description: 'Use available analytics or session behavior data to identify questions for investigation, while accounting for limited sample sizes.',
    },
    {
      title: 'Prioritized improvement plan',
      tag: 'Recommendations',
      description: 'Document observed issues, recommended changes, expected effort, and a way to review each change.',
    },
    {
      title: 'Measurement setup',
      tag: 'Tracking',
      description: 'Review or configure agreed events for form submissions, calls, and other contact actions.',
    },
  ]}
  processSteps={[
    { step: 'Inspect', title: 'Review key pages', description: 'Walk through the main visitor paths on desktop and mobile and review available data.' },
    { step: 'Prioritize', title: 'Document friction', description: 'Separate confirmed usability issues from hypotheses and choose the first practical fixes.' },
    { step: 'Improve', title: 'Make agreed changes', description: 'Update page content, forms, or contact paths within the approved scope.' },
    { step: 'Measure', title: 'Review the signals', description: 'Check tracked contact actions and note limitations before drawing conclusions.' },
  ]}
  faqs={[
    {
      question: 'Do we need high traffic for conversion work?',
      answer: 'No. Functional issues and confusing contact paths can be reviewed at any traffic level. Small samples do limit what can be concluded from behavioral patterns or experiments.',
    },
    {
      question: 'Do you guarantee a conversion increase?',
      answer: 'No. We identify issues, make agreed changes, and review available measurement. Results depend on visitors, offer, market conditions, and tracking quality.',
    },
    {
      question: 'Can you review forms that connect to our CRM?',
      answer: 'Yes, when access is available. We can map the visitor experience through form submission and review the handoff to the next system in scope.',
    },
  ]}
  relatedLinks={[
    { label: 'Web development services', href: '/services/web-development', category: 'Related service' },
    { label: 'Lead capture and follow-up', href: '/services/automation', category: 'Related service' },
    { label: 'SEO services', href: '/services/seo', category: 'Related service' },
  ]}
/>
