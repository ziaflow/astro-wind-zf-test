---
import KairoServicePage from '@/components/services/kairo-service-page.astro';

export const prerender = true;
---

<KairoServicePage
  title="Cloud Solutions and Integrations in Phoenix | ZiaFlow"
  description="Connect websites, applications, and business tools with cloud and integration work scoped to your systems and operating needs."
  url="https://ziaflow.com/services/cloud"
  eyebrow="Cloud Systems & Integrations"
  overview="Review your current systems and requirements, then scope a practical way to connect services, data, and workflows."
  heroLines={['Connect the systems', 'your team relies on.']}
  heroIntro="When business tools don’t share information cleanly, staff may need to re-enter data or rely on manual workarounds. ZiaFlow helps Arizona businesses assess and connect websites, applications, and cloud services around a defined workflow."
  deliverablesTitle="Cloud work scoped to your requirements."
  deliverablesIntro="The right approach depends on the systems you already use, the information involved, and who will maintain the connection."
  deliverables={[
    {
      title: 'Current system review',
      tag: 'Discovery',
      description: 'Document the services, data, access, and handoffs involved in the workflow you want to improve.',
    },
    {
      title: 'Application connections',
      tag: 'Integrations',
      description: 'Connect supported tools through available APIs, webhooks, or other documented integration methods.',
    },
    {
      title: 'Data flow planning',
      tag: 'Data',
      description: 'Define what information moves between systems, when it moves, and how the team can identify an error.',
    },
    {
      title: 'Hosting and deployment review',
      tag: 'Infrastructure',
      description: 'Review hosting and deployment options for the website, application, or integration within the project scope.',
    },
    {
      title: 'Access and responsibilities',
      tag: 'Operations',
      description: 'Document required access, system ownership, and the responsibilities needed to maintain the solution.',
    },
    {
      title: 'Handover documentation',
      tag: 'Handover',
      description: 'Provide a practical reference for the agreed workflow, its dependencies, and known limitations.',
    },
  ]}
  processSteps={[
    { step: 'Understand', title: 'Map systems and needs', description: 'Review the current tools, users, data, and workflow requirements.' },
    { step: 'Scope', title: 'Choose an approach', description: 'Agree on integration boundaries, access, acceptance criteria, and support ownership.' },
    { step: 'Implement', title: 'Build the connection', description: 'Configure the approved cloud or application changes within the agreed scope.' },
    { step: 'Review', title: 'Verify and document', description: 'Check the intended data flow and provide a handover with operating notes.' },
  ]}
  faqs={[
    {
      question: 'Can you work with our existing cloud tools?',
      answer: 'Often, yes. We first confirm the services, access, technical constraints, and integration methods available for your setup.',
    },
    {
      question: 'Do we need to replace our CRM or other software?',
      answer: 'Not necessarily. The first step is to understand the workflow and see whether existing systems can be connected in a practical and supportable way.',
    },
    {
      question: 'Do you provide ongoing cloud support?',
      answer: 'Ongoing monitoring or maintenance depends on the project and is agreed separately. The handover documents the operating responsibilities for the work delivered.',
    },
  ]}
  relatedLinks={[
    { label: 'Custom software services', href: '/services/software', category: 'Related service' },
    { label: 'Lead capture and follow-up', href: '/services/automation', category: 'Related service' },
    { label: 'Web development services', href: '/services/web-development', category: 'Related service' },
  ]}
/>
