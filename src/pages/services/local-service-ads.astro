---
import Page from '~/components/expansion/ExpansionPage.astro';
import type { ExpansionPage } from '~/data/expansion-pages';
export const prerender = true;
const page: ExpansionPage = {
  kind: 'service',
  slug: 'local-service-ads',
  path: '/services/local-service-ads',
  title: 'Google Local Services Ads for Arizona Businesses | ZiaFlow',
  description:
    'Review Local Services Ads eligibility, verification requirements, service-area settings, and inquiry handling for your Arizona business.',
  heading: 'Local Services Ads. A working handoff.',
  intro:
    'Local Services Ads can connect eligible businesses with service inquiries. We start with the actual category, operating territory, account requirements, and the team responsible for responding.',
  sections: [
    {
      heading: 'Verify eligibility before promising placement',
      body: 'Availability and screening requirements vary by business category and location. Google makes verification decisions. A marketing engagement does not guarantee approval, a badge, or a particular ad position.',
      items: [
        'Check current category and geographic eligibility in the account.',
        'Review the screening information and documentation Google requests.',
        'Keep business details, hours, and services consistent with actual operations.',
      ],
    },
    {
      heading: 'Align the territory with the team',
      body: 'Service areas and job types should reflect work the business can take on. The account configuration and inquiry workflow are reviewed together so a campaign does not promise coverage the dispatcher cannot support.',
      items: [
        'Review location and service settings against actual coverage.',
        'Assign ownership for calls, messages, and after-hours requests.',
        'Test the handoff to the approved CRM or scheduling workflow.',
      ],
    },
    {
      heading: 'Review lead quality without promising credits',
      body: 'Google assesses lead charges and credits under its current policies, with category and regional exclusions. We review the available account evidence and settings; we do not promise refunds for unwanted inquiries.',
      items: [
        'Separate received inquiries, charged leads, and booked work.',
        'Review available lead-quality feedback and billing records.',
        'Keep healthcare and other restricted-category workflows within their supported account features.',
      ],
    },
  ],
  faqs: [
    {
      question: 'Is Google Guaranteed still the right badge name?',
      answer:
        'Google’s current Local Services documentation describes the Google Verified badge. Eligibility and screening are controlled by Google; using the product does not make ZiaFlow a Google Partner.',
    },
    {
      question: 'Can every doctor, lawyer, or contractor run Local Services Ads?',
      answer:
        'Do not assume universal eligibility. Check the current business category, location, and verification requirements before planning a launch.',
    },
    {
      question: 'Can you guarantee lead credits?',
      answer:
        'No. Google applies its current lead-credit policies and exclusions. Unwanted inquiries are a reason to review job types, territory, and account feedback, not promise a refund.',
    },
  ],
  related: [
    { label: 'Home-service inquiry workflows', href: '/industries/home-services' },
    { label: 'PPC audit', href: '/services/ppc-audit' },
    { label: 'CRM setup', href: '/services/crm' },
  ],
};
---

<Page page={page} />
