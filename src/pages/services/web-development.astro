---
import KairoServicePage from '@/components/services/kairo-service-page.astro';

export const prerender = true;
---

<KairoServicePage
  title="Web Development in Phoenix | ZiaFlow"
  description="Build or improve a Phoenix business website with clear service pages, contact paths, technical SEO foundations, and useful integrations."
  url="https://ziaflow.com/services/web-development"
  eyebrow="Website Design & Development"
  overview="Plan the pages, platform, integrations, and launch requirements around what your business and customers need."
  heroLines={['A website built', 'around the next step.']}
  heroIntro="Your website should help customers understand your services and contact your business. ZiaFlow builds and improves websites for Arizona businesses, with attention to page structure, mobile usability, search basics, and clear contact paths."
  deliverablesTitle="The right website for the job."
  deliverablesIntro="We scope the platform and features to fit your content, functionality, budget, and ongoing maintenance needs."
  deliverables={[
    {
      title: 'Page and content planning',
      tag: 'Planning',
      description: 'Map the pages customers need, the information each page should include, and the actions visitors should be able to take.',
    },
    {
      title: 'Website design and development',
      tag: 'Build',
      description: 'Create responsive pages and reusable components that support the agreed visual direction and content structure.',
    },
    {
      title: 'Forms and business integrations',
      tag: 'Connections',
      description: 'Connect agreed contact forms, scheduling tools, analytics, or CRM handoffs based on available access and supported methods.',
    },
    {
      title: 'Technical search foundations',
      tag: 'SEO',
      description: 'Set page titles, descriptions, canonical URLs, structured data where appropriate, and sitemap behavior.',
    },
    {
      title: 'Content migration and redirects',
      tag: 'Rebuilds',
      description: 'For a rebuild, inventory priority URLs and plan content transfer and redirects for changed paths.',
    },
    {
      title: 'Launch review',
      tag: 'Handover',
      description: 'Review links, forms, mobile layouts, and agreed page details before handing off the site.',
    },
  ]}
  processSteps={[
    { step: 'Plan', title: 'Inventory pages and needs', description: 'Review the current site, content, contact paths, and required features.' },
    { step: 'Design', title: 'Shape the page experience', description: 'Agree on the visual direction, page structure, content priorities, and calls to action.' },
    { step: 'Build', title: 'Develop and connect', description: 'Implement the pages and agreed integrations on the selected platform.' },
    { step: 'Review', title: 'Check before launch', description: 'Review key URLs, links, forms, mobile layouts, and migration requirements.' },
  ]}
  faqs={[
    {
      question: 'Which platform should we use?',
      answer: 'The best platform depends on how often you update content, the features you need, and who will maintain the site. We review those requirements before recommending a build approach.',
    },
    {
      question: 'Can you rebuild a site without changing its important URLs?',
      answer: 'We can inventory current URLs and plan to preserve them where practical. If a URL must change, we document the redirect and verify the destination.',
    },
    {
      question: 'Can the website connect to our CRM or scheduling tool?',
      answer: 'Often, yes. We confirm the specific service, access, and integration method during scoping, then include supported connections in the agreed deliverables.',
    },
  ]}
  relatedLinks={[
    { label: 'SEO services', href: '/services/seo', category: 'Related service' },
    { label: 'Conversion optimization', href: '/services/cro', category: 'Related service' },
    { label: 'Lead capture and follow-up', href: '/services/automation', category: 'Related service' },
  ]}
/>
