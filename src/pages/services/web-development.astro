---
import KairoServicePage from '@/components/services/kairo-service-page.astro';

export const prerender = true;
---

<KairoServicePage
  title="Phoenix Web Development Agency | Fast Websites | ZiaFlow"
  description="High-speed Astro web development for Arizona service businesses. Clean semantic code connected to reliable inquiry capture and follow-up."
  url="https://ziaflow.com/services/web-development"
  eyebrow="Web Engineering · Fast Astro & Supabase"
  heroLines={['Fast websites wired', 'for real inquiries.']}
  heroIntro="Slow pages and fragile form plugins lose prospective customers before they ever make contact. We build clean, high-performance websites on Astro and edge infrastructure, connected directly to a verified intake and follow-up process."
  deliverables={[
    {
      title: 'Sub-Second Astro Architecture',
      tag: 'Performance',
      description:
        'Clean HTML delivery without unnecessary client JavaScript, ensuring fast mobile load times and solid Core Web Vitals on cellular connections.',
    },
    {
      title: 'Tested Intake Form Integration',
      tag: 'Reliability',
      description:
        'Contact and quote forms route directly to server-side receipt logging with spam defense before firing alerts or CRM webhooks.',
    },
    {
      title: 'Mobile-First Service Layouts',
      tag: 'Layout',
      description:
        'Clear service descriptions, prominent phone numbers, straightforward calls to action, and accessible touch targets.',
    },
    {
      title: 'Technical SEO & Structured Schema',
      tag: 'Search Ready',
      description:
        'Self-referencing canonicals, automated XML sitemaps, OpenGraph cards, and schema markup aligned with your business profile.',
    },
    {
      title: 'URL & Redirect Mapping',
      tag: 'Migration',
      description:
        'When rebuilding an existing site, we map legacy URLs and article paths to preserve established search equity.',
    },
    {
      title: 'Isolated Preview Environments',
      tag: 'Quality Control',
      description:
        'Every update is deployed to an isolated Vercel preview URL for verification before deploying to your production domain.',
    },
  ]}
  processSteps={[
    {
      step: 'Step 1 · Discovery',
      title: 'URL & Page Inventory',
      description:
        'We map existing pages, ranking queries, and intake paths to plan a clean structure without losing existing traffic.',
    },
    {
      step: 'Step 2 · Design & Content',
      title: 'Direct Layouts & Copy',
      description:
        'We structure clear, service-specific pages focused on answering prospective buyer questions and establishing local fit.',
    },
    {
      step: 'Step 3 · Development',
      title: 'Astro Build & Form Wiring',
      description:
        'We code the frontend, optimize visual assets, and connect forms to verified database storage and notification hooks.',
    },
    {
      step: 'Step 4 · Verification',
      title: 'QA & Safe Cutover',
      description: 'After link checking, mobile review, and test form submissions, we point DNS with zero downtime.',
    },
  ]}
  faqs={[
    {
      question: 'Why build with Astro instead of a template builder?',
      answer:
        'Astro pre-renders static HTML at the edge, eliminating heavy database overhead on every page view. This delivers faster page speeds, lower hosting costs, and fewer plugin vulnerabilities.',
    },
    {
      question: 'Will rebuilding our website affect current search rankings?',
      answer:
        'We inventory existing ranking URLs and configure 301 redirects for any altered paths, preserving search equity while improving page speed and mobile usability.',
    },
    {
      question: 'How do forms connect to our existing email or CRM?',
      answer:
        'Forms submit to server endpoints that log an atomic receipt in Supabase, then trigger webhooks to your CRM or email provider. If a webhook fails, the record is saved for manual recovery.',
    },
  ]}
/>
