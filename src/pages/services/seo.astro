---
import KairoServicePage from '@/components/services/kairo-service-page.astro';

export const prerender = true;
---

<KairoServicePage
  title="SEO Services in Phoenix for Service Businesses | ZiaFlow"
  description="Improve technical SEO, local service pages, and search measurement for Phoenix and Arizona service businesses."
  url="https://ziaflow.com/services/seo"
  eyebrow="Technical SEO & Local Search"
  overview="Prioritize website and content improvements around real search demand, accurate business information, and measurable inquiry paths."
  heroLines={['Make your services', 'easier to find.']}
  heroIntro="Search visibility starts with a website that explains what you do, where you work, and how customers can contact you. ZiaFlow helps Phoenix-area service businesses improve the pages and technical foundations that support local search."
  deliverablesTitle="SEO work grounded in your site and market."
  deliverablesIntro="We review the current site and available Search Console data, then agree on priorities based on relevance, effort, and your service areas."
  deliverables={[
    {
      title: 'Search query and page review',
      tag: 'Search Console',
      description: 'Review available search queries, landing pages, and click-through patterns to identify useful page improvements.',
    },
    {
      title: 'Technical SEO checks',
      tag: 'Site health',
      description: 'Review indexability, canonical URLs, redirects, internal links, sitemap coverage, and page performance.',
    },
    {
      title: 'Service page improvements',
      tag: 'Content',
      description: 'Clarify service descriptions, customer questions, location relevance, page titles, and calls to action.',
    },
    {
      title: 'Accurate structured data',
      tag: 'Structured data',
      description: 'Add or correct relevant business and service markup using information that can be verified on the site.',
    },
    {
      title: 'Internal linking',
      tag: 'Site structure',
      description: 'Connect related service pages and educational resources so visitors and search engines can navigate the site.',
    },
    {
      title: 'Measurement plan',
      tag: 'Reporting',
      description: 'Define which search and inquiry indicators to review and how to distinguish test activity from genuine inquiries.',
    },
  ]}
  processSteps={[
    {
      step: 'Baseline',
      title: 'Review search and site data',
      description: 'Inspect available Search Console information, important URLs, metadata, and technical site behavior.',
    },
    {
      step: 'Prioritize',
      title: 'Choose the work that matters',
      description: 'Rank page and technical changes around customer intent, service coverage, and implementation effort.',
    },
    {
      step: 'Improve',
      title: 'Update pages and foundations',
      description: 'Make the agreed content, internal-linking, metadata, and technical updates.',
    },
    {
      step: 'Review',
      title: 'Track changes over time',
      description: 'Compare search visibility and confirmed inquiry signals across appropriate reporting periods.',
    },
  ]}
  faqs={[
    {
      question: 'How does ZiaFlow approach local SEO?',
      answer: 'We start with your target services and service areas, review the pages that represent them, and check the technical signals that help search engines find and interpret those pages.',
    },
    {
      question: 'How soon will SEO changes affect search results?',
      answer: 'Timing varies with competition, site history, and how quickly search engines recrawl pages. We use longer reporting periods to assess meaningful changes instead of treating daily movement as a result.',
    },
    {
      question: 'Do you guarantee first-page rankings?',
      answer: 'No. Search rankings depend on factors outside any provider’s control. We define the work, establish a baseline, and report on observable changes.',
    },
  ]}
  relatedLinks={[
    { label: 'Website development services', href: '/services/web-development', category: 'Related service' },
    { label: 'Conversion optimization', href: '/services/cro', category: 'Related service' },
    { label: 'Website conversion checklist', href: '/website-conversion-checklist-for-phoenix-businesses', category: 'Checklist' },
  ]}
/>
