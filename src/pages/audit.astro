---
import Layout from '@/layouts/layout.astro';
import PageHero from '@/components/shared/page-hero.astro';
import AuditSection from '@/components/home/audit-section.astro';
import RoiCalculator from '@/components/home/roi-calculator.astro';
import Proof from '@/components/home/proof.astro';
import Faq from '@/components/pricing/faq.astro';
import Cta from '@/components/shared/cta.astro';

export const prerender = true;
---

<Layout
  title="Free 48-Hour Website & Lead Capture Audit | ZiaFlow"
  description="Claim your free 10-minute forensic video audit and readiness score. Our Phoenix team reviews your site speed, SEO, and lead capture leaks in 48 hours."
>
  <PageHero
    lines={['Find exactly where', 'your site leaks leads.']}
    accent={1}
    intro="Use our interactive 8-point readiness diagnostic below, model your recoverable revenue, and claim your custom 10-minute forensic video audit from our Phoenix engineering team."
  />

  <!-- Interactive 8-Point Lead Capture & Conversion Diagnostic Tool -->
  <section class="shell pb-20 md:pb-28" aria-labelledby="diagnostic-title">
    <div class="rounded-2xl border border-line bg-ink-2/80 p-6 sm:p-10 md:p-12">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-7">
          <span class="inline-flex items-center gap-2 rounded-full border border-line bg-ink px-3 py-1 text-xs font-mono uppercase tracking-wider text-signal mb-4">
            <span class="size-1.5 rounded-full bg-signal"></span>
            60-Second Self-Assessment
          </span>
          <h2 id="diagnostic-title" class="font-display text-2xl sm:text-3xl font-bold text-bone">
            Lead Capture & Conversion Readiness Checklist
          </h2>
          <p class="mt-2 text-sm text-mute leading-relaxed">
            Check each item that is currently verified and true for your business website today:
          </p>

          <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2" id="audit-checklist">
            {[
              { points: 15, label: 'Mobile page loads in under 2.0 seconds on 4G' },
              { points: 15, label: 'Click-to-call phone number is sticky in mobile header' },
              { points: 15, label: 'Every form submission writes to a backup database before emailing' },
              { points: 15, label: 'New inquiries receive an automated SMS/email reply in <60 seconds' },
              { points: 10, label: 'Every inquiry is automatically assigned a named staff owner' },
              { points: 10, label: 'Missed phone calls trigger an automatic text-back to the caller' },
              { points: 10, label: 'Google Business Profile & Local Service Ads sync directly to CRM' },
              { points: 10, label: 'Completed jobs trigger an automated Google review request' },
            ].map((item, idx) => (
              <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-line bg-ink p-4 transition-colors hover:border-bone/50">
                <input
                  type="checkbox"
                  data-audit-check
                  data-points={item.points}
                  data-item-label={item.label}
                  checked={idx < 2}
                  class="mt-1 size-4 accent-[#A22A36] rounded cursor-pointer"
                />
                <span class="text-xs sm:text-sm text-bone leading-snug">{item.label}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Score Card -->
        <div class="lg:col-span-5 rounded-2xl border border-line-strong bg-ink p-8 text-center flex flex-col justify-between">
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-mute">Your Current Pipeline Readiness</p>
            <p id="audit-score-val" class="mt-4 font-display text-6xl font-extrabold text-signal">
              30<span class="text-2xl text-mute">/100</span>
            </p>
            <p id="audit-score-badge" class="mt-3 inline-block rounded-full bg-signal/15 px-3 py-1 font-mono text-xs uppercase text-signal">
              High Lead-Leak Risk (6 Gaps Found)
            </p>
            <p id="audit-score-desc" class="mt-4 text-xs text-mute leading-relaxed">
              Unmonitored forms, delayed follow-up, or missing call text-backs mean paid and organic visitors are likely booking competitors before your team responds.
            </p>
          </div>

          <a
            href="#audit"
            id="audit-score-cta"
            class="mt-8 inline-flex h-12 w-full items-center justify-center rounded-full bg-signal px-6 text-sm font-semibold text-bone hover:bg-signal-dark transition-colors"
          >
            Send My Gaps to ZiaFlow for Free Video Audit →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Embedded Forensic Audit Form Section -->
  <AuditSection />

  <!-- Interactive Lost Revenue Calculator -->
  <RoiCalculator />

  <!-- Operator Proof & FAQs -->
  <Proof />
  <Faq />
  <Cta />
</Layout>

<script is:inline>
  (function () {
    function initChecklist() {
      const checks = Array.from(document.querySelectorAll('[data-audit-check]'));
      const scoreVal = document.getElementById('audit-score-val');
      const scoreBadge = document.getElementById('audit-score-badge');
      const scoreDesc = document.getElementById('audit-score-desc');
      if (!checks.length || !scoreVal) return;

      function recalc() {
        let score = 0;
        const missing = [];
        checks.forEach((c) => {
          if (c.checked) {
            score += Number(c.getAttribute('data-points') || 10);
          } else {
            missing.push(c.getAttribute('data-item-label'));
          }
        });

        scoreVal.innerHTML = score + '<span class="text-2xl text-mute">/100</span>';
        if (score >= 80) {
          scoreVal.className = 'mt-4 font-display text-6xl font-extrabold text-emerald-400';
          if (scoreBadge) {
            scoreBadge.textContent = 'Strong Foundation (' + missing.length + ' Minor Gaps)';
            scoreBadge.className = 'mt-3 inline-block rounded-full bg-emerald-500/15 px-3 py-1 font-mono text-xs uppercase text-emerald-400';
          }
          if (scoreDesc) {
            scoreDesc.textContent = 'Your core intake is strong. Our forensic video audit will focus on advanced Core Web Vitals speed tuning, GEO/AEO visibility, and conversion lift.';
          }
        } else if (score >= 50) {
          scoreVal.className = 'mt-4 font-display text-6xl font-extrabold text-amber-400';
          if (scoreBadge) {
            scoreBadge.textContent = 'Moderate Leak Risk (' + missing.length + ' Gaps Found)';
            scoreBadge.className = 'mt-3 inline-block rounded-full bg-amber-500/15 px-3 py-1 font-mono text-xs uppercase text-amber-400';
          }
          if (scoreDesc) {
            scoreDesc.textContent = 'You have basic capture in place, but slow follow-up or missing database receipts can still drop high-intent inquiries during busy hours.';
          }
        } else {
          scoreVal.className = 'mt-4 font-display text-6xl font-extrabold text-signal';
          if (scoreBadge) {
            scoreBadge.textContent = 'High Lead-Leak Risk (' + missing.length + ' Gaps Found)';
            scoreBadge.className = 'mt-3 inline-block rounded-full bg-signal/15 px-3 py-1 font-mono text-xs uppercase text-signal';
          }
          if (scoreDesc) {
            scoreDesc.textContent = 'Critical capture and follow-up gaps detected. You are likely losing high-ticket inquiries between click and first callback.';
          }
        }

        const msgField = document.getElementById('message');
        if (msgField && (!msgField.value || msgField.value.startsWith('Readiness Score:'))) {
          msgField.value = `Readiness Score: ${score}/100. Missing: ${missing.slice(0, 4).join('; ')}`;
        }
      }

      checks.forEach((c) => c.addEventListener('change', recalc));
      recalc();
    }

    initChecklist();
    document.addEventListener('astro:page-load', initChecklist);
  })();
</script>
