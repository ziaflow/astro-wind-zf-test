---
import Layout from '~/layouts/PageLayout.astro';
import AuditBookingForm from '~/components/widgets/AuditBookingForm.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Free Website & Conversion Growth Audit | ZiaFlow',
  description:
    'Claim your free forensic video audit. Our Phoenix technical team analyzes your website speed, search visibility, and conversion leaks within 48 hours.',
};
---

<Layout metadata={metadata}>
  <section class="py-12 md:py-20 bg-gradient-to-b from-slate-50 to-white dark:from-slate-900 dark:to-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-block py-1 px-3 mb-4 text-xs font-semibold tracking-wider uppercase text-blue-600 bg-blue-100 dark:bg-blue-900/50 dark:text-blue-300 rounded-full">
          Complimentary Growth Analysis
        </span>
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-6">
          Find Exactly Where Your Website Is Losing Leads
        </h1>
        <p class="text-lg md:text-xl text-slate-600 dark:text-slate-300">
          No high-pressure sales calls. We record a custom 10-minute video breaking down your site speed, mobile user experience, and conversion bottlenecks.
        </p>
      </div>

      <div class="grid md:grid-cols-12 gap-12 items-start">
        <div class="md:col-span-5 space-y-8">
          <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
            <h3 class="text-lg font-bold mb-4 text-slate-900 dark:text-white flex items-center">
              <span class="text-emerald-500 mr-2 font-black">✓</span> What Your Audit Covers
            </h3>
            <ul class="space-y-4 text-sm text-slate-600 dark:text-slate-300">
              <li class="flex items-start">
                <span class="font-bold text-slate-900 dark:text-white mr-2">1. Core Web Vitals:</span>
                Real-world mobile loading speed, responsiveness, and performance score analysis.
              </li>
              <li class="flex items-start">
                <span class="font-bold text-slate-900 dark:text-white mr-2">2. Conversion Leaks:</span>
                Forensic UX review of forms, CTAs, and mobile booking friction points.
              </li>
              <li class="flex items-start">
                <span class="font-bold text-slate-900 dark:text-white mr-2">3. Local & Organic SEO:</span>
                Review of keyword positions, meta tags, and local search visibility.
              </li>
              <li class="flex items-start">
                <span class="font-bold text-slate-900 dark:text-white mr-2">4. Actionable Roadmap:</span>
                Prioritized recommendations ranked by revenue impact and ease of implementation.
              </li>
            </ul>
          </div>

          <div class="p-6 bg-blue-50 dark:bg-slate-800/60 rounded-xl border border-blue-100 dark:border-slate-700">
            <h4 class="font-semibold text-slate-900 dark:text-white mb-2">Prefer to speak directly?</h4>
            <p class="text-sm text-slate-600 dark:text-slate-300 mb-4">
              You can also schedule an instant live strategy session or call our Phoenix office.
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href="/booking"
                class="inline-flex justify-center items-center px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-md transition"
              >
                Calendar Booking
              </a>
              <a
                href="tel:+16028344239"
                class="inline-flex justify-center items-center px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-700 border border-slate-300 dark:border-slate-600 rounded-md hover:bg-slate-50 dark:hover:bg-slate-600 transition"
              >
                📞 (602) 834-4239
              </a>
            </div>
          </div>
        </div>

        <div class="md:col-span-7">
          <AuditBookingForm />
        </div>
      </div>
    </div>
  </section>
</Layout>
