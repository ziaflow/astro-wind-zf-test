---
import Layout from '@/layouts/layout.astro';
import Icon from '@/components/shared/icons/icon.astro';

export const prerender = true;
---

<Layout
  title="Request Received | ZiaFlow"
  description="Thank you for requesting a lead-flow review from ZiaFlow. Our Phoenix engineering team will follow up shortly."
  metadata={{ robots: { index: false, follow: false } }}
>
  <section class="relative isolate overflow-hidden border-b border-line pt-28 pb-20 md:pt-36 md:pb-28">
    <div
      class="pointer-events-none absolute -top-40 right-[-8rem] -z-10 size-[34rem] rounded-full bg-signal/15 blur-[120px]"
      aria-hidden="true"
    ></div>

    <div class="shell max-w-4xl">
      <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-line-strong bg-ink-2 px-3.5 py-1.5 font-mono text-xs uppercase tracking-[0.16em] text-emerald-400">
        <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Lead-Flow Review Recorded
      </p>

      <h1 class="font-display text-hero font-extrabold leading-[0.98] tracking-[-0.04em] text-bone">
        We have your <span class="text-signal">details.</span>
      </h1>

      <p class="mt-6 max-w-[58ch] text-lead leading-relaxed text-mute">
        Our Phoenix engineering team is reviewing your inquiry<span data-thank-you-service></span> and will follow up
        with practical next steps.
      </p>

      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        <article class="rounded-2xl border border-line bg-ink-2/70 p-6">
          <p class="font-mono text-xs text-signal">01 / INTAKE CHECK</p>
          <h2 class="mt-3 font-display text-lg font-semibold text-bone">We review your current flow</h2>
          <p class="mt-2 text-sm text-mute leading-relaxed">
            We look at how inquiries enter your business and where handoffs or follow-up stall.
          </p>
        </article>
        <article class="rounded-2xl border border-line bg-ink-2/70 p-6">
          <p class="font-mono text-xs text-signal">02 / DIRECT FOLLOW-UP</p>
          <h2 class="mt-3 font-display text-lg font-semibold text-bone">Same-day outreach</h2>
          <p class="mt-2 text-sm text-mute leading-relaxed">
            Expect a direct email or call from Jeremy to confirm your goals and schedule.
          </p>
        </article>
        <article class="rounded-2xl border border-line bg-ink-2/70 p-6">
          <p class="font-mono text-xs text-signal">03 / FASTEST PATH</p>
          <h2 class="mt-3 font-display text-lg font-semibold text-bone">Pick a time right now</h2>
          <p class="mt-2 text-sm text-mute leading-relaxed">
            Skip the email tag by locking in a 30-minute scoping call on our live calendar.
          </p>
        </article>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href="/booking"
          data-cta="book-scoping-call"
          class="btn h-13 rounded-full bg-signal px-7 font-semibold text-bone hover:bg-signal-dark"
          data-btn
        >
          <span class="btn-fill bg-bone text-ink" aria-hidden="true"></span>
          <span>Book a scoping call now</span>
          <Icon name="arrow-right" class="size-4" />
        </a>
        <a
          href="tel:+16028344239"
          class="inline-flex h-13 items-center gap-2 rounded-full border border-line-strong bg-ink-2 px-6 text-sm font-mono font-bold text-bone transition hover:border-signal hover:text-signal"
        >
          <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Call (602) 834-4239</span>
        </a>
        <a
          href="/"
          class="inline-flex h-13 items-center rounded-full border border-line px-6 text-sm font-medium text-mute transition hover:border-bone hover:text-bone"
        >
          Back to homepage
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const service = params.get('service');
  const serviceEl = document.querySelector('[data-thank-you-service]');
  if (service && serviceEl) {
    serviceEl.textContent = ` for ${service}`;
  }

  try {
    if (!sessionStorage.getItem('ziaflow:thank_you_tracked')) {
      sessionStorage.setItem('ziaflow:thank_you_tracked', '1');
      const w = window as unknown as {
        dataLayer?: Record<string, unknown>[];
        gtag?: (...args: unknown[]) => void;
      };
      if (w.dataLayer) {
        w.dataLayer.push({
          event: 'thank_you_view',
          service_interest: service || '',
          page_path: window.location.pathname,
        });
      }
      if (typeof w.gtag === 'function') {
        w.gtag('event', 'conversion_thank_you_view', {
          event_category: 'conversion',
          event_label: service || 'lead_flow_review',
        });
      }
    }
  } catch {
    /* ignore storage errors */
  }
</script>
