---
import Layout from '@/layouts/layout.astro';
import PageHero from '@/components/shared/page-hero.astro';
import BookingFrame from '~/components/common/BookingFrame.astro';
import AuditSection from '@/components/home/audit-section.astro';
import SalesForm from '@/components/pricing/sales-form.astro';

export const prerender = true;
---

<Layout
  title="Book a Strategy Session | Phoenix Web & Automation Engineering | ZiaFlow"
  description="Schedule a live 30-minute strategy session with ZiaFlow in Phoenix, AZ, or request a complimentary 48-hour forensic video audit."
>
  <PageHero
    lines={['Book your strategy', 'session live.']}
    accent={1}
    intro="Pick a time on our Phoenix engineering calendar below to review your website, lead capture pipeline, and automation scope—or request an asynchronous 10-minute forensic video audit."
  />

  <section class="shell pb-24 md:pb-32" aria-label="Calendar booking">
    <div class="rounded-2xl border border-line bg-ink-2/80 p-4 sm:p-8">
      <BookingFrame />
    </div>
  </section>

  <AuditSection />
  <SalesForm />
</Layout>
