---
import Layout from '~/layouts/PageLayout.astro';
import { sanityClient } from 'sanity:client';
import type { SanityDocument } from '@sanity/client';

const POSTS_QUERY = `*[
  _type == "post"
  && defined(slug.current)
  && publishedAt <= now()
]|order(publishedAt desc){_id, title, slug, publishedAt, mainImage}`;

let posts: SanityDocument[] = [];
try {
  posts = await sanityClient.fetch<SanityDocument[]>(POSTS_QUERY);
} catch (err) {
  console.warn('[posts] Sanity fetch skipped during build:', err instanceof Error ? err.message : err);
}

const metadata = {
  title: 'Blog Posts Archive | ZiaFlow',
  description: 'Archive of recent articles, updates, and digital marketing insights from ZiaFlow.',
  robots: {
    index: false,
    follow: true,
  },
};
---

<Layout metadata={metadata}>
  <section class="shell py-20 max-w-5xl mx-auto">
    <h1 class="font-display text-title font-bold text-bone mb-4">Latest Posts</h1>
    <p class="text-mute mb-12">Stay updated with our latest engineering insights and playbooks.</p>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <a href={`/posts/${post.slug.current}`} class="block group">
            <article class="rounded-2xl border border-line bg-ink-2 p-6 transition hover:border-signal">
              <h2 class="font-display text-xl font-bold text-bone mb-2 group-hover:text-signal transition-colors">
                {post.title}
              </h2>
              <p class="text-dim text-sm font-mono">
                <time datetime={new Date(post.publishedAt).toISOString()}>
                  {new Date(post.publishedAt).toLocaleDateString()}
                </time>
              </p>
            </article>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
