---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import KairoLayout from '@/layouts/layout.astro';
import PageHero from '@/components/shared/page-hero.astro';
import BlogList from '~/components/blog/List.astro';
import Pagination from '~/components/blog/Pagination.astro';
import AuditSection from '@/components/home/audit-section.astro';
import SalesForm from '@/components/pricing/sales-form.astro';
import Cta from '@/components/shared/cta.astro';
import { getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const title = `Phoenix Web Engineering, SEO & Lead Automation Blog${currentPage > 1 ? ` — Page ${currentPage}` : ''} | ZiaFlow`;
const description =
  'Actionable engineering guides, Phoenix conversion playbooks, Google Local Service Ads strategies, and marketing automation blueprints from the ZiaFlow team.';
---

<KairoLayout title={title} description={description}>
  <PageHero
    lines={['Playbooks on systems,', 'search & conversion.']}
    accent={1}
    intro="Practical engineering guides, Arizona case blueprints, and step-by-step checklists on lead capture automation, technical SEO, and high-converting web architecture."
  />

  <section class="shell pb-24 md:pb-32 border-t border-line pt-14">
    <div class="max-w-4xl mx-auto">
      <BlogList posts={page.data} />
      <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
    </div>
  </section>

  <AuditSection />
  <SalesForm />
  <Cta />
</KairoLayout>
