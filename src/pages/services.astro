---
import Layout from '@/layouts/layout.astro';
import PageHero from '@/components/shared/page-hero.astro';
import Icon from '@/components/shared/icons/icon.astro';
import HowItWorks from '@/components/home/how-it-works.astro';
import RoiCalculator from '@/components/home/roi-calculator.astro';
import Proof from '@/components/home/proof.astro';
import AuditSection from '@/components/home/audit-section.astro';
import SalesForm from '@/components/pricing/sales-form.astro';
import Cta from '@/components/shared/cta.astro';

export const prerender = true;

const serviceCatalog = [
  {
    category: 'Flagship Sprint',
    title: 'Lead Capture & Follow-Up',
    href: '/services/automation',
    summary: 'Map agreed inquiry sources, improve capture and routing, and give your team a clear process for follow-up.',
    highlights: ['Inquiry source review', 'Staff routing and ownership', 'Operator runbook'],
  },
  {
    category: 'Search',
    title: 'SEO & Local Search',
    href: '/services/seo',
    summary: 'Improve technical foundations and service pages around your customers, service areas, and available search data.',
    highlights: ['Technical SEO review', 'Service page improvements', 'Search measurement plan'],
  },
  {
    category: 'Web Development',
    title: 'Website Design & Development',
    href: '/services/web-development',
    summary: 'Build or improve a business website with clear pages, useful integrations, and straightforward contact paths.',
    highlights: ['Page and content planning', 'Responsive website build', 'URL and redirect review'],
  },
  {
    category: 'Paid Lead Generation',
    title: 'Google Local Services Ads',
    href: '/services/local-service-ads',
    summary: 'Review eligibility, profile information, inquiry handling, and reporting for Local Services Ads.',
    highlights: ['Account and profile review', 'Inquiry routing considerations', 'Campaign reporting'],
  },
  {
    category: 'Local Presence',
    title: 'Google Business Profile',
    href: '/services/gmb-optimization',
    summary: 'Review business details, service categories, service areas, and customer-facing profile information.',
    highlights: ['Profile accuracy review', 'Service area and category checks', 'Update recommendations'],
  },
  {
    category: 'Conversion',
    title: 'Conversion Rate Optimization',
    href: '/services/cro',
    summary: 'Find friction in key pages and contact paths, then prioritize practical improvements and measurement.',
    highlights: ['Contact path review', 'Form usability checks', 'Measurement recommendations'],
  },
  {
    category: 'Paid Search',
    title: 'PPC & Search Campaigns',
    href: '/services/ppc',
    summary: 'Plan and manage paid search with agreed targeting, budgets, landing pages, and inquiry tracking.',
    highlights: ['Keyword and location planning', 'Ad and page alignment', 'Conversion tracking review'],
  },
  {
    category: 'Reputation',
    title: 'Review & Reputation Management',
    href: '/services/review-management',
    summary: 'Plan a clear process for requesting customer feedback and responding to reviews across agreed platforms.',
    highlights: ['Review request workflow', 'Response guidance', 'Platform and access review'],
  },
  {
    category: 'Measurement',
    title: 'Performance Tracking & Attribution',
    href: '/services/performance-tracking',
    summary: 'Review available analytics and inquiry records to clarify what is tracked and where gaps remain.',
    highlights: ['Event and source review', 'Inquiry tracking plan', 'Reporting notes'],
  },
  {
    category: 'Custom Software',
    title: 'Custom Software & Internal Tools',
    href: '/services/software',
    summary: 'Scope internal tools, applications, and integrations around a defined business workflow.',
    highlights: ['Requirements and user roles', 'Application and data planning', 'Integration scope'],
  },
  {
    category: 'Commerce',
    title: 'E-Commerce Platforms',
    href: '/services/ecommerce',
    summary: 'Improve an online store’s structure, customer experience, and connections to business systems.',
    highlights: ['Storefront review', 'Checkout path review', 'Platform integration planning'],
  },
  {
    category: 'Infrastructure',
    title: 'Cloud Systems & Integrations',
    href: '/services/cloud',
    summary: 'Assess the tools and data involved in a workflow, then plan a supportable cloud integration.',
    highlights: ['Current system review', 'Data flow planning', 'Access and handover notes'],
  },
];
---

<Layout
  title="Web Development, SEO & Automation Services | ZiaFlow"
  description="Explore ZiaFlow services for Arizona businesses: website development, lead capture and follow-up, SEO, paid search, conversion optimization, and integrations."
>
  <PageHero
    lines={['Build a clearer path', 'from search to follow-up.']}
    accent={1}
    intro="ZiaFlow works with Arizona service businesses to improve websites, capture inquiries, and connect follow-up to the tools their teams use. Choose a defined project based on the problem you need to solve."
  />

  <section class="shell pb-20 md:pb-28" aria-labelledby="services-matrix-title">
    <div class="mb-10 flex flex-col justify-between gap-5 border-t border-line pt-8 md:mb-12 md:flex-row md:items-end">
      <div>
        <p class="font-mono text-label uppercase text-signal">Services</p>
        <h2 id="services-matrix-title" class="mt-3 font-display text-title font-bold text-bone">
          Practical help for websites and workflows.
        </h2>
      </div>
      <a
        href="/pricing"
        class="inline-flex items-center gap-2 font-mono text-xs uppercase text-signal transition-colors hover:text-bone"
      >
        Compare project scopes <Icon name="arrow-up-right" class="size-4" />
      </a>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        serviceCatalog.map((srv) => (
          <a
            href={srv.href}
            class="group flex h-full flex-col justify-between rounded-2xl border border-line bg-ink-2/60 p-6 transition-all duration-300 hover:border-signal hover:bg-ink-2 sm:p-7"
          >
            <div>
              <div class="flex items-center justify-between gap-3">
                <span class="rounded-full border border-line bg-ink px-3 py-1 font-mono text-[11px] uppercase text-signal">
                  {srv.category}
                </span>
                <span class="grid size-9 place-items-center rounded-full border border-line text-mute transition-all group-hover:rotate-45 group-hover:border-signal group-hover:bg-signal group-hover:text-bone">
                  <Icon name="arrow-up-right" class="size-4" />
                </span>
              </div>
              <h3 class="mt-5 font-display text-xl font-bold text-bone transition-colors group-hover:text-signal sm:text-2xl">
                {srv.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-mute">{srv.summary}</p>
              <ul class="mt-5 space-y-2 border-t border-line pt-4">
                {srv.highlights.map((h) => (
                  <li class="flex items-start gap-2.5 text-xs leading-relaxed text-bone">
                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-signal" />
                    {h}
                  </li>
                ))}
              </ul>
            </div>
            <span class="mt-6 inline-flex items-center gap-2 font-mono text-xs uppercase text-mute group-hover:text-bone">
              View service scope <Icon name="arrow-up-right" class="size-3.5" />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <HowItWorks />
  <RoiCalculator />
  <Proof />
  <AuditSection />
  <SalesForm />
  <Cta />
</Layout>
