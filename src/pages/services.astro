---
import Layout from '@/layouts/layout.astro';
import PageHero from '@/components/shared/page-hero.astro';
import Icon from '@/components/shared/icons/icon.astro';
import HowItWorks from '@/components/home/how-it-works.astro';
import RoiCalculator from '@/components/home/roi-calculator.astro';
import Proof from '@/components/home/proof.astro';
import AuditSection from '@/components/home/audit-section.astro';
import SalesForm from '@/components/pricing/sales-form.astro';
import Cta from '@/components/shared/cta.astro';

export const prerender = true;

const serviceCatalog = [
  {
    category: 'Flagship Sprint',
    title: 'Lead Capture & Marketing Automation',
    href: '/services/automation',
    summary:
      'Audit every inquiry source, repair silent form drops, automate <60s SMS/email confirmation, and sync directly with your CRM and dispatch team.',
    highlights: [
      'Lead-Path Audit & Database Receipts',
      'Instant SMS & Email Dispatch',
      'Superhuman & Customer.io Workflows',
    ],
  },
  {
    category: 'Search & GEO',
    title: 'Phoenix Technical SEO & AI Visibility',
    href: '/services/seo',
    summary:
      'Capture high-intent Arizona buyers across Google Search, Map Packs, ChatGPT, and Perplexity with structured schema and striking-distance content.',
    highlights: [
      'LocalBusiness & Service JSON-LD',
      'GEO / Answer Engine Optimization',
      'Core Web Vitals & Crawl Repair',
    ],
  },
  {
    category: 'Web Engineering',
    title: 'High-Speed Web Development (Astro)',
    href: '/services/web-development',
    summary:
      'Sub-second websites engineered on Astro, Tailwind CSS, and Supabase—designed specifically to convert mobile service traffic into booked calls.',
    highlights: ['99+ PageSpeed Performance', 'Mobile-First Conversion Flows', 'Zero Bloated Plugin Lock-In'],
  },
  {
    category: 'Paid Lead Gen',
    title: 'Google Local Service Ads (LSA)',
    href: '/services/local-service-ads',
    summary:
      'Pay-per-lead Google Guaranteed campaign management, dispute protection, and instant lead triage for Phoenix home and commercial contractors.',
    highlights: ['Google Guaranteed Verification', 'Invalid Lead Dispute Management', 'Direct Call & Message Routing'],
  },
  {
    category: 'Local Authority',
    title: 'Google Business Profile (GBP) Optimization',
    href: '/services/gmb-optimization',
    summary:
      'Turn local map views into direct calls with category tuning, geo-grid tracking, Q&A seeding, and automated post-service review velocity.',
    highlights: ['Map Pack Ranking Architecture', 'Service Area & Category Tuning', 'Automated Review Integration'],
  },
  {
    category: 'Conversion Architecture',
    title: 'Conversion Rate Optimization (CRO)',
    href: '/services/cro',
    summary:
      'Eliminate form friction, broken mobile CTAs, and high bounce rates using Microsoft Clarity heatmaps and server-verified intake testing.',
    highlights: [
      'Clarity Behavior & Scroll Analysis',
      'Frictionless Multi-Step Intake',
      'Mobile Call & Booking Path Repair',
    ],
  },
  {
    category: 'Paid Search',
    title: 'High-Intent PPC & Search Campaigns',
    href: '/services/ppc',
    summary:
      'Precision Google and Microsoft Search campaigns paired with dedicated high-converting landing pages and full-funnel lead attribution.',
    highlights: [
      'Exact-Intent Keyword Targeting',
      'Dedicated Conversion Landing Pages',
      'Database-Backed ROAS Tracking',
    ],
  },
  {
    category: 'Reputation Engine',
    title: 'Review & Reputation Management',
    href: '/services/review-management',
    summary:
      'Automated SMS and email review requests triggered immediately after job completion to build 5-star social proof across Google and Yelp.',
    highlights: ['Automated Post-Job SMS Requests', 'Negative Feedback Triage Flow', 'Review Response Playbooks'],
  },
  {
    category: 'Telemetry & BI',
    title: 'Performance Tracking & Attribution',
    href: '/services/performance-tracking',
    summary:
      'Unified Supabase telemetry combining Google Search Console, Microsoft Clarity, CallRail, and verified form receipts without vanity metrics.',
    highlights: ['Atomic Lead & Receipt Logging', 'Source-Page Attribution', 'Executive Weekly Briefs'],
  },
  {
    category: 'Custom Software',
    title: 'Bespoke Software & AI Agent Systems',
    href: '/services/software',
    summary:
      'Custom internal portals, customer dashboards, Supabase backends, and multi-agent AI workflows built for operational scale.',
    highlights: [
      'Full-Stack Astro / Next.js / Supabase',
      'Custom Webhook & API Pipelines',
      '100% Client-Owned Codebase',
    ],
  },
  {
    category: 'Commerce',
    title: 'High-Converting E-Commerce Platforms',
    href: '/services/ecommerce',
    summary:
      'Headless commerce, Shopify speed optimization, and automated abandoned-checkout recovery engineered for measurable revenue lift.',
    highlights: ['Sub-Second Product Pages', 'Checkout Friction Removal', 'Customer.io Retention Flows'],
  },
  {
    category: 'Infrastructure',
    title: 'Cloud Architecture & Edge Security',
    href: '/services/cloud',
    summary:
      'Resilient deployments on Vercel, AWS, and Supabase with row-level security, cryptographic webhook verification, and edge rate limiting.',
    highlights: ['Row-Level Security (RLS) Audits', 'HMAC Webhook Verification', 'Zero-Downtime CI/CD Previews'],
  },
];
---

<Layout
  title="Web Design, SEO & Lead Automation Services | ZiaFlow"
  description="Explore ZiaFlow's digital services in Phoenix, AZ: Lead Capture & Follow-Up Sprints, fast Astro web design, local SEO, Google LSAs, and custom software."
>
  <PageHero
    lines={['Systems engineered', 'for booked revenue.']}
    accent={1}
    intro="We don't sell disconnected marketing retainers. ZiaFlow engineers high-speed websites, automated lead capture & follow-up pipelines, and local search dominance for Arizona businesses."
  />

  <!-- Services Matrix -->
  <section class="shell pb-24 md:pb-32" aria-labelledby="services-matrix-title">
    <div class="flex flex-col justify-between gap-6 border-t border-line pt-10 md:flex-row md:items-end mb-14">
      <div>
        <p class="font-mono text-label text-signal uppercase">Capabilities Catalog</p>
        <h2 id="services-matrix-title" class="mt-3 font-display text-title font-bold text-bone">
          12 specialized engineering & growth disciplines.
        </h2>
      </div>
      <a
        href="/pricing"
        class="inline-flex items-center gap-2 font-mono text-xs uppercase text-signal hover:text-bone transition-colors"
      >
        Compare Sprint & Retainer Pricing <Icon name="arrow-up-right" class="size-4" />
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        serviceCatalog.map((srv) => (
          <a
            href={srv.href}
            class="group flex flex-col justify-between rounded-2xl border border-line bg-ink-2/60 p-7 transition-all duration-300 hover:border-signal hover:bg-ink-2"
          >
            <div>
              <div class="flex items-center justify-between gap-3">
                <span class="rounded-full border border-line bg-ink px-3 py-1 font-mono text-[11px] uppercase text-signal">
                  {srv.category}
                </span>
                <span class="grid size-9 place-items-center rounded-full border border-line text-mute transition-all group-hover:rotate-45 group-hover:border-signal group-hover:bg-signal group-hover:text-bone">
                  <Icon name="arrow-up-right" class="size-4" />
                </span>
              </div>
              <h3 class="mt-6 font-display text-2xl font-bold text-bone group-hover:text-signal transition-colors">
                {srv.title}
              </h3>
              <p class="mt-3 text-sm text-mute leading-relaxed">{srv.summary}</p>
              <ul class="mt-6 space-y-2 border-t border-line pt-5">
                {srv.highlights.map((h) => (
                  <li class="flex items-center gap-2.5 text-xs text-bone">
                    <span class="size-1.5 rounded-full bg-signal" />
                    {h}
                  </li>
                ))}
              </ul>
            </div>
            <span class="mt-8 inline-flex items-center gap-2 font-mono text-xs uppercase text-mute group-hover:text-bone">
              View Service Scope & Deliverables →
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <HowItWorks />
  <RoiCalculator />
  <Proof />
  <AuditSection />
  <SalesForm />
  <Cta />
</Layout>
