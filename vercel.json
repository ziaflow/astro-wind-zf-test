{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/sync-google-metrics",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/sync-customerio",
      "schedule": "0 4 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://ziaflow.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ziaflow.com"
        }
      ],
      "destination": "https://ziaflow.com/:path*",
      "permanent": true
    },
    {
      "source": "/web-development-in-2026-a-practical-guide-to-building-fast-secure-highconverting-websites",
      "destination": "/web-development-in-2026-a-practical-guide-to-building-fast-secure-conversion-ready-websites",
      "permanent": true
    },
    {
      "source": "/web-development-in-2026-a-practical-guide-to-building-fast-secure-high-converting-websites",
      "destination": "/web-development-in-2026-a-practical-guide-to-building-fast-secure-conversion-ready-websites",
      "permanent": true
    },
    {
      "source": "/web-development-in-2026-a-practical-guide-to-building-faster-safer-conversion-ready-websites",
      "destination": "/web-development-in-2026-a-practical-guide-to-building-fast-secure-conversion-ready-websites",
      "permanent": true
    },
    {
      "source": "/blog/web-development-in-2026-a-practical-guide-to-building-fast-secure-highconverting-websites",
      "destination": "/web-development-in-2026-a-practical-guide-to-building-fast-secure-conversion-ready-websites",
      "permanent": true
    },
    {
      "source": "/blog/web-development-in-2026-a-practical-guide-to-building-fast-secure-high-converting-websites",
      "destination": "/web-development-in-2026-a-practical-guide-to-building-fast-secure-conversion-ready-websites",
      "permanent": true
    },
    {
      "source": "/blog/web-development-in-2026-a-practical-guide-to-building-fast-secure-conversion-ready-websites",
      "destination": "/web-development-in-2026-a-practical-guide-to-building-fast-secure-conversion-ready-websites",
      "permanent": true
    },
    {
      "source": "/guide-to-web-development-2026",
      "destination": "/web-development-in-2026-a-practical-guide-to-building-fast-secure-conversion-ready-websites",
      "permanent": true
    },
    {
      "source": "/2026-web-development-guide",
      "destination": "/web-development-in-2026-a-practical-guide-to-building-fast-secure-conversion-ready-websites",
      "permanent": true
    },
    {
      "source": "/phoenix-commercial-hvac-lead-intake",
      "destination": "/case-studies/phoenix-commercial-hvac-lead-intake",
      "permanent": true
    },
    {
      "source": "/case-studies/phoenix-commercial-hvac",
      "destination": "/case-studies/phoenix-commercial-hvac-lead-intake",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Document-Policy",
          "value": "js-profiling"
        }
      ]
    },
    {
      "source": "/customers/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/customers",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/form-test",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
